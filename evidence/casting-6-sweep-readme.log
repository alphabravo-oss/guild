# evidence-cmd: sh -c 'set -e; root="$(git rev-parse --show-toplevel)"; cd "$root/plugins/webster"; echo "--- the Python floor the README states: which scripts import tomllib, and with what fallback ---"; grep -n "^import tomllib\|^ *import tomllib\|except ImportError" scripts/*.py | sed "s/^/    /"; grep -c "Python 3.11" README.md | sed "s/^/    mentions of Python 3.11 in README.md: /"; echo; echo "--- the seven gates: rows in the gate table, and the heading over it ---"; grep -n "^## The seven gates" README.md | sed "s/^/    /"; awk "/^\| Gate \| Passes when \|/,/^$/" README.md | grep -c "^| " | sed "s/^/    lines in the table, header and rule included: /"; echo; echo "--- the five agents the merge table claims were taken whole ---"; ls agents/*.md | wc -l | sed "s/^/    agent files: /"; ls agents/*.md | sed "s/^/      /"; echo; echo "--- the nine-criterion README rubric ---"; grep -c "^### 2\.[0-9]" skills/readme-rubric/SKILL.md | sed "s/^/    criteria under Phase 2 (the rubric): /"; grep -o "^### 2\.[0-9] .*" skills/readme-rubric/SKILL.md | sed "s/^/      /"; echo; echo "--- the marketplace this plugin ships in, and the two install lines that named another ---"; python3 -c "import json; m = json.load(open(\"../../.claude-plugin/marketplace.json\")); print(\"    marketplace name:\", m[\"name\"]); print(\"    webster source:  \", [p[\"source\"] for p in m[\"plugins\"] if p[\"name\"] == \"webster\"][0])"; git show cfafe8e:plugins/webster/README.md | grep -n "plugin marketplace add\|plugin install" | sed "s/^/    was: /"; grep -n "plugin marketplace add\|plugin install" README.md | sed "s/^/    now: /"; test -e "$HOME/Projects/webster" && echo "    the path those lines named exists" || echo "    the path those lines named does not exist on this machine"; echo; echo "--- exercised: six of the seven scripts, one test module each ---"; for s in $(ls scripts/*.py | xargs -n1 basename | sed "s/\.py$//"); do if [ -f "tests/test_$s.py" ]; then echo "    $s.py  -> tests/test_$s.py"; else echo "    $s.py  -> no test module"; fi; done'
