()" "leaky = load([('_BASE_ENV_KEYS = (\"PATH\", \"HOME\")', '_BASE_ENV_KEYS = tuple(os.environ)')])" "empty = tempfile.mkdtemp()" "a = json.loads(guarded.run_script('drift.py', 'check', cwd=empty).stdout)['docs_dir']" "b = json.loads(leaky.run_script('drift.py', 'check', cwd=empty).stdout)['docs_dir']" "print('    base_env() keys:              %r' % sorted(guarded.base_env()))" "print('    guard in place, drift.py saw: %r' % os.path.basename(a))" "print('    guard removed, drift.py saw:  %r' % os.path.basename(b))" "del os.environ['WEBSTER_DOCS']" "" "print()" "print('[6] conftest: a shared fixture copy would make one test mutation another test premise')" "shared = load().build_fixture_repo(os.path.join(tempfile.mkdtemp(), 'shared'))" "mp = os.path.join(shared, 'src', 'app', 'main.py')" "open(mp, 'a').write('\\n# edited by the first consumer\\n')" "print('    a second reader of the same path sees the edit: %s' % ('edited by the first consumer' in open(mp).read()))" "print('    and git reports the shared tree dirty:          %s' % bool(subprocess.run(['git', 'status', '--porcelain'], cwd=shared, capture_output=True, text=True, env=GE).stdout.strip()))" > "$T/s.py"; python3 "$T/s.py"; rm -rf "$T"; echo; echo "[7] test_harness: what a global git config does to the three queries this module runs"; G=$(mktemp -d); printf "[status]\n\trelativePaths = true\n" > "$G/rel"; printf "[alias]\n\tls-files = !echo HIJACKED\n" > "$G/alias"; for c in /dev/null "$G/rel" "$G/alias"; do printf "    %-10s " "$(basename $c)"; for q in "ls-files -z -- plugins/webster/tests/conftest.py plugins/webster/tests/test_harness.py" "ls-tree -r -z --name-only cfafe8e" "diff --name-only -z 2248efc..cfafe8e"; do printf "%s " "$(GIT_CONFIG_GLOBAL=$c GIT_CONFIG_NOSYSTEM=1 git $q | shasum | cut -c1-10)"; done; echo; done; rm -rf "$G"; echo "    (columns: ls-files | ls-tree | diff --name-only; /dev/null is the guard as shipped)"; echo; echo "[8] conftest: every file:line citation left in the two files, 