# evidence-cmd: python3 -c 'import json,os,shutil,subprocess,tempfile; d=tempfile.mkdtemp(); os.makedirs(d+"/src"); open(d+"/pyproject.toml","w").write("[project]\nname = \"demo\"\n"); open(d+"/src/cli.js","w").write("program.option(\"--keep\", \"-x is the short form of --purge\");\nprogram.option(\"-o, --out <path>\", \"where to write\");\n"); r=subprocess.run(["python3","plugins/webster/scripts/survey.py",d],capture_output=True,text=True); n=[c["name"] for c in json.loads(r.stdout)["user_surface"]["commands"]]; print("survey.py exit:", r.returncode); print("user_surface.commands:", json.dumps(json.loads(r.stdout)["user_surface"]["commands"], indent=2)); print("--keep declared:", "--keep" in n); print("-x published:", "-x" in n); print("--purge published:", "--purge" in n); print("-o/--out kept from the commander spec:", "-o" in n and "--out" in n); shutil.rmtree(d)'
