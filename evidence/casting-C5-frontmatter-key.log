# evidence-cmd: for f in plugins/foundry/commands/setup.md plugins/foundry/commands/resume.md plugins/foundry/commands/stop.md; do grep -n "hide-from-slash-command-tool\|disable-model-invocation" "$f" | sed "s|^|$f:|"; done
# evidence-for: US-004, FR-014, AC-016
# evidence-timeout: 60
#
# NOTE: deliberately loops one file at a time instead of passing all three to a
# single grep. A multi-file grep returns its results in NONDETERMINISTIC order
# in this environment (grep is ripgrep-backed and traverses in parallel), which
# would fail byte-comparison on re-execution. Per-file invocation fixes order.

plugins/foundry/commands/setup.md:4:disable-model-invocation: "true"
plugins/foundry/commands/resume.md:4:disable-model-invocation: "true"
plugins/foundry/commands/stop.md:4:disable-model-invocation: "true"
