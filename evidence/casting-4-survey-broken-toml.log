# evidence-cmd: cd plugins/webster && rm -rf /tmp/webster-c4-badtoml && mkdir -p /tmp/webster-c4-badtoml/src && printf '%s\n' '[project' 'name = ' > /tmp/webster-c4-badtoml/pyproject.toml && printf '%s\n' 'import os' 'TOKEN = os.getenv("API_TOKEN")' > /tmp/webster-c4-badtoml/src/app.py; python3 scripts/survey.py /tmp/webster-c4-badtoml > /tmp/webster-c4-badtoml/out.json; echo "exit=$?"; python3 -c 'import json; d = json.load(open("/tmp/webster-c4-badtoml/out.json")); print("name:", d["name"]); print("description:", repr(d["description"])); print("stack:", d["stack"]); print("cli:", d["surface"]["cli"]); print("config:", [(c["name"], c.get("undeclared")) for c in d["surface"]["config"]])'
# evidence-for: US-006, AC-027, FR-020
#
# AC-027 / FR-020. A pyproject.toml that TOML cannot parse -- an unclosed table
# header and a key with no value -- is ignored rather than fatal. The survey
# runs to completion at exit 0, the name falls back to the directory name, and
# the rest of the surface is still reported: a pyproject.toml is a syntax error
# for as long as somebody is editing it, and a writer needs the surface anyway.
exit=0
