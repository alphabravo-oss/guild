# evidence-cmd: cd plugins/foundry/mcp-server && uv run --quiet python -c 'import json,pathlib,re; from foundry_mcp.tools.foundry import validate_defect_filing; from foundry_mcp.schemas import vocab; R=pathlib.Path.cwd().parents[2]; AG=R/"plugins/foundry/agents"; raw=lambda p:p.read_text(encoding="utf-8"); blocks=lambda p:re.findall(r"^```json\n(.*?)^```$", raw(p), re.S|re.M); CD=AG/"coverage-diff.md"; ents=[e for b in blocks(CD) for e in (json.loads(b).get("defects") or [])]; strip=lambda e:{k:v for k,v in e.items() if k not in ("tier","class","reproduction_attempted")}; verdict=lambda f:(lambda r:"ACCEPTED" if r is None else "REFUSED on %s: %s" % (r.get("field"), r["error"]))(validate_defect_filing(f)); print("== D-017 reproduction: the shape coverage-diff.md documents, driven through the filing door =="); print("   validate_defect_filing is the ONE gate both Foundry-Defect and Foundry-Sync call"); [print("   %-22s before this fix -> %s" % (e["type"], verdict(strip(e)))) for e in ents]; print(); print("== D-017 resolution: the same entries as the file documents them today =="); [print("   %-22s tier=%-7s class=%-49s -> %s" % (e["type"], e.get("tier"), e.get("class"), verdict(e))) for e in ents]; print(); print("== the batch door refuses the WHOLE batch on one bad finding =="); print("   findings that must pass for a coverage_diff sync to land:", len(ents)); print("   findings that passed before this fix:", sum(1 for e in ents if validate_defect_filing(strip(e)) is None)); print("   findings that pass now:", sum(1 for e in ents if validate_defect_filing(e) is None)); print(); print("== FR-004 / CT-001: the LATENT entry reproduction_attempted, driven through vocab =="); [print("   %s -> %s" % (e["type"], vocab.reproduction_attempted_problem(e.get("reproduction_attempted")) or "ACCEPTED")) for e in ents if e.get("tier")=="LATENT"]; print(); print("== the roster is DERIVED, so the next stream cannot be forgotten the way this one was =="); files=sorted(AG.glob("*.md")); sync=[p for p in files if "Foundry-Sync" in raw(p)]; docs=lambda p:any("defects" in json.loads(b) for b in blocks(p)); roster=[p for p in sync if docs(p)]; print("   agents/*.md naming Foundry-Sync AND documenting a defects array:"); [print("     -", p.name) for p in roster]; print("   naming Foundry-Sync but documenting no defects array (correctly excluded):"); [print("     -", p.name) for p in sync if not docs(p)]; print(); print("== GI-001 / FR-030: the shared rule is one string, not five paraphrases =="); O="- **No severity classification.** **No severity tiers.**"; C=chr(110)+"o \"I could not reproduce it, so it is probably fine.\""; span=lambda p:(lambda s:s[s.find(O):s.find(C,s.find(O))+len(C)])(" ".join(raw(p).split())); print("   distinct spellings across the derived roster:", len({span(p) for p in roster})); print("   abolished sense of the word tier still in coverage-diff.md:", [u for u in ("weaker tier","lesser tier","tier of it") if u in raw(CD)] or "none")'
