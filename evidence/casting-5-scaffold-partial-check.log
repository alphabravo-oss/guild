# evidence-cmd: cd plugins/webster && BASE=/tmp/webster-c5-partial; o=/tmp/webster-c5-out2; rm -rf "$BASE"; mkdir -p "$BASE"; n=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd; run() { python3 "$@" > "$o" 2>&1; c=$?; sed "s/d\{50,\}/<D-x200>/g" "$o"; echo "exit=$c"; }; git show 0ac652d:plugins/webster/scripts/scaffold.py > "$BASE/before.py"; python3 scripts/scaffold.py init --docs "$BASE/docs" > /dev/null; rm "$BASE/docs/index.md"; echo "--- readable: the check runs to completion and publishes what it found ---"; run scripts/scaffold.py check --docs "$BASE/docs"; ( cd "$BASE/docs/install" && for i in 1 2 3 4 5 6; do mkdir "$n" && cd "$n" || exit 1; done ) || echo BUILD-FAILED; echo "--- the same tree with one directory the walk cannot scan ---"; run scripts/scaffold.py check --docs "$BASE/docs"; echo "--- what --help said about that exit 2, before 0ac652d ---"; COLUMNS=80 python3 "$BASE/before.py" --help | sed -n "/^  check /,/^$/p"; echo "--- and after ---"; COLUMNS=80 python3 scripts/scaffold.py --help | sed -n "/^  check /,/^$/p"; rm -rf "$BASE" "$o"
# evidence-for: US-009, FR-028
#
# US-009 / FR-028 (CT-005). The same tree twice, once readable and once with one
# directory added that the walk cannot scan.
#
# The readable run finds a missing required root page and publishes it. The
# unreadable twin collects that same violation -- the root-page loop is the first
# thing do_check does, and the walk that raises is one of the last -- and prints
# a cannot_read envelope with no violations list at all. That is the boundary
# working as written: a findings list from a scan that stopped reads as the
# findings and is not them.
#
# What was wrong was the sentence over it. The module docstring is argparse's
# description, so it is scaffold.py --help, and it filed the whole of check's
# exit 2 under "when there was nothing to check". In this run there was plenty to
# check and some of it had been checked. The two --help blocks are the before and
# the after: the exit 2 is now a check that could not run to completion, and the
# text says what becomes of the violations collected before the refusal.
#
# "nothing to check" stays doctype.py's phrase, for a population that was
# genuinely empty.
--- readable: the check runs to completion and publishes what it found ---
{
  "status": "violations",
  "subjects": [],
  "sections": [
    "getting-started",
    "install",
    "advanced",
    "troubleshooting",
    "developer",
    "api"
  ],
  "violations": [
    {
      "where": "/tmp/webster-c5-partial/docs/index.md",
      "problem": "required root page is missing"
    }
  ]
}
exit=1
--- the same tree with one directory the walk cannot scan ---
{"status": "cannot_read", "path": "/tmp/webster-c5-partial/docs/install/<D-x200>/<D-x200>/<D-x200>/<D-x200>/<D-x200>", "error": "File name too long"}
exit=2
--- what --help said about that exit 2, before 0ac652d ---
  check  validate an existing tree against the layout. status violations at exit 1 on any
         violation, status ok at exit 0 when there are none, and exit 2 with a JSON status
         when there was nothing to check -- no_docs for no directory at --docs, cannot_read
         for anything under it the filesystem refused, a page that could not be opened or a
         directory at any depth that could not be listed.

--- and after ---
  check  validate an existing tree against the layout. status violations at exit 1 on any
         violation, status ok at exit 0 when there are none, and exit 2 with a JSON status
         when the check could not run to completion -- no_docs when nothing is at --docs or
         what is there is not a directory, cannot_read when the filesystem refused a read:
         --docs itself, a page that could not be opened, or a directory at any depth that
         could not be listed. cannot_read carries no violations list, and it can arrive with
         part of the tree already read; the violations collected before the refusal are
         dropped rather than reported, because a findings list from a scan that stopped
         reads as the findings and is not them.

