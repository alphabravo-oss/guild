   h, r = build('a ~/.gitconfig holding ' + label, cfg(n, body))" "    if h is not None:" "        print('  %-46s -> HEAD %s the shipped build' % ('', 'IDENTICAL to' if h == base else 'DIFFERENT from'))" "    if r is not None and 'templateDir' in label:" "        print('  %-46s -> the template file landed in .git: %s; in the work tree: %s' % ('', os.path.exists(os.path.join(r, '.git', 'planted.txt')), os.path.exists(os.path.join(r, 'planted.txt'))))" "crlf = [str(p) for p in pathlib.Path('plugins/webster/tests/fixtures/repo').rglob('*') if p.is_file() and b'\\r\\n' in p.read_bytes()]" "print()" "print('files in the committed fixture holding a CRLF for core.autocrlf to rewrite: %r' % crlf)" > "$T/g.py"; echo "--- what one setting in a developer ~/.gitconfig does to this fixture, reached through GIT_CONFIG_GLOBAL ---"; python3 "$T/g.py"; rm -rf "$T"; echo; echo "--- the guard the measurement is about, unchanged ---"; sed -n "/^_GIT_ENV = {$/,/^}$/p" plugins/webster/tests/conftest.py; echo; echo "--- GI-005 exclusions still hold on the fixture every build above copied ---"; find plugins/webster/tests/fixtures/repo \( -name .git -o -name website -o -name .webster.json \) -print | sort; echo "matches: $(find plugins/webster/tests/fixtures/repo \( -name .git -o -name website -o -name .webster.json \) -print | wc -l | sed 's/ //g')"
# evidence-for: US-010, FR-030, AC-040, FR-042, GI-005, FR-039
#
# GRIND cycle 15, D-156 (PROVE cycle 14 F-08). conftest.py's comment above _GIT_ENV named three
# git settings - commit.gpgsign, core.autocrlf and init.templateDir - and said of them "each one
# changes HEAD on that machine only". Measured through GIT_CONFIG_GLOBAL against the real
# build_fixture_repo, none of the three does:
#
#   core.autocrlf = true      HEAD byte-identical to the shipped build
#   core.autocrlf = input     HEAD byte-identical to the shipped build
#   init.templateDir          HEAD byte-identical to the shipped build
#   commit.gpgsign = true     the first commit fails and there is no HEAD at all
#
# The run also prints the mechanism for the two silent ones: a template's files are copied into
# .git and never enter the tree, and the committed fixture holds no CRLF for core.autocrlf to
# rewrite.
#
# A fifth configuration is measured because the corrected comment needs at least one example that
# is real: a core.excludesFile naming one fixture page drops it from the docs commit and does move
# HEAD. One hit in five, and not one of the three that were named, which is why the comment now
# argues from what the suite cannot enumerate rather than from a list of settings that bite.
#
# The guard itself does not move - the second block prints it unchanged. The third block is the
# GI-005 check on the fixture every build above copied, so a measurement made against a polluted
# tree would show here rather than be assumed away.

