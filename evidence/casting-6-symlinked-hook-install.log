out=$(bash "$FIX" --project "$W/b" 2>&1); report b; printf '  %-42s: %s\n' "report names the link it replaced" "$(printf '%s' "$out" | grep -qF -- '-> ../../scripts/my-hook.sh' && echo yes || echo no)"; printf '  %-42s: %s\n' "report resolves it to the real file" "$(printf '%s' "$out" | grep -qF -- 'resolving to:' && echo yes || echo no)"; printf '  %-42s: %s\n' "backup preserves the link, not its target" "$(bk=$(ls -d "$W/b/.git/hooks/"*.foundry-backup.* 2>/dev/null | head -1); [ -L "$bk" ] && printf 'yes -> %s' "$(readlink "$bk")" || echo no)"; printf '  %-42s: %s\n' "temp files left in the hooks directory" "$(ls -a "$W/b/.git/hooks" | grep -c foundry-install)"; echo; echo "adjacent symlink paths, FIXED installer:"; mk c ../../absent-hook.sh; out=$(bash "$FIX" --project "$W/c" 2>&1); printf '  %-42s: %s\n' "dangling link, reported as dangling" "$(printf '%s' "$out" | grep -qF 'dangling' && echo yes || echo no)"; printf '  %-42s: %s\n' "dangling link, target NOT created" "$([ -e "$W/c/absent-hook.sh" ] && echo 'NO - materialised' || echo yes)"; printf '  %-42s: %s\n' "dangling link, hook now the shipped guard" "$(cmp -s "$GUARD" "$W/c/.git/hooks/pre-commit" && echo yes || echo no)"; mk d; bash "$FIX" --project "$W/d" --no-clobber > "$W/nc.out" 2>&1; rc=$?; printf '  %-42s: %s\n' "--no-clobber over a symlink, exit code" "$rc"; printf '  %-42s: %s\n' "--no-clobber left the link intact" "$([ -L "$W/d/.git/hooks/pre-commit" ] && echo yes || echo no)"; printf '  %-42s: %s\n' "--no-clobber left the target unchanged" "$(cmp -s "$W/original-bytes" "$W/d/scripts/my-hook.sh" && echo yes || echo no)"; echo; echo "regression check: the plain-file paths TEMPER verified are unchanged"; mk e x 2>/dev/null; rm -f "$W/e/.git/hooks/pre-commit"; printf '#!/bin/sh\necho foreign\n' > "$W/e/.git/hooks/pre-commit"; chmod +x "$W/e/.git/hooks/pre-commit"; out=$(bash "$FIX" --project "$W/e" 2>&1); printf '  %-42s: %s\n' "foreign plain hook backed up and REPLACED" "$(printf '%s' "$out" | gre