# evidence-cmd: cd "$(git rev-parse --show-toplevel)"; T=$(mktemp -d); printf "%s\n" "import os, sys, tempfile, types" "st = types.ModuleType('pytest')" "st.fixture = lambda *a, **k: (a[0] if a and callable(a[0]) else (lambda f: f))" "sys.modules['pytest'] = st" "SRC = os.path.abspath('plugins/webster/tests/conftest.py')" "m = types.ModuleType('c'); m.__file__ = SRC" "exec(compile(open(SRC, encoding='utf-8').read(), SRC, 'exec'), m.__dict__)" "print('    basenames run_script resolves out of SCRIPTS_DIR:')" "for name in sorted(p.name for p in m.SCRIPTS_DIR.glob('*.py')):" "    print('      %s' % name)" "r = m.run_script('rendered.py', 'check', tempfile.mkdtemp())" "print('    the helper handed rendered.py and an empty build dir -> exit %s' % r.returncode)" "for line in r.stdout.splitlines():" "    print('      stdout: %s' % line)" "print('      stderr: %r' % r.stderr)" > "$T/s.py"; echo "[1] run_script takes a basename and can drive any of the seven, rendered.py included"; python3 "$T/s.py"; rm -rf "$T"; echo; echo "[2] which script each file under tests/ actually passes to run_script (one-line and wrapped call forms both counted)"; printf "    %-18s" "file"; for s in doctype drift llmstxt rendered scaffold slop survey; do printf "%-12s" "$s.py"; done; echo; for f in $(ls plugins/webster/tests/*.py | sort); do printf "    %-18s" "$(basename $f)"; for s in doctype drift llmstxt rendered scaffold slop survey; do printf "%-12s" "$(tr "\n" " " < "$f" | grep -o "run_script( *\"$s\.py\"" | wc -l | tr -d " ")"; done; echo; done; printf "    %-18s" "TOTAL"; for s in doctype drift llmstxt rendered scaffold slop survey; do printf "%-12s" "$(cat $(ls plugins/webster/tests/*.py | sort) | tr "\n" " " | grep -o "run_script( *\"$s\.py\"" | wc -l | tr -d " ")"; done; echo; echo; echo "[3] the census the defect names, restricted to .py so no stale __pycache__ blob joins in"; printf "    grep -rn --include=*.py \"run_script(\" plugins/webster/tests/ | wc -l  ->  %s\n" "$(grep -rn --include=*.py "run_script(" plugins/webster/tests/ | wc -l | tr -d " ")"; printf "    of those, the lines that name rendered.py                        ->  %s\n" "$(grep -rn --include=*.py "run_script(" plugins/webster/tests/ | grep -c "rendered" | tr -d " ")"; echo; echo "[4] the .py files beside conftest.py, and whether test_rendered.py is one of them"; ls plugins/webster/tests/*.py | sort | sed "s|.*/|    |"; test -e plugins/webster/tests/test_rendered.py && echo "    test_rendered.py EXISTS" || echo "    test_rendered.py does not exist"; echo; echo "[5] what README.md already records about rendered.py"; grep -n "Not yet exercised" plugins/webster/README.md | sed "s/^/    /"
# evidence-for: CT-007, FR-029, GI-004, FR-039
#
# GRIND cycle 15, lead item L-15-1. conftest.py's docstring said of scaffold.py and
# rendered.py that "``run_script`` drives those two the same way anyway". Block [2]
# measures it: of those two the suite passes only scaffold.py to run_script, 27 times
# and all of them from test_scaffold.py, and rendered.py nought times from anywhere.
# The clause was true of one of the two scripts it covered.
#
# What replaces it is split into the three things that are separately true, each with a
# block behind it. run_script takes a basename, so nothing in the helper excludes any
# script: block [1] lists the seven it resolves out of SCRIPTS_DIR and then hands it
# rendered.py against an empty build directory, where it runs to exit 0 and two lines of
# real output. So the absence is the suite's and not the helper's. Block [2] and the
# grep of block [3] put the count behind that absence, and block [4] shows the other
# half of it, that there is no test_rendered.py to hold such a call. Block [5] is the
# sentence README.md already carries, at :329, which the docstring now points at instead
# of contradicting; casting 6 corrected the README's own copy of this clause at 6e03c94.
#
# The census restricts itself to *.py. Run without that restriction it also reports
# __pycache__ blobs, which are present or absent depending on what has run on the
# machine and under which interpreters -- the same non-determinism 0acbbb2 fixed for a
# different grep in this suite.
#
# One thing this measurement changed about the fix itself. The replacement sentence
# first read "no ``run_script("rendered.py")`` call site under ``tests/``", and block [2]
# then scored conftest.py at rendered=1: the docstring's own quotation of the pattern is
# what the census found. A claim that falsifies itself by being written down is worth no
# more than the clause it replaced, so the sentence now says no test module passes that
# name to run_script, which is the same fact in a form the grep cannot trip over. The
# conftest.py row below reads 0.

