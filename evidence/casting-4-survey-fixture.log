config: [('DATABASE_URL', True, 'src/app/main.py:6'), ('REQUEST_TIMEOUT', True, 'src/app/main.py:7'), ('APP_DEBUG', True, 'src/app/main.py:8')]
http: [('GET', '/items', 'src/app/main.py:11'), ('POST', '/items/{item_id}', 'src/app/main.py:16')]
tooling entries without an anchor: 2
