== the script this log runs ==
# Cycle-17: the red-first matrix both test modules publish, re-measured across every
# revision of the script each one drives, including the revision this cycle added.
# Run from the repository root. Each cell is one run of the module against one
# revision's script, in a scratch copy of the plugin, exactly as the docstrings say.
import re, shutil, subprocess, tempfile, os

MATRIX = {
    "slop": ["cfafe8e", "af10189", "ba33497", "ecc7dd5", "ad38ed9", "f33f7c2",
             "f3e30a5", "368b269", "2830b9c", "8fe80e2", "0ea38dd"],
    "scaffold": ["cfafe8e", "af10189", "ecc7dd5", "3dadc71", "8387b46", "5fc0761",
                 "ad38ed9", "f3e30a5", "0ea38dd"],
}


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


for name, revs in MATRIX.items():
    print(f"== tests/test_{name}.py against every revision of scripts/{name}.py ==")
    listed = git("log", "--oneline", "--reverse", f"cfafe8e..0ea38dd",
                 "--", f"plugins/webster/scripts/{name}.py")
    print(f"   git log --oneline --reverse cfafe8e..0ea38dd -- plugins/webster/scripts/{name}.py")
    for line in listed.splitlines():
        print(f"     {line}")
    print(f"   the docstring's list, cfafe8e plus those: {len(revs)} revisions")

    scratch = tempfile.mkdtemp()
    plugin = os.path.join(scratch, "webster")
    shutil.copytree("plugins/webster", plugin)
    failures = {}
    for rev in revs:
        with open(os.path.join(plugin, "scripts", f"{name}.py"), "w", encoding="utf-8") as f:
            f.write(git("show", f"{rev}:plugins/webster/scripts/{name}.py"))
        r = subprocess.run(["uvx", "pytest", f"tests/test_{name}.py", "-q", "--no-header",
                            "-p", "no:cacheprovider", "-rf"],
                           cwd=plugin, capture_output=True, text=True)
        red = sorted(set(re.findall(rf"^FAILED tests/test_{name}\.py::(\w+)", r.stdout, re.M)))
        failures[rev] = red
        summary = [l for l in r.stdout.splitlines() if " passed" in l or " failed" in l][-1]
        print(f"   {rev:9s} {re.sub(r' in [0-9.]+s$', '', summary.strip())}")
    shutil.rmtree(scratch)

    print(f"   per row, the revisions it is red against:")
    rows = sorted({t for red in failures.values() for t in red}
                  | set(re.findall(r"^def (test_\w+)",
                                   open(f"plugins/webster/tests/test_{name}.py",
                                        encoding="utf-8").read(), re.M)))
    for row in rows:
        red = [rev for rev in revs if row in failures[rev]]
        print(f"     {row:58s} {'guard (green at every revision)' if not red else ' '.join(red)}")
    print()

