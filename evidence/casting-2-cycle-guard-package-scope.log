# evidence-cmd: cd plugins/foundry/mcp-server && SNAP=$(mktemp) && cp src/foundry_mcp/server.py "$SNAP" && printf '\n\ndef _sneaky_cycle_reader(project_root):\n    return json.loads((Path(project_root) / "state.json").read_text())["cycle"]\n' >> src/foundry_mcp/server.py && echo "== a raw cycle read now sits in server.py: the package ROOT, not tools/ ==" && uv run --quiet --with pytest python -c 'import sys; sys.path[:0] = ["tests", "src"]; from pathlib import Path; import test_orchestrator_gates as t, foundry_mcp; pkg = Path(foundry_mcp.__file__).resolve().parent; old = sorted(p for p in (pkg / "tools").glob("*.py") if p.name != "__init__.py"); scan = lambda ms: t._scan(ms, t._raw_state_cycle_reads)[1]; print("  tools/ directory literal (D-066) ->", scan(old)); print("  derived over the package     ->", scan(t._package_modules(pkg)))' && echo "== and the guard itself, on the same mutated tree ==" && uv run --quiet --with pytest pytest tests/test_orchestrator_gates.py -q -p no:cacheprovider -k guarded_reader 2>&1 | grep -E "^E +assert not|failed|passed"; cp "$SNAP" src/foundry_mcp/server.py && cmp -s "$SNAP" src/foundry_mcp/server.py && ! grep -q _sneaky_cycle_reader src/foundry_mcp/server.py && rm -f "$SNAP" && echo "== server.py restored: byte-identical to the pre-mutation snapshot, appended reader gone ==" && echo "== both tests green on the unmutated tree ==" && uv run --quiet --with pytest pytest tests/test_orchestrator_gates.py -q -p no:cacheprovider -k "guarded_reader or tools_subpackage" 2>&1 | grep -E "failed|passed"
# evidence-for: FR-005, AC-008, NFR-001
# evidence-volatile: \d+\.\d+s
# evidence-volatile: Installed \d+ packages in \d+ms
