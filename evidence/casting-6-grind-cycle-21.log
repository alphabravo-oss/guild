# evidence-cmd: cd plugins/foundry/mcp-server && uv run --quiet python -c 'import asyncio,json,re,tempfile,pathlib; from foundry_mcp import server as srv; from foundry_mcp.tools.foundry import foundry_init; from foundry_mcp.tools.foundry_state import clear_active_run; from foundry_mcp.tools import display; R=pathlib.Path.cwd().parents[2]; raw=lambda p:p.read_text(encoding="utf-8"); rel=lambda p:str(p.relative_to(R)); rows=lambda p:[e for b in re.findall(r"^```json\n(.*?)^```$",raw(p),re.S|re.M) if chr(34)+"defects"+chr(34) in b for e in (json.loads(b).get("defects") or [])]; req=sorted(next(t for t in asyncio.run(srv.list_tools()) if t.name=="Foundry-Sync").inputSchema["properties"]["findings"]["items"]["required"]); tmp=tempfile.mkdtemp(prefix="d209-evidence-"); foundry_init(project_root=tmp); setattr(srv,"_project_root",tmp); res=lambda row:(lambda t:json.loads(t.partition(display.RESULT_JSON_MARKER)[2] or t))(chr(10).join(getattr(b,"text",str(b)) for b in asyncio.run(srv.call_tool("Foundry-Sync",{"cycle":1,"findings":[row]})))); verdict=lambda row:(lambda r:"ACCEPTED" if not (r.get("error") or r.get("refusals")) else "REFUSED naming "+", ".join(r.get("missing_fields") or [str(x.get("field")) for x in (r.get("refusals") or [])]))(res(row)); strip=lambda e:{k:v for k,v in e.items() if k not in ("description","source")}; AG=R/"plugins/foundry/agents"; SK=R/"plugins/foundry/skills"; surfaces=[p for p in sorted(AG.glob("*.md"))+sorted(SK.glob("*/SKILL.md")) if rows(p)]; print("== FR-007 / CT-002: what Foundry-Sync REQUIRES on a finding, read from the advertised inputSchema =="); print("   findings[].required ->", req); print(); print("== D-209 reproduction: every documented filing row VERBATIM, minus description and source =="); print("   (the shape these six surfaces published at 916c1ca)"); [print("   %-42s row %d -> %s" % (rel(p), i, verdict(strip(e)))) for p in surfaces for i,e in enumerate(rows(p))]; print(); print("== D-209 resolution: the same rows as the surfaces document them today =="); [print("   %-42s row %d -> %s" % (rel(p), i, verdict(e))) for p in surfaces for i,e in enumerate(rows(p))]; print(); print("== CT-002: one refused finding discards the WHOLE batch, so the count is what matters =="); print("   documented filing rows in the corpus:", sum(len(rows(p)) for p in surfaces)); print("   rows that landed before this fix:", sum(1 for p in surfaces for e in rows(p) if verdict(strip(e))=="ACCEPTED")); print("   rows that land now:", sum(1 for p in surfaces for e in rows(p) if verdict(e)=="ACCEPTED")); print(); print("== the one surface still short a field, and exactly which one =="); [print("   %-42s row %d -> %s" % (rel(p), i, verdict(e))) for p in surfaces for i,e in enumerate(rows(p)) if verdict(e)!="ACCEPTED"]; clear_active_run()' && COLUMNS=80 uv run --quiet --with pytest pytest -q -p no:cacheprovider --no-header tests/test_protocol_prose.py -k "filing_row or undriven or driven_filing or latent_example_survives or published_type or filing_roster" 2>&1 | tail -2
