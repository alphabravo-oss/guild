# evidence-cmd: sh -c 'set -e; t="$(mktemp -d)"; printf "%s\n" "def make_case():" "    def test_nested_inside_a_factory():" "        assert True" "    return test_nested_inside_a_factory" "" "" "def test_real_one():" "    assert True" > "$t/test_nested.py"; printf "%s\n" "# def test_commented_out():" "#     assert True" "" "" "def test_real_one():" "    assert True" > "$t/test_commented.py"; printf "%s\n" "\"\"\"A usage note that shows the shape of a case:" "" "def test_shown_in_prose():" "    assert True" "\"\"\"" "" "" "def test_real_one():" "    assert True" > "$t/test_docstring.py"; echo "--- the three constructs, one real test in each module besides the construct ---"; for f in test_commented test_docstring test_nested; do echo "  == $f.py =="; sed "s/^/     /" "$t/$f.py"; done; echo; echo "--- grep -c \"^def test_\" ---"; for f in test_commented test_docstring test_nested; do printf "    %-20s %s\n" "$f.py" "$(grep -c "^def test_" "$t/$f.py")"; done; echo; echo "--- the AST rule _scan_module uses (top-level FunctionDef whose name starts with test) ---"; printf "%s\n" "import ast, pathlib, sys" "for p in sorted(pathlib.Path(sys.argv[1]).glob(\"test_*.py\")):" "    names = [n.name for n in ast.parse(p.read_text()).body if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and n.name.startswith(\"test\")]" "    print(f\"    {p.name:<20} {len(names)}  {names}\")" > "$t/scan.py"; python3 "$t/scan.py" "$t"; echo; echo "--- what pytest collects ---"; ( cd "$t" && uvx pytest --collect-only -q -p no:cacheprovider 2>&1 | sed "s/^/    /" ); rm -rf "$t"'
# evidence-for: FR-039, AC-039, NFR-001
# evidence-volatile: \d+\.\d+s
# evidence-timeout: 120
#
# D-163, PROVE cycle 16 F-03. _scan_module's docstring justified parsing with AST rather
# than grepping ^def test_ by naming two constructs that would make a text count wrong:
# a nested def inside a factory, and a commented-out test. Measured on three modules
# each holding one real test beside one construct, neither costs that grep anything --
# the nested def is indented and the commented one carries its # at column 0, so ^ misses
# both exactly as the AST does, and grep, the AST rule and pytest all answer 1. The
# construct that does part them is a column-0 def test_ inside a triple-quoted string:
# grep answers 2, the AST rule and pytest 1. That is the case the docstring now names.

--- the three constructs, one real test in each module besides the construct ---
  == test_commented.py ==
     # def test_commented_out():
     #     assert True
     
     
     def test_real_one():
         assert True
  == test_docstring.py ==
     """A usage note that shows the shape of a case:
     
     def test_shown_in_prose():
         assert True
     """
     
     
     def test_real_one():
         assert True
  == test_nested.py ==
     def make_case():
         def test_nested_inside_a_factory():
             assert True
         return test_nested_inside_a_factory
     
     
     def test_real_one():
         assert True

--- grep -c "^def test_" ---
    test_commented.py    1
    test_docstring.py    2
    test_nested.py       1

--- the AST rule _scan_module uses (top-level FunctionDef whose name starts with test) ---
    test_commented.py    1  ['test_real_one']
    test_docstring.py    1  ['test_real_one']
    test_nested.py       1  ['test_real_one']

--- what pytest collects ---
    test_commented.py::test_real_one
    test_docstring.py::test_real_one
    test_nested.py::test_real_one
    
    3 tests collected in 0.00s
