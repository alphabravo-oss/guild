# evidence-cmd: sh -c 'for a in foundry:teammate foundry:flow-mapper forge:spec-reviewer; do echo "== $a"; echo "  foundry README | $(grep -m1 "^| .$a. " plugins/foundry/README.md)"; echo "  forge   README | $(grep -m1 "^| .$a. " plugins/forge/README.md)"; done; echo; echo "== live code: foundry MCP steerable set and its only spawn sites"; grep "^STEERABLE_SUBAGENT_TYPES" plugins/foundry/mcp-server/src/foundry_mcp/tools/foundry_orchestrator.py | sed "s/^/  | /"; grep "^TEAMMATE_SUBAGENT_TYPE" plugins/foundry/mcp-server/src/foundry_mcp/tools/foundry_spawn.py | sed "s/^/  | /"; echo "  agent_model(\"foundry:teammate\") call sites in the orchestrator: $(grep -c "agent_model(\"foundry:teammate\")" plugins/foundry/mcp-server/src/foundry_mcp/tools/foundry_orchestrator.py)"; echo "  files in the foundry MCP source naming any forge agent: $(grep -rl "forge:" plugins/foundry/mcp-server/src/ | wc -l | tr -d " ")"; echo "  foundry manifest env carrying the option: $(grep "FOUNDRY_MODEL" plugins/foundry/.claude-plugin/plugin.json | tr -d " ")"; echo; echo "== live code: forge substitutes the option at exactly two spawn sites, neither of them teammate"; echo "  arrow-delimited \${user_config.model} sites in plan.md: $(grep -c "user_config.model" plugins/forge/commands/plan.md)"; echo "  plan.md sentences declaring those two the only option-fed spawns: $(grep -c "are the only two spawns in this command that take their model from the option" plugins/forge/commands/plan.md)"; echo "  forge files declaring a teammate spawn: $(grep -rl "subagent_type.*teammate" plugins/forge/commands/ plugins/forge/scripts/ | wc -l | tr -d " ")"; echo "  mcpServers declared by the forge manifest: $(grep -c mcpServers plugins/forge/.claude-plugin/plugin.json)"'
