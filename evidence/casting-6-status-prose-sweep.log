  test_doctype.py: tests=34 run_script_call_sites=2
  test_drift.py: tests=33 run_script_call_sites=39
  test_harness.py: tests=5 run_script_call_sites=1
  test_llmstxt.py: tests=18 run_script_call_sites=1
  test_readme.py: tests=6 run_script_call_sites=0
  test_scaffold.py: tests=12 run_script_call_sites=27
  test_slop.py: tests=10 run_script_call_sites=10
  test_survey.py: tests=30 run_script_call_sites=2
suite tests defined = 148
modules with no run_script call site = ['test_readme.py']
test files importing a webster script = []
test_drift.py tests not using the committed fixture = []
run_script(rendered.py) call sites = 0
tests/test_rendered.py exists = False
