# evidence-cmd: sh -c 'cd "$(git rev-parse --show-toplevel)"; d=$(mktemp -d); printf %s "" | base64 -d > "$d/sweep.py"; echo "--- the driver ---"; cat "$d/sweep.py"; echo "--- measured ---"; python3 "$d/sweep.py"; rm -rf "$d"'
# evidence-for: FR-038, AC-042, US-010
# evidence-timeout: 180
#
# Every remaining harness/count claim the README Status section makes, mutation-measured.
# Two did not hold and were rewritten with these numbers in hand:
#   - "Five of the seven scripts leave no other way in" -- runpy.run_path re-executes the
#     module and drives drift.py check to a real JSON line and exit 2 in process.
#   - "run_script drives those two the same way regardless" (scaffold.py and rendered.py)
#     -- nothing in the suite drives rendered.py at all, which the README's own
#     not-yet-exercised paragraph already said.
# The rest held: eight modules, 148 tests defined, test_readme.py the only module with no
# run_script call site, no test file importing a script, and every test_drift.py case on the
# committed fixture.

--- the driver ---
"""Mutation-measures every harness/count claim the README Status section makes.

Run from the repository root. Prints one derived fact per line; no absolute
path and no timing, so two runs of the same tree print the same bytes.
"""
import ast
import importlib
import json
import os
import runpy
import sys
import tempfile
from pathlib import Path

TESTS = Path("plugins/webster/tests")
SCRIPTS = Path("plugins/webster/scripts").resolve()

modules = sorted(TESTS.glob("test_*.py"))
print("test modules = " + str(len(modules)) + ": " + ", ".join(m.name for m in modules))

total = 0
for m in modules:
    tree = ast.parse(m.read_text(encoding="utf-8"))
    n = sum(1 for node in ast.walk(tree)
            if isinstance(node, ast.FunctionDef) and node.name.startswith("test_"))
    calls = sum(1 for node in ast.walk(tree)
                if isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
                and node.func.id == "run_script")
    total += n
    print("  " + m.name + ": tests=" + str(n) + " run_script_call_sites=" + str(calls))
print("suite tests defined = " + str(total))

# "Every module but tests/test_readme.py drives a script through run_script".
driving = [m.name for m in modules
           if any(isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
                  and node.func.id == "run_script"
                  for node in ast.walk(ast.parse(m.read_text(encoding="utf-8"))))]
print("modules with no run_script call site = " + str([m.name for m in modules if m.name not in driving]))

# "nothing is imported": no test module puts scripts/ on sys.path or imports one.
script_names = sorted(p.stem for p in SCRIPTS.glob("*.py"))
importers = []
for m in modules + [TESTS / "conftest.py"]:
    tree = ast.parse(m.read_text(encoding="utf-8"))
    for node in ast.walk(tree):
        if isinstance(node, ast.Import) and any(a.name in script_names for a in node.names):
            importers.append(m.name)
        if isinstance(node, ast.ImportFrom) and node.module in script_names:
            importers.append(m.name)
print("test files importing a webster script = " + str(sorted(set(importers))))

# "drift.py's cases all run against the committed fixture repo".
src = (TESTS / "test_drift.py").read_text(encoding="utf-8")
tree = ast.parse(src)
no_fixture = [n.name for n in ast.walk(tree)
              if isinstance(n, ast.FunctionDef) and n.name.startswith("test_")
              and "fixture_repo" not in (ast.get_source_segment(src, n) or "")
              and "build_repo" not in (ast.get_source_segment(src, n) or "")]
print("test_drift.py tests not using the committed fixture = " + str(no_fixture))

# rendered.py: driven by nothing, and has no test module.
rendered_sites = 0
for m in modules:
    tree = ast.parse(m.read_text(encoding="utf-8"))
    for node in ast.walk(tree):
        if (isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
                and node.func.id == "run_script" and node.args
                and isinstance(node.args[0], ast.Constant)
                and node.args[0].value == "rendered.py"):
            rendered_sites += 1
print("run_script(rendered.py) call sites = " + str(rendered_sites))
print("tests/test_rendered.py exists = " + str((TESTS / "test_rendered.py").exists()))

# "an imported copy stays frozen at the importing process's values", and
# "frozen is not sealed": runpy re-executes and re-binds.
cwd = os.getcwd()
d = Path(tempfile.mkdtemp())
(d / "docs").mkdir()
sys.path.insert(0, str(SCRIPTS))
os.chdir(d)
drift = importlib.import_module("drift")
frozen_here = Path(getattr(drift, "ROOT")).resolve() == d.resolve()
os.chdir(cwd)
still_frozen = Path(getattr(drift, "ROOT")).resolve() == d.resolve()
print("import drift.py bound ROOT to the cwd at import = " + str(frozen_here))
print("drift.ROOT still that directory after the process moved off it = " + str(still_frozen))

os.chdir(d)
sys.argv = ["drift.py", "check", "docs"]
out = []
code = None
try:
    import contextlib
    import io
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        runpy.run_path(str(SCRIPTS / "drift.py"), run_name="__main__")
except SystemExit as exc:
    code = exc.code
out = buf.getvalue()
os.chdir(cwd)
print("runpy.run_path(drift.py) check exit = " + str(code)
      + " status = " + json.loads(out)["status"])

sys.argv = ["scaffold.py", "init", "--subject", "Bad Key"]
scaffold = importlib.import_module("scaffold")
buf = io.StringIO()
with contextlib.redirect_stdout(buf):
    rc = scaffold.main()
print("import scaffold.py + main() exit = " + str(rc)
      + " status = " + json.loads(buf.getvalue())["status"])
