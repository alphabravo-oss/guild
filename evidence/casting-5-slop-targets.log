# evidence-cmd: cd plugins/webster && rm -rf /tmp/webster-c5-targets && mkdir -p /tmp/webster-c5-targets/docs/node_modules /tmp/webster-c5-targets/docs/.vitepress && printf '%s\n' '# Release notes' '' 'The queue drains in order.' > /tmp/webster-c5-targets/docs/ok.md && printf '%s\n' '# Shipped ✅' > /tmp/webster-c5-targets/docs/node_modules/vendored.md && printf '%s\n' '# Shipped ✅' > /tmp/webster-c5-targets/docs/.vitepress/vendored.md; echo '--- AC-035 / FR-027: a target that is neither a file nor a directory ---'; python3 scripts/slop.py /tmp/webster-c5-targets/no/such/dir; echo "exit=$?"; echo '--- FR-027: three .md files under the target, one of them a candidate ---'; find /tmp/webster-c5-targets/docs -name '*.md' | sort; python3 scripts/slop.py /tmp/webster-c5-targets/docs; echo "exit=$?"; echo '--- FR-027: the sentence over files(), which now names the prune ---'; sed -n '/^def files/,/^    """$/p' scripts/slop.py; rm -rf /tmp/webster-c5-targets
# evidence-for: US-008, FR-027, AC-035
#
# US-008 / FR-027. Two claims about what slop.py checks.
#
# AC-035: a path that is neither a file nor a directory prints no such target and
# exits 2, rather than walking to nothing and reporting a pass.
#
# The second half is what files() returns and what the count line says about it.
# Three .md files sit under the target and one is a candidate: the walk prunes
# dot-directories and node_modules with everything beneath them. Both pruned
# pages carry a heading that the emoji-heading rule reports at high severity, so
# reading either one would show up as exit 1 here and not as a changed number.
# The pruning is right and is unchanged; the docstring that called the result
# "every markdown file under TARGETS" was not, and it is printed here because a
# sentence is the whole of what this fix changed.
--- AC-035 / FR-027: a target that is neither a file nor a directory ---
no such target: /tmp/webster-c5-targets/no/such/dir
exit=2
--- FR-027: three .md files under the target, one of them a candidate ---
/tmp/webster-c5-targets/docs/.vitepress/vendored.md
/tmp/webster-c5-targets/docs/node_modules/vendored.md
/tmp/webster-c5-targets/docs/ok.md
no slop found across 1 files
exit=0
--- FR-027: the sentence over files(), which now names the prune ---
def files():
    """The .md, .mdx and .mmd files under TARGETS, minus the two directory names pruned below.

    It said "every markdown file under TARGETS" and it is not: the walk drops any directory
    whose name starts with a dot, and node_modules, with everything beneath them. Both are
    right to drop -- a dot-directory is a tool's own state (.vitepress, .docusaurus, .git)
    and node_modules is somebody else's prose, so a finding in either is not a finding about
    these docs -- and the absolute was the wrong part. It matters because main() prints
    len() of this list as the number of files checked, so a reader comparing that count
    against what they can see on disk needs to know which files were never candidates.

    A target named on the command line is itself taken as given -- a file is read, a
    directory is walked -- because naming it is the request; the pruning applies to what the
    walk finds below it. Raises OSError for a target that cannot be listed.
    """
