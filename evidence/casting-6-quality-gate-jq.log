# evidence-cmd: W=$(mktemp -d); P=/Users/rayjanoka/ab/code/pioneer/.claude; PRE=cd0a9b1; mkdir -p "$W/bin" "$W/badjq" "$W/nojq" "$W/fixed/.claude/hooks" "$W/prefix/.claude/hooks"; printf '#!/bin/sh\nfor a; do case "$a" in -*) ;; *) echo "$a";; esac; done\n' > "$W/bin/gofmt"; printf '#!/bin/sh\nexit 127\n' > "$W/badjq/jq"; cp "$W/bin/gofmt" "$W/badjq/gofmt"; IFS=:; for d in $PATH; do [ -d "$d" ] || continue; for f in "$d"/*; do b=${f##*/}; [ "$b" = jq ] && continue; [ -x "$f" ] || continue; [ -e "$W/nojq/$b" ] || ln -s "$f" "$W/nojq/$b"; done; done 2>/dev/null; unset IFS; cp "$W/bin/gofmt" "$W/nojq/gofmt" 2>/dev/null; chmod +x "$W/nojq/gofmt" 2>/dev/null; chmod +x "$W/bin/gofmt" "$W/badjq/jq" "$W/badjq/gofmt"; for v in fixed prefix; do cp "$P/hooks/_db-helpers.sh" "$P/hooks/_teammate-detect.sh" "$W/$v/.claude/hooks/"; git -C "$W/$v" init -q; git -C "$W/$v" config user.email t@t.t; git -C "$W/$v" config user.name T; printf 'package main\nfunc main(){}\n' > "$W/$v/bad.go"; git -C "$W/$v" add bad.go; done; cp "$P/hooks/quality-gate.sh" "$W/fixed/.claude/hooks/quality-gate.sh"; git -C "$P" show "$PRE:hooks/quality-gate.sh" > "$W/prefix/.claude/hooks/quality-gate.sh"; chmod +x "$W/fixed/.claude/hooks/quality-gate.sh" "$W/prefix/.claude/hooks/quality-gate.sh"; run() { out=$(printf '%s' "$3" | env PATH="$2" "$W/$1/.claude/hooks/quality-gate.sh" 2>&1); rc=$?; verdict=$(printf '%s' "$out" | grep -oE 'SKIP \(stop hook re-fire[^)]*\)|jq not found on PATH|FAIL \([0-9]+ issues\)|No supported language files changed' | head -1); printf '  %-22s exit=%s  %s\n' "$4" "$rc" "$verdict"; }; echo "== D-108: what the Stop hook does when it cannot read its own payload =="; echo; echo "hook version: PRE-FIX (pioneer .claude $PRE:hooks/quality-gate.sh)"; run prefix "$W/bin:$PATH"    '{"stop_hook_active":true}'  "re-fire, jq works"; run prefix "$W/badjq:$PATH"  '{"stop_hook_active":true}'  "re-fire, jq broken"; run prefix "$W/bin:$PATH"    '{"stop_hook_active":false}' "first fire, jq works"; run prefix "$W/bin:$PATH"    ''                           "empty payload"; echo; echo "hook version: FIXED (pioneer .claude working tree)"; run fixed "$W/bin:$PATH"     '{"stop_hook_active":true}'  "re-fire, jq works"; run fixed "$W/badjq:$PATH"   '{"stop_hook_active":true}'  "re-fire, jq broken"; run fixed "$W/bin:$PATH"     '{"stop_hook_active":false}' "first fire, jq works"; run fixed "$W/bin:$PATH"     ''                           "empty payload"; run fixed "$W/nojq"          '{"stop_hook_active":false}' "jq absent from PATH"; echo; echo "== the systemic half: teammate identity is read through jq too =="; run prefix "$W/badjq:$PATH"  '{"agent_name":"casting-6"}' "PRE-FIX  teammate"; run fixed  "$W/badjq:$PATH"  '{"agent_name":"casting-6"}' "FIXED    teammate"; rm -rf "$W"
# evidence-for: US-005, FR-012
# evidence-timeout: 120
#
# D-108, recorded as a manual repro because the guild suite cannot honestly
# reach it: the hook under test lives in a different repository
# (/Users/rayjanoka/ab/code/pioneer/.claude), and a guild test reaching across
# to an absolute path on one machine would pass or fail depending on who ran it.
#
# The loop-breaker. A Stop hook that blocks with exit 2 is re-fired with
# stop_hook_active=true, and skipping on that flag is the only thing that ends
# the loop. The flag was read as
#     $(echo "$INPUT" | jq -r '.stop_hook_active // false' ... || echo "false")
# so every way of FAILING to read it produced "false" -- indistinguishable from
# a genuine first fire. Read the PRE-FIX block: with jq broken, a re-fire is
# judged and blocked again, and will be re-fired and blocked again after that,
# without bound. An empty payload does the same.
#
# The fallback DIRECTION is the bug, not the jq dependency. Every other
# degradation in this hook fails toward NOT judging: no git means the
# language-detection fallback, no bc means STANDARD mode, a missing linter
# means that check is skipped, a failed checkout-index exits 1 because no
# verdict is better than a wrong one. The loop-breaker was the single place
# that failed toward judging anyway, and it was silent about it.
#
# Two changes, because the symbol fails in two directions. jq is now probed
# once as the hard dependency it is, mirroring the `command -v bc` shape
# further down, and the gate declines to run without it -- exit 1, which
# reports loudly without blocking the stop, rather than exit 0 which would
# silently drop the entire quality gate on any machine missing jq. And an
# unreadable re-fire state is now read AS a re-fire, which covers what the
# probe cannot: jq PRESENT but returning nothing usable. The empty-payload row
# is that case -- jq exits 0 having printed nothing at all, so the `||` never
# fires and no probe would have helped.
#
# The probe sits ABOVE the teammate guard on purpose, and the last block is
# why. _teammate-detect.sh reads all six identity fields through jq with
# `|| true`, so with jq unavailable is_teammate returns false for every input
# and every teammate and subagent runs the full gate -- contradicting the
# teammate guard immediately above it. One probe placed before the `source`
# covers both jq-dependent reads instead of only the loop-breaker, which is why
# this shape was chosen over merely flipping the fallback.
#
# "first fire, jq works" stays exit 2 in BOTH blocks. That row is the control:
# the gate still judges and still blocks when it can actually read its input,
# so none of this bought loop-safety by quietly disabling the gate.
#
# The harness is hermetic. It builds throwaway repositories, stubs `gofmt` with
# a three-line script that reports every file handed to it (the object under
# test is the hook's control flow, not gofmt, and depending on a real Go
# toolchain would make the output depend on the runner's PATH), shims jq to
# exit 127 for the "broken" rows, and mirrors PATH minus jq for the "absent"
# row. The pre-fix hook is read out of the pioneer .claude repository at a
# pinned SHA rather than reconstructed. No temp path, timestamp or duration is
# printed, so there is nothing volatile to declare.

== D-108: what the Stop hook does when it cannot read its own payload ==

hook version: PRE-FIX (pioneer .claude cd0a9b1:hooks/quality-gate.sh)
  re-fire, jq works      exit=0  SKIP (stop hook re-fire, allowing stop)
  re-fire, jq broken     exit=2  FAIL (1 issues)
  first fire, jq works   exit=2  FAIL (1 issues)
  empty payload          exit=2  FAIL (1 issues)

hook version: FIXED (pioneer .claude working tree)
  re-fire, jq works      exit=0  SKIP (stop hook re-fire, allowing stop)
  re-fire, jq broken     exit=0  SKIP (stop hook re-fire, allowing stop)
  first fire, jq works   exit=2  FAIL (1 issues)
  empty payload          exit=0  SKIP (stop hook re-fire, allowing stop)
  jq absent from PATH    exit=1  jq not found on PATH

== the systemic half: teammate identity is read through jq too ==
  PRE-FIX  teammate      exit=2  FAIL (1 issues)
  FIXED    teammate      exit=0  SKIP (stop hook re-fire, allowing stop)
