# evidence-cmd: printf '%s\n' 'import ast' 'import pathlib' 'import re' 'from foundry_mcp.schemas.vocab import (' '    REQUIREMENT_ID_RE as R,' '    REQUIREMENT_ID_PREFIXES as P,' '    NON_REQUIREMENT_ID_PREFIXES as NP,' '    is_requirement_id as IS,' ')' 'OLD = re.compile(r"\b(?:US|FR|NFR|AC|VC|IR|TR)-\d+(?:\.\d+)?\b")' 'print("== D-150: which requirement families exist was a literal, typed seven times ==")' 'print("   sites that each held their own copy, before this change:")' 'for s in ["tools/foundry_handoff.py", "tools/evidence.py", "tools/foundry_validate.py (x3)",' '          "tools/foundry_orchestrator.py", "tools/foundry.py (narrowest: US|FR|NFR)"]:' '    print("       %s" % s)' 'print("")' 'print("   the vocabulary now declares : %s" % sorted(P))' 'print("   the wide literal every copy held: %s" % sorted({"US","FR","NFR","AC","VC","IR","TR"}))' 'print("   families no copy could see  : %s" % sorted(P - {"US","FR","NFR","AC","VC","IR","TR"}))' 'print("")' 'SAMPLE = ("US-001 FR-002 NFR-003 AC-004 VC-005 IR-006 TR-007 "' '          "GI-008 ST-010 CT-009 OT-011 LR-012 "' '          "A-AUTO-003 FLAG-001 TEST-01 EVID-01 D-150 P-6")' 'print("   -- a line naming one id of every family, plus four foreign namespaces --")' 'print("      the old literal finds  : %s" % sorted(set(OLD.findall(SAMPLE))))' 'print("      the declared pattern   : %s" % sorted(set(R.findall(SAMPLE))))' 'print("      never narrows          : %s" % (set(OLD.findall(SAMPLE)) <= set(R.findall(SAMPLE))))' 'print("      foreign namespaces stay out: %s"' '      % [t for t in ("A-AUTO-003", "FLAG-001", "TEST-01", "EVID-01", "D-150", "P-6") if IS(t)])' 'print("")' 'print("== every committed evidence header still binds, and binds MORE ==")' 'print("   (forge-specs/ is gitignored -- .gitignore:15 -- so a worktree cannot")' 'print("    read a spec. The live spec sweep is the pytest test; the COMMITTED")' 'print("    corpus of `# evidence-for:` headers is what is reproducible here,")' 'print("    and it is the surface EVID-02 binds on.)")' 'empty, widened, lost = [], [], []' 'logs = sorted(pathlib.Path("evidence").glob("*.log"))' 'for lg in logs:' '    for line in lg.read_text(encoding="utf-8", errors="replace").splitlines():' '        if not line.startswith("# evidence-for:"):' '            continue' '        val = line.split(":", 1)[1]' '        was, now = set(OLD.findall(val)), set(R.findall(val))' '        if not now:' '            empty.append(lg.name)' '        if was - now:' '            lost.append("%s lost %s" % (lg.name, sorted(was - now)))' '        if now - was:' '            widened.append(lg.name)' 'print("   headers that parse to NO ids under the canonical pattern : %s" % empty)' 'print("   headers that LOSE an id vs the old literal (NFR-002)     : %s" % lost)' 'print("   at least one header now binds a family the old literal could")' 'print("   not see (CT-, ST-, OT-)                                  : %s"' '      % (len(widened) > 0))' 'print("   -- the two empty lists are the no-narrowing property; the True is")' 'print("      the fix. The logs are counted, not listed, because castings 2")' 'print("      and 4 are committing more of them while this cycle runs and a")' 'print("      byte-matched list would drift out from under the gate.")' 'print("")' 'print("   note: LR- was found BY the spec-sweep rung on its first run, in")' 'print("   forge-specs/codsworth-serena-daemon-lifecycle -- a '\''Locked")' 'print("   requirement'\'' family nothing in foundry had ever matched. It is now")' 'print("   declared, which is why the vocabulary lists twelve families and not")' 'print("   eleven.")' 'print("")' 'print("== no module declares its own requirement-id grammar ==")' 'PKG = pathlib.Path("plugins/foundry/mcp-server/src/foundry_mcp")' 'def prefixes(t):' '    return frozenset(p for p in P if re.search(r"(?<![A-Z])%s(?![A-Z])" % re.escape(p), t))' 'seen, off = [], []' 'for f in sorted(PKG.rglob("*.py")):' '    consts = [n.value for n in ast.walk(ast.parse(f.read_text(encoding="utf-8")))' '              if isinstance(n, ast.Constant) and isinstance(n.value, str)]' '    anchored = set()' '    for c in consts:' '        for a in ("^", "\\A"):' '            if c.startswith(a):' '                rest = c[len(a):]' '                if rest[:1] and rest[0] not in ".([\\":' '                    anchored.add(prefixes(c))' '    for c in consts:' '        fam2 = prefixes(c)' '        if len(fam2) < 2 or "-\\d" not in c:' '            continue' '        seen.append("%s#%s" % (f.name, "|".join(sorted(fam2))))' '        if fam2 not in anchored:' '            off.append("%s#%s" % (f.name, "|".join(sorted(fam2))))' 'OWNED = {"foundry_handoff.py", "evidence.py", "citation.py", "foundry.py", "vocab.py"}' 'print("   recogniser is non-blind (finds the known selector): %s"' '      % ("test_deriver.py#FR|US" in seen))' 'print("   offenders among this casting'\''s files              : %s"' '      % sorted({o for o in off if o.split("#")[0] in OWNED}))' 'print("   waived as format-bounded, not prose               : %s"' '      % sorted(set(seen) - set(off)))' 'print("   offenders outside this casting'\''s grant remain     : %s"' '      % (len({o for o in off if o.split('\''#'\'')[0] not in OWNED}) > 0))' 'print("   -- counted, not named: castings 2 and 4 are landing their halves")' 'print("      while this runs, so the NAMES drift and the pytest scan pins")' 'print("      them instead. They are listed in the completion report.")' 'print("   note: the waiver requires the anchor to be followed by a LITERAL.")' 'print("   Waiving on '\''^'\'' alone let parsers/spec.py'\''s '\''^.*?'\'' pass as a format;")' 'print("   it is a prose scanner wearing an anchor, and it is NOT waived now.")' 'print("")' 'print("== D-146: no unguarded text read remains in this casting'\''s files ==")' 'print("   (parsed from the AST, so a read_text named inside a COMMENT is not")' 'print("    counted -- a text scan reports one in foundry_handoff and is wrong)")' 'for