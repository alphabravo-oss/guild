# evidence-cmd: echo "D-031(c) FR-038: per module, test functions driving a script through run_script as a subprocess, and test functions using the committed fixture repo:" && for f in plugins/webster/tests/test_*.py; do echo "  $(basename "$f"): $(grep -cE '^def test.*run_script' "$f") of $(grep -cE '^def test' "$f") via run_script, $(grep -cE '^def test.*(fixture_repo|build_repo)' "$f") via tests/fixtures/repo"; done && echo "D-031(b) FR-038: what test_harness.py asserts about the child interpreter --" && grep -nE '^PYTHON_FLOOR|assert version >= PYTHON_FLOOR' plugins/webster/tests/test_harness.py && echo "D-034 FR-038: argparse handling in survey.py: $(grep -c argparse plugins/webster/scripts/survey.py) in the script, $(grep -c argparse plugins/webster/tests/test_survey.py) in its test module" && echo "D-031(a) FR-038: retracted skew wording in README: $(grep -c 'the interpreter skew a real invocation has' plugins/webster/README.md); corrected wording: $(grep -c 'it is the same interpreter' plugins/webster/README.md)" && echo "D-031(a) FR-038: measured under the README Status section own command --" && d=$(mktemp -d) && printf '%s\n' 'import os, subprocess, sys' 'def test_probe():' '    env = {k: os.environ[k] for k in ("PATH", "HOME") if k in os.environ}' '    r = subprocess.run(["python3", "-c", "import sys, os; print(os.path.realpath(sys.executable)); print(sys.prefix); print(tuple(sys.version_info[:3]))"], capture_output=True, text=True, env=env)' '    child_exe, child_prefix, child_ver = r.stdout.splitlines()' '    print("child_realpath_equals_pytest_realpath:", child_exe == os.path.realpath(sys.executable))' '    print("child_prefix_equals_pytest_prefix:", child_prefix == sys.prefix)' '    print("child_clears_the_3_11_floor:", eval(child_ver) >= (3, 11))' > "$d/test_probe.py" && (cd plugins/webster && COLUMNS=120 uvx pytest -p no:cacheprovider -q --no-header -s "$d/test_probe.py" 2>&1 | grep -E '^child_'); rm -rf "$d"
# evidence-for: FR-038, US-010
# evidence-timeout: 300
#
# D-031 and D-034: the Status section's account of the suite, measured claim by
# claim instead of asserted. Four sentences were wrong before this commit and each
# line below is the measurement that fixed one.
#
# (c) "by subprocess against the committed fixture repo" described the whole suite.
#     The per-module counts show it describes part of it: every module but
#     test_readme.py drives scripts through run_script, but only drift.py's cases
#     run entirely against tests/fixtures/repo -- the rest build a tmp_path tree and
#     reach for the fixture only where a case needs a real repository under it.
#
# (b) "measures which interpreter the child python3 actually resolves to" -- the
#     grep shows test_harness.py asserts a floor and nothing more, which is what its
#     own docstring says ("at or above 3.11").
#
# (d) "survey.py across ... argparse ..." claimed coverage for something survey.py
#     does not do: the script contains no argparse handling and no test module
#     mentions it. The fixture repo has an argparse CLI, but test_drift.py cites it
#     as a changed source file; nothing surveys it.
#
# (a) "pytest itself runs on uv's CPython 3.11 while the scripts run under whatever
#     python3 is on PATH, which is the interpreter skew a real invocation has" --
#     the claim conftest.py had already retracted. The probe measures it under the
#     README's own command by generating a throwaway test outside the repository:
#     uvx prepends its ephemeral venv's bin to PATH, so run_script's literal
#     "python3" resolves inside that venv and the child is the same interpreter
#     collecting the tests. Realpath and sys.prefix are compared rather than
#     sys.executable, because uv's bin holds both python and python3 pointing at one
#     binary and a string compare would read the same interpreter as two.
#     The probe writes nothing into the repository and removes its own tmpdir.

