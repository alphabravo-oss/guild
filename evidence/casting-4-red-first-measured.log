# evidence-cmd: d=$(mktemp -d) && cp -R plugins/webster "$d/webster" && rm -rf "$d/webster/.pytest_cache" && git rev-list --reverse --abbrev=7 --abbrev-commit cfafe8e~1..8989d75 | sort > "$d/hist" && for m in survey llmstxt; do echo "=== tests/test_$m.py against every revision its own table names ==="; python3 -c "import ast,re; print(chr(10).join(sorted(set(re.findall(r'[0-9a-f]{7}', ast.get_docstring(ast.parse(open('plugins/webster/tests/test_$m.py',encoding='utf-8').read())))))))" | sort > "$d/named"; comm -12 "$d/hist" "$d/named" > "$d/both"; for r in $(git rev-list --reverse --abbrev=7 --abbrev-commit cfafe8e~1..8989d75 | grep -Fx -f "$d/both"); do git show "$r:plugins/webster/scripts/$m.py" > "$d/webster/scripts/$m.py"; echo "$r"; ( cd "$d/webster" && COLUMNS=120 uvx pytest -p no:cacheprovider -q --no-header "tests/test_$m.py" 2>&1 | grep -E "^FAILED |^[0-9]+ (failed|passed)" | sed -E "s/^FAILED tests\/test_$m.py:://; s/ - .*//; s/ in [0-9.]+s\$//; s/^/  /" ); done; echo "shas the docstring names that are not commits in cfafe8e~1..8989d75:"; comm -13 "$d/hist" "$d/named" | sed "s/^/  /"; done; rm -rf "$d"
# evidence-for: FR-039, AC-039, US-006, US-007
# evidence-timeout: 300
#
# The COVERAGE half of the sweep: every "red against REV" row and every note of
# the form "red at X too" in the two module docstrings, re-measured by the
# method those docstrings publish -- copy the plugin to a scratch tree, drop
# that revision's script into it, run the module. The revision list is not typed
# out here; it is read out of each docstring by AST, intersected with the
# commits in cfafe8e~1..8989d75, and walked in history order, so the set
# measured is exactly the set the table names. The last line under each module
# is that intersection's remainder, and it is empty: no sha either table names
# is a sha this range does not carry.
#
# What the runs below confirm, row by row:
#   - test_survey.py, 30 rows: 25 red at cfafe8e and 5 green, and the 5 green
#     are the 4 rows filed "guard" plus the one filed "n/a (reads this table)".
#     Every row naming a later revision is red at the revision it names and
#     green at the next measured revision after it.
#   - test_llmstxt.py, 18 rows: 12 red at cfafe8e and 6 green. The docstring
#     says every row naming a later commit is red at cfafe8e as well "except
#     these two, which pass there" -- and the two it names,
#     test_unterminated_html_comment_publishes_nothing_after_it and
#     test_a_stub_marker_in_a_description_falls_through_to_the_next_source, are
#     exactly the two absent from the cfafe8e failure list below.
#   - "guard" is defined in both docstrings as green at every revision measured.
#     No row filed guard appears in any failure list below.
#
