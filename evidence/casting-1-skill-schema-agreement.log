# evidence-cmd: cd plugins/foundry/mcp-server && uv run --quiet --with pytest python -c 'import sys, json; sys.path[:0] = ["tests", "src"]; import test_findings_schemas as t; from foundry_mcp.schemas.findings import SCHEMAS; N = t._documented_schema_name; E = lambda p, m: t._errors(SCHEMAS[N(p)], t._documented_report(p, maximal=m)); print("=== the block each skill documents, against the schema that same file names ==="); [print("  %-38s schema_name=%-6s errors(all fields)=%d  errors(required only)=%d" % (t._rel(p), N(p), len(E(p, True)), len(E(p, False)))) for p in (t.TRACE_SKILL, t.PROVE_SKILL)]; print(); print("=== one finding, expanded per id family the trace block names ==="); [print("  " + f["id"] + "  type=" + f["type"] + "  classification=" + f["classification"]) for f in t._documented_report(t.TRACE_SKILL, maximal=True)["findings"]]; print(); print("=== negative controls: the same schema still refuses what the vocabulary forbids ==="); F = {"id": "L-1", "classification": "DEFECT", "type": "WRONG", "file": "src/x.py", "symbol": "x#y", "description": "a description past the ten-character floor"}; S = {"total": 1, "verdict": "FAIL", "items_checked": 1, "items_total": 1, "findings_count": 1}; [print("  %-34s -> %s" % (label, "; ".join(t._errors(SCHEMAS["trace"], {"findings": [f], "summary": S})) or "ACCEPTED")) for label, f in [("the reconciled finding", F), ("+ severity: critical", dict(F, severity="critical")), ("+ category: spec-drift", dict(F, category="spec-drift")), ("id F-1 (pre-effort family)", dict(F, id="F-1")), ("classification: BLOCKER", dict(F, classification="BLOCKER"))]]'
# evidence-for: FR-013, NFR-002
# evidence-timeout: 300
#
# D-071 — the behaviour, not just the tests passing.
#
# Two shipped skills tell a stream to validate its own report against a
# built-in schema (skills/trace/SKILL.md:255 with schema_name "trace",
# skills/prove/SKILL.md:209 with "prove"), and each of those same files
# documents in its own ```json block the shape the stream should emit.
# Nothing ever compared the two. They had drifted completely: an instance
# conforming EXACTLY to the trace block produced SIX errors against
# SCHEMAS["trace"] — 'severity' is a required property; 'category' is a
# required property; Additional properties are not allowed ('class',
# 'classification', 'spec_reference', 'suggested_fix', 'symbol', ...);
# 'L-1' does not match '^F-\d+$'; 'by_category' is a required property;
# 'x' is too short.
#
# The first block below re-runs that comparison and reports zero errors, both
# for an instance carrying every property the block declares and for one
# carrying only its `required` fields. Nothing here is hand-written: the
# schema is looked up by the name the SKILL.md ITSELF passes to
# Validate-Report, the instance is synthesized from that file's own json
# block, and the id families come from that block's own `id` description —
# so this cannot pass by agreeing with vocab.py while disagreeing with the
# document, which is the failure mode being fixed.
#
# The third block is what keeps the widening honest. Zero errors would also
# be what a rubber-stamp schema reports, so the same schema is driven against
# four findings it must refuse: the two axes the effort abolished (`severity`
# — named by the R1.5 research finding as the practice most often gamed — and
# `category`), the pre-effort `F-N` id family, and a classification outside
# the DEFECT/OBSERVATION channel. Each is refused BY NAME, which is what
# makes the prohibition both enforced and diagnosable.
#
# Deterministic: no timestamps, paths, durations or counts in the output, so
# no volatile declarations are needed. `--quiet` per D-075.

=== the block each skill documents, against the schema that same file names ===
  plugins/foundry/skills/trace/SKILL.md  schema_name=trace  errors(all fields)=0  errors(required only)=0
  plugins/foundry/skills/prove/SKILL.md  schema_name=prove  errors(all fields)=0  errors(required only)=0

=== one finding, expanded per id family the trace block names ===
  DEV-1  type=ARCHITECTURAL_PLACEMENT  classification=DEFECT
  L-2  type=ARCHITECTURAL_PLACEMENT  classification=DEFECT
  SA-3  type=ARCHITECTURAL_PLACEMENT  classification=DEFECT
  THIN-4  type=ARCHITECTURAL_PLACEMENT  classification=DEFECT

=== negative controls: the same schema still refuses what the vocabulary forbids ===
  the reconciled finding             -> ACCEPTED
  + severity: critical               -> findings.0: Additional properties are not allowed ('severity' was unexpected)
  + category: spec-drift             -> findings.0: Additional properties are not allowed ('category' was unexpected)
  id F-1 (pre-effort family)         -> findings.0.id: 'F-1' does not match '^(?:THIN|DEV|CR|DX|PL|SA|SP|L|T)-\\d+$'
  classification: BLOCKER            -> findings.0.classification: 'BLOCKER' is not one of ['DEFECT', 'OBSERVATION']
