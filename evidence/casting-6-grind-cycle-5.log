# evidence-cmd: cd plugins/foundry/mcp-server && uv run --quiet --with pytest python -c 'import sys,re,functools,subprocess; sys.path.insert(0,"tests"); import test_protocol_prose as T; rel=T._rel; Q=chr(34); flat=lambda s:" ".join(s.split()); before=lambda p:flat(subprocess.run(["git","show","30098a005c074a654aacb6892f707bc9aba0255a:"+p],capture_output=True,text=True,cwd=str(T.REPO_ROOT)).stdout); now=lambda p:T._flat(T.REPO_ROOT/p); PR=rel(T.PROVE_SKILL); TR=rel(T.TRACE_SKILL); SURF=[rel(x) for x in T.DEFECT_FILING_SURFACES]; TOK="|".join(sorted(T._banned_grade_tokens())); rx=re.compile("(?<![A-Za-z])(%s)(?![A-Za-z])" % TOK, re.I); shared=lambda p,t:(t.replace(T._tier_rule(T.REPO_ROOT/p)," <the shared rule> ") if T._tier_rule(T.REPO_ROOT/p) else t); ban=lambda t:T._BANNED_GRADE_RE.sub(" <ban> ",t); denied=lambda t:re.sub(T._AXIS_DENIAL_RE_TEMPLATE % TOK," <denied> ",t,flags=re.I); rec=lambda p,t:functools.reduce(lambda a,ph:a.replace(ph," <recorded> "),T._RECORDED_GRADE_WORD_USES.get(p,{}),t); scan=lambda p,t:[m.group(0) for m in rx.finditer(rec(p,denied(ban(shared(p,t)))))]; disc=lambda t:sorted(ph for ph,_ in T._DISCRETION_EXEMPTIONS if ph in t.lower()); C="No exceptions, no deferrals, no "+Q+"this one is only cosmetic."+Q; print("== D-092 / D-093 / D-096: the graded instructions, at the parent commit and now =="); [print("   %-50s at 30098a0: %-5s  now: %s" % (n,s in before(p),s in now(p))) for n,p,s in [("D-092 prove ranks its own verdicts",PR,"HOLLOW verdicts are highest priority"),("D-096 prove asks the critical-path triage question",PR,"**Critical path gaps**"),("D-096 prove demands a confidence rung",PR,"quality confidence (HIGH/MEDIUM/LOW)"),("D-093 trace withholds by how much it matters",TR,"Do NOT flag cosmetic/style issues")]]; print(); print("== the replacements, in the register the sibling filing surfaces use =="); [print("   %-50s at 30098a0: %-5s  now: %s" % (n,s in before(p),s in now(p))) for n,p,s in [("D-092 no fix order left to state",PR,"there is no fix order left for this step to state"),("D-096 placement describes, never triages",PR,"Description, never triage"),("D-096 no ladder averaged over the report",PR,"No confidence ladder over the report as a whole"),("D-093 scope is the subject, never the size",TR,"**Scope is the subject, never the size**"),("D-093 no discretion to call one cosmetic",TR,"no discretion to call one")]]; print(); print("== GI-001 / FR-030: the banned spellings are READ from the ban clause, never re-typed =="); print("   source: agents/assayer.md, the shared no-severity rule, parsed by _BANNED_GRADE_RE"); print("   derived:",sorted(T._banned_grade_tokens())); print(); print("== the corpus is derived too: every surface that names a filing door =="); [print("   -",p) for p in SURF]; print(); print("== every banned spelling in that corpus, at the parent commit and now =="); [print("   %-44s recorded=%-2d unrecorded at 30098a0=%-24s now=%s" % (p,len(T._RECORDED_GRADE_WORD_USES.get(p,{})),scan(p,before(p)) or "none",scan(p,now(p)) or "none")) for p in SURF]; print(); print("== no filing surface hands its stream discretion over a finding =="); [print("   %-44s at 30098a0=%-20s now=%s" % (p,disc(before(p)) or "none",disc(now(p)) or "none")) for p in SURF]; print(); print("== the no-discretion close, across the corpus =="); [print("   %-44s carries the shared close: %s" % (p,C in now(p))) for p in SURF]'
