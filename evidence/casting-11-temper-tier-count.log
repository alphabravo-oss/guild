# evidence-cmd: printf '%s\n' '== casting 11 / AC-022, AC-019, NFR-011: the tier and temper pins ==' '' '  WHAT THIS SELECTION REACHES. Four modules, three of them peer-owned:' '  tests/test_protocol_prose.py (casting 6, 204 selected),' '  tests/test_lead_prose.py (casting 8, 34) and' '  tests/test_findings_schemas.py (a key_file of no casting at all, 26).' '  Only tests/test_skill_prose.py (53) belongs to this casting. Both the' '  317 numerator and the 845 denominator move on any peer edit.' '' '  WHY A VERDICT AND NOT A COUNT. Committed reading 844 deselected, this' '  log read 845 at 3c01399. Same cause, same governing ruling, same two' '  rejected repairs: evidence/casting-1-no-degradation.log. Scope' '  unchanged -- all four modules, the same -k expression.' '' '  THE FLOOR. 300, because losing any one peer module from the selection' '  lands below it: 317 less test_findings_schemas.py 26 is 291, less' '  test_lead_prose.py 34 is 283, less test_protocol_prose.py 204 is 113.' '  The band is narrow -- 17 between the floor and the current 317 --' '  because the smallest peer module contributes only 26 nodes, and the bias' '  is deliberate: a floor loose enough to survive losing that module would' '  fail open on exactly the silent shrinkage a floor exists to catch.' '' && cd plugins/foundry/mcp-server && out=$(mktemp) && uv run --quiet --with pytest pytest -q -p no:cacheprovider tests/test_protocol_prose.py tests/test_lead_prose.py tests/test_skill_prose.py tests/test_findings_schemas.py -k "tier or temper" > "$out" 2>&1; ec=$?; tail -1 "$out" | awk -v ec="$ec" '{ p=0; for(i=1;i<NF;i++){ if($(i+1) ~ /^passed/) p=$i+0 } if (ec != 0 || $0 ~ /failed|error/) { print "VERDICT: FAIL -- exit " ec " -- " $0 } else if (p >= 300) { print "VERDICT: PASS -- exit 0, every tier and temper pin across the four modules green, collected floor >= 300 met" } else { print "VERDICT: FAIL -- floor not met: " $0 } }'; rm -f "$out"; exit $ec
