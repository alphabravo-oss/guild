# evidence-cmd: sh -c 'set -e; root="$(git rev-parse --show-toplevel)"; cd "$root/plugins/webster"; t="$(mktemp -d)"; printf "%s\n" "import ast, pathlib, sys" "d = pathlib.Path(sys.argv[1])" "mods = sorted(d.glob(\"test_*.py\"))" "total = 0" "for p in mods:" "    n = sum(1 for x in ast.parse(p.read_text()).body if isinstance(x, (ast.FunctionDef, ast.AsyncFunctionDef)) and x.name.startswith(\"test\"))" "    total += n" "    print(f\"      {p.name:<20} {n:>3}\")" "print(f\"      {total} tests across {len(mods)} modules\")" > "$t/count.py"; echo "--- the three places the suite count is written, at the pre-change commit b188ff0 and at HEAD ---"; for rev in b188ff0 HEAD; do echo "    $rev"; git show "$rev:plugins/webster/README.md" | grep -n "^[0-9][0-9]* passing" | sed "s|^|      README.md            |"; git show "$rev:plugins/webster/tests/test_readme.py" | grep -n "69 == \|77 by 61fb1df" | sed "s|^|      tests/test_readme.py |"; done; echo; echo "--- the suite those three claim to count, by the AST rule _scan_module uses ---"; python3 "$t/count.py" tests; echo; echo "--- and what pytest collects and reports (OT-036, NFR-001) ---"; uvx pytest --collect-only -q -p no:cacheprovider 2>&1 | tail -1 | sed "s|^|      |"; uvx pytest -q -p no:cacheprovider 2>&1 | grep -E "^FAILED|passed|failed" | sed "s|^|      |"; echo "      (the one red is the GI-007 scope guard on this run own committed evidence/ logs)"; echo; echo "--- every other count the Status section states about this suite, re-measured ---"; grep -n "passing across eight modules\|six of the seven scripts, one test module each\|measures five" README.md | sed "s|^|      README.md |"; echo "      test modules on disk: $(ls tests/test_*.py | wc -l | tr -d " ")   scripts on disk: $(ls scripts/*.py | wc -l | tr -d " ")"; for s in $(ls scripts/*.py | xargs -n1 basename | sed "s/\.py$//"); do if [ -f "tests/test_$s.py" ]; then echo "      $s.py -> tests/test_$s.py"; else echo "      $s.py -> no test module"; fi; done; echo "      (the five things test_harness.py measures are its five tests in the table above)"; rm -rf "$t"'
