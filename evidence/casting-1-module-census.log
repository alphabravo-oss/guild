      (tmp_path: Path) -> Path:
          """An empty docs tree per test. Pages are written by the test that needs them, because the
          lens findings depend on the exact prose and a shared tree would hide which page produced
          which finding."""
          docs = tmp_path / "docs"
          docs.mkdir()
          return docs
      
