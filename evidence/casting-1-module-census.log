# evidence-cmd: cd "$(git rev-parse --show-toplevel)"; T=$(mktemp -d); printf "%s\n" 'import ast, glob, os, re, subprocess' 'TESTS = '"'"'plugins/webster/tests'"'"'' 'mods = sorted(os.path.basename(p) for p in glob.glob(TESTS + '"'"'/test_*.py'"'"'))' 'print('"'"'[1] the modules this suite is made of, and what each one asks conftest for'"'"')' 'print('"'"'    %-20s %-10s %-13s %-11s %s'"'"' % ('"'"'module'"'"', '"'"'run_script'"'"', '"'"'fixture_repo'"'"', '"'"'build_repo'"'"', '"'"'scripts it drives'"'"'))' 'counts = {}' 'for f in mods:' '    src = open(os.path.join(TESTS, f), encoding='"'"'utf-8'"'"').read()' '    t = ast.parse(src, f)' '    args = set()' '    for n in ast.walk(t):' '        if isinstance(n, ast.FunctionDef) and n.name.startswith('"'"'test_'"'"'):' '            args.update(a.arg for a in n.args.args)' '    driven = sorted({m for m in re.findall(r'"'"'run_script\(\s*"([a-z]+\.py)"'"'"', src)})' '    counts[f] = (args, driven)' '    print('"'"'    %-20s %-10s %-13s %-11s %s'"'"' % (' '        f, '"'"'yes'"'"' if '"'"'run_script'"'"' in args else '"'"'no'"'"',' '        '"'"'yes'"'"' if '"'"'fixture_repo'"'"' in args else '"'"'no'"'"',' '        '"'"'yes'"'"' if '"'"'build_repo'"'"' in args else '"'"'no'"'"',' '        '"'"', '"'"'.join(driven) or '"'"'(none)'"'"'))' 'takes_rs = [f for f in mods if '"'"'run_script'"'"' in counts[f][0]]' 'takes_fx = [f for f in mods if '"'"'fixture_repo'"'"' in counts[f][0]]' 'drives   = [f for f in mods if counts[f][1]]' 'print()' 'print('"'"'    modules in the suite:                        %d'"'"' % len(mods))' 'print('"'"'    take the run_script fixture:                 %d -- %s'"'"' % (len(takes_rs), '"'"', '"'"'.join(takes_rs)))' 'print('"'"'    do not:                                      %d -- %s'"'"'' '      % (len(mods) - len(takes_rs), '"'"', '"'"'.join(f for f in mods if f not in takes_rs)))' 'print('"'"'    take fixture_repo (built from the committed tree): %d -- %s'"'"' % (len(takes_fx), '"'"', '"'"'.join(takes_fx)))' 'print('"'"'    do not:                                      %d -- %s'"'"'' '      % (len(mods) - len(takes_fx), '"'"', '"'"'.join(f for f in mods if f not in takes_fx)))' 'print('"'"'    take a webster script as their subject:      %d -- %s'"'"' % (len(drives), '"'"', '"'"'.join(drives)))' 'print()' 'print('"'"'    -> "every other module in this suite depends on" (run_script) counted'"'"')' 'print('"'"'       test_readme.py, which takes neither fixture. Corrected to name it.'"'"')' 'print('"'"'    -> "every other module in this suite builds its repository from it"'"'"')' 'print('"'"'       counted four modules that take no repository fixture at all.'"'"')' 'print()' 'print('"'"'[2] the two modules that take no repository fixture but do drive a script'"'"')' 'print('"'"'    test_doctype.py docs_dir -- an empty tree it makes itself, not the committed fixture:'"'"')' 'd = open(TESTS + '"'"'/test_doctype.py'"'"', encoding='"'"'utf-8'"'"').read().split('"'"'def docs_dir'"'"')[1]' 'for line in d.splitlines()[:8]:' '    print('"'"'      '"'"' + line.rstrip())' 'print('"'"'    test_readme.py says so itself:'"'"')' 'for i, line in enumerate(open(TESTS + '"'"'/test_readme.py'"'"', encoding='"'"'utf-8'"'"'), 1):' '    if '"'"'run_script'"'"' in line or '"'"'fixture_repo'"'"' in line:' '        print('"'"'      %s'"'"' % line.strip())' 'print()' 'print('"'"'[3] GI-004 / AC-041 / OT-039: nothing imports a script, every call goes through the helper'"'"')' 'for pat in ('"'"'import survey'"'"', '"'"'import drift'"'"', '"'"'import slop'"'"', '"'"'import doctype'"'"',' '            '"'"'import llmstxt'"'"', '"'"'import scaffold'"'"'):' '    hits = subprocess.run(['"'"'grep'"'"', '"'"'-rn'"'"', '"'"'--include=*.py'"'"', pat, TESTS],' '                          capture_output=True, text=True).stdout.strip()' '    print('"'"'    grep -rn --include=*.py %-18r -> %s'"'"' % (pat, hits or '"'"'nothing'"'"'))' 'print('"'"'    run_script( call sites across the suite: %s'"'"'' '      % subprocess.run('"'"'grep -rn --include=*.py "run_script(" '"'"' + TESTS + '"'"' | wc -l'"'"',' '                       shell=True, capture_output=True, text=True).stdout.strip())' 'print()' 'print('"'"'[4] CT-007 / FR-029: the two things that decide the child interpreter'"'"')' 'print(subprocess.run(['"'"'grep'"'"', '"'"'-n'"'"', '"'"'_BASE_ENV_KEYS = '"'"', '"'"'-e'"'"', '"'"'"python3", str(script)'"'"',' '                      TESTS + '"'"'/conftest.py'"'"'], capture_output=True, text=True).stdout.rstrip())' 'print('"'"'    no caller overrides PATH through run_script(env=...):'"'"')' 'print('"'"'    %s'"'"' % (subprocess.run(' '    '"'"'grep -rn --include=test_*.py "run_script(.*PATH" '"'"' + TESTS + '"'"' | wc -l'"'"',' '    shell=True, capture_output=True, text=True).stdout.strip() + '"'"' such call sites'"'"'))' 'print()' 'print('"'"'[5] NFR-001: no skip, no xfail anywhere in the suite'"'"')' 'out = subprocess.run('"'"'grep -rn --include=*.py -E "pytest\\.mark\\.(skip|xfail)|skipif" '"'"' + TESTS,' '                     shell=True, capture_output=True, text=True).stdout.strip()' 'print('"'"'    %s'"'"' % (out or '"'"'no @pytest.mark.skip / xfail / skipif anywhere under tests/'"'"'))' > "$T/e.py"; python3 "$T/e.py"; rm -rf "$T"
# evidence-for: US-010, FR-039, FR-029, AC-039, AC-041, NFR-001, CT-007, GI-004, OT-039
#
# GRIND cycle 16, the sweep the lead asked for after D-160: re-read every remaining quantifier
# in test_harness.py against an enumeration. Two did not survive, both of them counting modules,
# and both are corrected in the same commit as D-160.
#
#   - "widening it for one measurement would change a locked contract that every other module in
#     this suite depends on" (the run_script contract). Seven of the eight modules take the
#     run_script fixture; test_readme.py takes neither it nor fixture_repo, and says so in its
#     own docstring. Corrected to name the exception.
#
#   - "the committed fixture tree is missing at ...; every other module in this suite builds its
#     repository from it". Four of the eight take fixture_repo. The other four do not:
#     test_doctype.py makes an empty docs_dir under tmp_path, and test_scaffold.py, test_slop.py
#     and test_readme.py take no repository fixture at all. Corrected to name the three that do.
#
# This is the third and fourth sentence of the same shape found in this file. The module
# docstring already records the first ("Every other module in this suite tests a webster
# script"), which counted test_readme.py the same way. Block [1] is the census all four should
# have been measured against, taken from the AST of each module's test signatures rather than
# from a grep that would count a mention in a docstring as a dependency.
#
# Blocks [3] to [5] re-measure the harness invariants the same sentences sit next to: nothing
# imports a script (GI-004, AC-041, OT-039), the child interpreter is decided by the literal
# "python3" and the PATH in _BASE_ENV_KEYS with no caller overriding it (CT-007, FR-029), and
# no test in the suite is skipped or xfailed (NFR-001) -- the grep hits there are the eight
# module docstrings saying so, not markers.

