# evidence-cmd: sh -c 'cd "$(git rev-parse --show-toplevel)"; t=$(mktemp -d); printf "%s\n" "import ast, subprocess, sys" "src = subprocess.run([\"git\", \"show\", sys.argv[1] + \":plugins/webster/scripts/drift.py\"], capture_output=True, text=True, check=True).stdout" "def flat(n):" "    if isinstance(n, ast.Constant): return str(n.value)" "    return \"\".join(str(v.value) if isinstance(v, ast.Constant) else \"{\" + ast.unparse(v.value) + \"}\" for v in n.values)" "notes = sorted((n.lineno, flat(n.value)) for n in ast.walk(ast.parse(src)) if isinstance(n, ast.Assign) and any(isinstance(x, ast.Name) and x.id == \"git_note\" for x in n.targets))" "for i, (ln, s) in enumerate(notes, 1):" "    print(\"  branch %d: %s\" % (i, s))" "    print(\"      carries re-record: %s\" % (\"re-record\" in s))" "print(\"  git_note branches: %d\" % len(notes))" > "$t/j.py"; J="python3 $t/j.py"; REVS="$(git log --format=%h --reverse 02f4e9e -- plugins/webster/scripts/drift.py) HEAD"; echo "=== D-152  the phrase \"against nothing\" over every revision of drift.py, and the construct that holds it ==="; for r in $REVS; do printf "  %-8s occurrences in the file: %s   in a git_note: %s\n" "$r" "$(git show $r:plugins/webster/scripts/drift.py | grep -c "against nothing")" "$($J $r | grep -c "against nothing")"; done; echo "  its one home, at caa2e5c:"; git show caa2e5c:plugins/webster/scripts/drift.py | grep -n -B1 "against nothing" | sed "s/^/    /"; echo; echo "=== D-152  what the four branch notes DID say, at 457658b, joined across their continuations ==="; $J 457658b; for p in "nothing here compared the pages against the code" "the pages have not been compared against the code" "git stopped answering part-way through the check"; do printf "  branch notes containing \"%s\": %s\n" "$p" "$($J 457658b | grep -c -- "$p")"; done; echo; echo "=== D-151  the four wordings of the digest claim, at 66dab76, joined across their continuations ==="; $J 66dab76; for p in "the recorded line digests were