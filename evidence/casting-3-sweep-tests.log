# Cycle-17 sweep: the counts and the baseline tests/test_doctype.py states about
# itself, measured. Run from the repository root.
import ast, re, subprocess, sys

TESTS = "plugins/webster/tests/test_doctype.py"
DOCTYPE = "plugins/webster/scripts/doctype.py"
src = open(TESTS, encoding="utf-8").read()
doc = ast.get_docstring(ast.parse(src))

print("== the index this module keeps of itself ==")
defined = re.findall(r"^def (test_\w+)", src, re.M)
indexed = re.findall(r"^\s+(test_\w+)", doc, re.M)
first, second, third, bucket = [], [], [], 0
for line in doc.splitlines():
    if line.startswith("Six more tests"):
        bucket = 1
    elif line.startswith("One more test"):
        bucket = 2
    m = re.match(r"\s+(test_\w+)", line)
    if m:
        (first, second, third)[bucket].append(m.group(1))
print(f"   test functions defined: {len(defined)}")
print(f"   test names in the three indexes: {len(indexed)}")
print(f"   first index: {len(first)}   second: {len(second)}   third: {len(third)}")
print(f"   controls marked (control): {len(re.findall(r'test_\w+\s+\(control\)', doc))}")
print(f"   indexed but not defined: {sorted(set(indexed) - set(defined)) or 'none'}")
print(f"   defined but not indexed: {sorted(set(defined) - set(indexed)) or 'none'}")
print(f"   skip or xfail decorators: "
      f"{[l.strip() for l in src.splitlines() if l.lstrip().startswith('@') and ('skip' in l or 'xfail' in l)] or 'none'}")

print("\n== the two commits the docstring names as one baseline ==")
for rev in ("2abe081", "cfafe8e"):
    blob = subprocess.run(["git", "rev-parse", f"{rev}:{DOCTYPE}"],
                          capture_output=True, text=True).stdout.strip()
    print(f"   {rev}:{DOCTYPE}  ->  {blob}")

print("\n== what SKELETON does and does not name ==")
sys.argv = ["doctype.py"]
import importlib.util
spec = importlib.util.spec_from_file_location("_doctype", DOCTYPE)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
for tok in ("create_item", "/dashboard", "--verbose"):
    print(f"   {tok:14} appears in SKELETON entries: "
          f"{[k for k, v in mod.SKELETON.items() if tok in v] or 'none'}")
print(f"   how-to skeleton headings: "
      f"{[l for l in mod.SKELETON['how-to'].splitlines() if l.startswith('##')]}")
print(f"   how-to skeleton placeholders: "
      f"{len(re.findall(r'\{[^}]+\}', mod.SKELETON['how-to']))}")
print("   the lines of scaffold.py that write a stub:")
scaffold = open("plugins/webster/scripts/scaffold.py", encoding="utf-8").read()
for n, line in enumerate(scaffold.splitlines(), 1):
    if "not written yet" in line or "skeleton_for(doc_type, audience)" in line \
            or "from doctype import SKELETON" in line:
        print(f"     plugins/webster/scripts/scaffold.py:{n}: {line.strip()}")

print("\n== the survey.py fields load_survey_allow and survey_json claim ==")
survey = open("plugins/webster/scripts/survey.py", encoding="utf-8").read()
for n, line in enumerate(survey.splitlines(), 1):
    if re.search(r'user_surface\["(labels|commands)"\]\.append', line) \
            or 'entry["name"] = name' in line or 'entry = {"path": path' in line:
        print(f"   plugins/webster/scripts/survey.py:{n}: {line.strip()}")

