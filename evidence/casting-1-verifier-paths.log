# evidence-cmd: cd plugins/foundry/mcp-server && python3 -c "import sys; sys.path.insert(0, 'src'); from foundry_mcp.schemas import vocab; B='plugins/foundry/mcp-server/src/foundry_mcp/'; [print(('VERIFIER ' if vocab.is_verifier_path(B+p) else 'ordinary ')+B+p) for p in ('tools/foundry_report.py','tools/foundry_spawn.py','tools/foundry_state.py','tools/display.py','tools/citation.py','tools/validation.py','parsers/spec.py','server.py')]; print(); [print(('VERIFIER ' if vocab.is_verifier_path(p) else 'ordinary ')+repr(p)) for p in ('plugins/foundry/mcp-server/tests/test_vocab.py','plugins/foundry/scripts/measure-run.py','README.md','src/myfoundry_mcp/tools/x.py')]; print(); print('patterns:', len(vocab.VERIFIER_PATH_PATTERNS))"
# evidence-for: FR-032, US-004, GI-007
# evidence-timeout: 120

# D-033 -- VERIFIER_PATH_PATTERNS enumerated five tools/ basenames, so every
# other gate-path module answered False. foundry_report.py carries
# report_status, which IS the DONE precondition; foundry_spawn.py carries
# _manifest_shape_problem, called by foundry_gate. A GRIND diff moving either
# was being judged by a DELTA roster (ST-006).
#
# The rule is now the PACKAGE, so the fix cannot go stale the next time a
# module is added. The second group is the other half of FR-032: the rule
# still has to be able to say no, or DELTA is deleted and every cycle pays for
# a five-stream INSPECT. Tests, offline CLIs and READMEs judge nothing.

VERIFIER plugins/foundry/mcp-server/src/foundry_mcp/tools/foundry_report.py
VERIFIER plugins/foundry/mcp-server/src/foundry_mcp/tools/foundry_spawn.py
VERIFIER plugins/foundry/mcp-server/src/foundry_mcp/tools/foundry_state.py
VERIFIER plugins/foundry/mcp-server/src/foundry_mcp/tools/display.py
VERIFIER plugins/foundry/mcp-server/src/foundry_mcp/tools/citation.py
VERIFIER plugins/foundry/mcp-server/src/foundry_mcp/tools/validation.py
VERIFIER plugins/foundry/mcp-server/src/foundry_mcp/parsers/spec.py
VERIFIER plugins/foundry/mcp-server/src/foundry_mcp/server.py

ordinary 'plugins/foundry/mcp-server/tests/test_vocab.py'
ordinary 'plugins/foundry/scripts/measure-run.py'
ordinary 'README.md'
ordinary 'src/myfoundry_mcp/tools/x.py'

patterns: 6
