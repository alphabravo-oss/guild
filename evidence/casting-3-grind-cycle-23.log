width checklist entry   : %s ok=%s' % (width['check'], width['ok']))\n    print('    Foundry-Phase(inspect_clean): ok=%s   phase after=%s' % (clean.get('ok', False), phase_after))\n    print('    inspect_clean says          : %s' % clean.get('error', '(nothing - it succeeded)'))\n    foundry_state.clear_active_run()\n    print('')\n\ndef fence(label, stamped, state_cycle):\n    r, f = fresh('ev23t')\n    TIM._cycles_recorded_against(f, stamped=stamped, state_cycle=state_cycle, mode='FULL', rule='final_gate')\n    (f / fo._stream_marker('trace')).unlink()\n    d = fo._maybe_skip_trace(f, str(r))\n    print('  %s -> skip=%s   auto-stamped .trace-complete=%s' % (label, d['skip'], (f / fo._stream_marker('trace')).exists()))\n    print('      %s' % d['reason'])\n    foundry_state.clear_active_run()\n''');print('== GI-008 / GI-009: the transition RECORDS the width; every door only READS it ==');print('== D-216: an inspect_modes entry stamped for ANOTHER cycle recorded nothing for THIS one ==');print('');print('-- both doors driven through the MCP CallToolRequest handler, at HEAD --');print('');drive('(a) [FULL@1] with the run at cycle 2 - the driven defect', (1,), 2, 'FULL', 'first_of_phase');drive('(b) [DELTA@1] with the run at cycle 2 - the roster half', (1,), 2, 'DELTA', 'delta');drive('(c) [FULL@1, FULL@3] with the run at cycle 2 - a LATER stamp is no better', (1, 3), 2, 'FULL', 'first_of_phase');drive('(d) [FULL@1, FULL@2] with the run at cycle 2 - the true positive, kept', (1, 2), 2, 'FULL', 'final_gate');print('== the ADJACENT PATH: the same read, a different caller - TRACE D-071 skip fence ==');fence('stale [FULL@1] at cycle 2', (1,), 2);fence('live  [FULL@2] at cycle 2', (2,), 2)"
