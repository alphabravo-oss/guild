# evidence-cmd: sh -c 'cd "$(git rev-parse --show-toplevel)"; d=$(mktemp -d); printf %s "" | base64 -d > "$d/test_interp.py"; echo "--- the module both launches run ---"; cat "$d/test_interp.py"; cd "$d"; echo "--- launch A: uvx pytest ---"; uvx pytest -q -s -p no:cacheprovider test_interp.py 2>&1 | grep -E "^(collector|child|same)"; uv venv --python "$(command -v python3)" .venv >/dev/null 2>&1; VIRTUAL_ENV="$d/.venv" uv pip install --offline pytest >/dev/null 2>&1; echo "--- launch B: python3 -m pytest, through a virtualenv on PATH python3 ---"; PATH="$d/.venv/bin:$PATH" python3 -m pytest -q -s -p no:cacheprovider test_interp.py 2>&1 | grep -E "^(collector|child|same)"; rm -rf "$d"'
# evidence-for: CT-007, FR-029, FR-038, GI-001
# evidence-volatile: \d+\.\d+s
# evidence-timeout: 300
#
# D-154. The README said that under `python3 -m pytest` run_script's child was
# "a different interpreter from pytest's". run_script passes PATH straight through and
# calls the literal python3, and subprocess resolves that name through the PATH in the
# env it was handed, so the child is PATH's python3 -- and under `python3 -m pytest` the
# collector is PATH's python3 too. Both launches measured below, collector sys.executable
# realpath and version against the child's. What varies between the launches is which
# interpreter both of them are, not whether they are the same one.

--- the module both launches run ---
"""Collector vs child interpreter, measured under both launches.

Mirrors conftest.run_script (CT-007, FR-029): the literal "python3", and an
environment of PATH and HOME only, taken from the process pytest runs in.
"""
import os
import subprocess
import sys

BASE_KEYS = ("PATH", "HOME")
PROBE = "import os,sys;print(os.path.realpath(sys.executable));print(sys.version.split()[0])"


def test_collector_and_child_are_one_interpreter():
    env = {k: os.environ[k] for k in BASE_KEYS if k in os.environ}
    child = subprocess.run(
        ["python3", "-c", PROBE],
        capture_output=True, text=True, env=env, timeout=30,
    )
    assert child.returncode == 0, child.stderr
    child_realpath, child_version = child.stdout.split()
    collector_realpath = os.path.realpath(sys.executable)
    collector_version = sys.version.split()[0]
    print("collector_realpath = " + collector_realpath)
    print("collector_version  = " + collector_version)
    print("child_realpath     = " + child_realpath)
    print("child_version      = " + child_version)
    print("same_realpath      = " + str(collector_realpath == child_realpath))
    print("same_version       = " + str(collector_version == child_version))
--- launch A: uvx pytest ---
collector_realpath = /Users/rayjanoka/.local/share/uv/python/cpython-3.11.14-macos-aarch64-none/bin/python3.11
collector_version  = 3.11.14
child_realpath     = /Users/rayjanoka/.local/share/uv/python/cpython-3.11.14-macos-aarch64-none/bin/python3.11
child_version      = 3.11.14
same_realpath      = True
same_version       = True
--- launch B: python3 -m pytest, through a virtualenv on PATH python3 ---
collector_realpath = /opt/homebrew/Cellar/python@3.14/3.14.6/Frameworks/Python.framework/Versions/3.14/bin/python3.14
collector_version  = 3.14.6
child_realpath     = /opt/homebrew/Cellar/python@3.14/3.14.6/Frameworks/Python.framework/Versions/3.14/bin/python3.14
child_version      = 3.14.6
same_realpath      = True
same_version       = True
