# evidence-cmd: R=$(git rev-parse --show-toplevel); W=$(mktemp -d); cp -R "$R/plugins/webster/." "$W"; cd "$W" || exit 1; cp README.md README.new; cp tests/test_readme.py guard.new; git -C "$R" show 60122da:plugins/webster/README.md > README.old; git -C "$R" show 60122da:plugins/webster/tests/test_readme.py > guard.old; cp scripts/llmstxt.py llmstxt.new; verdict() { cp "$2" README.md; cp "$3" tests/test_readme.py; cp llmstxt.new scripts/llmstxt.py; [ -n "$4" ] && python3 -c "$4"; if uvx pytest -q -p no:cacheprovider "tests/test_readme.py::$5" >/dev/null 2>&1; then echo "$1: PASS"; else echo "$1: FAIL"; fi; }; INV='import pathlib; p=pathlib.Path("README.md"); t=p.read_text(); a="skipped heading levels) exit 1,"; b="stubs either — exits 2."; assert a in t and b in t, "doctype row not found"; p.write_text(t.replace(a, "skipped heading levels) exit 2,").replace(b, "stubs either — exits 1."))'; MUTE='import pathlib; p=pathlib.Path("scripts/llmstxt.py"); t=p.read_text(); a=t.index("The written file is what exit 0"); b=t.index("file claiming a product has no documentation.") + len("file claiming a product has no documentation."); p.write_text(t[:a] + "Prints the tree it found." + t[b:])'; echo "case | guard | README + script | verdict"; verdict "1 committed guard, table as committed             " README.new guard.new "" test_the_script_table_puts_each_status_under_its_scripts_exit_code; verdict "2 committed guard, doctype row exit codes inverted" README.new guard.new "$INV" test_the_script_table_puts_each_status_under_its_scripts_exit_code; verdict "3 guard at 60122da, doctype row exit codes inverted" README.old guard.old "$INV" test_the_script_table_puts_each_status_under_its_scripts_exit_code; verdict "4 committed guard, llmstxt row and docstring silent" README.old guard.new "$MUTE" test_the_script_table_publishes_each_scripts_own_exit_set; verdict "5 guard at 60122da, llmstxt row and docstring silent" README.old guard.old "$MUTE" test_the_script_table_publishes_each_scripts_own_exit_set; rm -rf "$W"
# evidence-for: FR-038, AC-042, US-010

case | guard | README + script | verdict
1 committed guard, table as committed             : PASS
2 committed guard, doctype row exit codes inverted: FAIL
3 guard at 60122da, doctype row exit codes inverted: PASS
4 committed guard, llmstxt row and docstring silent: FAIL
