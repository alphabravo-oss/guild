== the script this log runs ==
# D-161. Which rule, if any, owns an ALL-CAPS backticked token on a user page.
# Run from the repository root. Every tree is built here, so nothing depends on
# the working copy's docs/.
import os, re, subprocess, tempfile, pathlib

DOCTYPE = "plugins/webster/scripts/doctype.py"
FM = "---\ntitle: Guide\ndoc_type: how-to\naudience: user\n---\n\n# Guide\n\n"
CASES = [
    ("backticked SHA256", "Every download is published with a `SHA256` next to it.\n"),
    ("bare SHA256", "Every download is published with a SHA256 next to it.\n"),
    ("backticked DATABASE_URL, nothing calls it a variable",
     "The receipt prints `DATABASE_URL` and nothing else names it.\n"),
    ("backticked DATABASE_URL, the page calls it a variable",
     "Set the environment variable `DATABASE_URL` before you start.\n"),
]

def check(body):
    d = tempfile.mkdtemp()
    pathlib.Path(d, "guide.md").write_text(FM + body, encoding="utf-8")
    env = {k: v for k, v in os.environ.items() if not k.startswith("WEBSTER_")}
    env["WEBSTER_SHOW_PER_RULE"] = "50"
    r = subprocess.run(["python3", DOCTYPE, "check", d],
                       capture_output=True, text=True, env=env)
    return r

print("== one user page per case, each in its own tree ==")
for name, body in CASES:
    r = check(body)
    rules = sorted(set(re.findall(r"^  ([a-z-]+)  \(\d+\)$", r.stdout, re.M)))
    print(f"\n-- {name} --")
    print(f"   prose: {body.strip()}")
    print(f"   rules that fired: {rules or ['none']}   exit {r.returncode}")
    for line in r.stdout.splitlines():
        if "  " in line and ("guide.md" in line):
            print(f"   {line.strip()}")

print("\n== the branches, with the lookahead and without it ==")
src = open(DOCTYPE, encoding="utf-8").read()
ns = {"re": re}
for name in ("_CAP_RUN", "_HAS_LOWER"):
    ns[name] = eval(re.search(rf"^{name} = (.+)$", src, re.M).group(1), {}, ns)
body = re.search(r"^CODE_IDENT = re\.compile\((.*?)\)\n(?=[^ ])", src, re.M | re.S).group(1)
CODE_IDENT = eval("re.compile(" + body + ")", {"re": re}, ns)
NO_LOOKAHEAD = eval("re.compile(" + body.replace("{_HAS_LOWER}", "") + ")", {"re": re}, ns)
ENV_VAR = eval(re.search(r"^ENV_VAR = (re\.compile\(.+\))$", src, re.M).group(1), {"re": re})
print(f"{'token':16} {'CODE_IDENT':11} {'no lookahead':13} {'ENV_VAR':8}")
for t in ("DATABASE_URL", "XML", "SHA256", "MD5", "EC2", "UTF8", "HTTP2",
          "S3Bucket", "APIClient", "my_config.yaml", "/etc/hosts"):
    s = f"`{t}`"
    print(f"{t:16} {str(bool(CODE_IDENT.search(s))):11} "
          f"{str(bool(NO_LOOKAHEAD.search(s))):13} {str(bool(ENV_VAR.search(s))):8}")

print("\n== check_jargon deletes backticked spans before ACRONYM runs ==")
for n, line in enumerate(src.splitlines(), 1):
    if "re.sub(r\"`[^`]*`" in line and "\\*\\*" in line:
        print(f"  {DOCTYPE}:{n}: {line.strip()}")
ACRONYM = eval(re.search(r"^ACRONYM = (re\.compile\(.+\))$", src, re.M).group(1), {"re": re})
strip = re.compile(r"`[^`]*`|\*\*[^*]*\*\*|\[[^\]]*\]\([^)]*\)")
for prose in ("a `SHA256` sum", "a SHA256 sum"):
    print(f"  {prose!r:20} -> after the strip: {strip.sub('', prose)!r:20} "
          f"ACRONYM finds {ACRONYM.findall(strip.sub('', prose))}")

# Pinned to 18e06c9, the cycle-17 baseline, so the walk does not grow a row for
# the commit that carries this log.
print("\n== every revision of doctype.py through 18e06c9, against `SHA256` and `APIClient` ==")
revs = subprocess.run(["git", "log", "--format=%h", "--reverse", "18e06c9", "--",
                       DOCTYPE], capture_output=True, text=True).stdout.split()
for rev in revs:
    text = subprocess.run(["git", "show", f"{rev}:{DOCTYPE}"],
                          capture_output=True, text=True).stdout
    ns = {"re": re}
    for name in ("_CAP_RUN", "_HAS_LOWER"):
        m = re.search(rf"^{name} = (.+)$", text, re.M)
        if m:
            ns[name] = eval(m.group(1), {}, ns)
    m = re.search(r"^CODE_IDENT = re\.compile\((.*?)\)\n(?=[^ ])", text, re.M | re.S)
    if m is None:
        print(f"  {rev}  no CODE_IDENT in this revision")
        continue
    ci = eval("re.compile(" + m.group(1) + ")", {"re": re}, ns)
    print(f"  {rev}  lookahead={('_HAS_LOWER' in ns)!s:5}  "
          f"`SHA256` reported={bool(ci.search('`SHA256`'))!s:5}  "
          f"`APIClient` reported={bool(ci.search('`APIClient`'))!s:5}")

