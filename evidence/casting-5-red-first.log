# evidence-cmd: bash -c 'set -u; repo=$(pwd); tmp=$(mktemp -d); cd "$tmp"; git -C "$repo" show 2abe081:plugins/webster/scripts/slop.py > slop-old.py; git -C "$repo" show 2abe081:plugins/webster/scripts/scaffold.py > scaffold-old.py; cp "$repo/plugins/webster/scripts/slop.py" slop-new.py; cp "$repo/plugins/webster/scripts/scaffold.py" scaffold-new.py; printf "%s\n" "# Rollout notes" "" "The exporter is robust." "Teams leverage the queue." "Reviews elevate the draft." "Editors empower reviewers." > weak.md; printf "%s\n" "# Release notes" "" "Co-Authored-By: Jane <jane@example.com>" > human.md; printf "%s\n" "## Done ✓" "" "## Shipped ✔" "" "## Next ➜" "" "## Upgrade ⬆" > marks.md; printf "%s\n" "## Star ⭐" > star.md; for v in old new; do for f in weak.md human.md marks.md star.md; do python3 "slop-$v.py" "$f" > /dev/null 2>&1; echo "$v slop.py $f: exit=$?"; done; python3 "slop-$v.py" /no/such/dir > /dev/null 2>&1; echo "$v slop.py /no/such/dir: exit=$?"; mkdir "docs-$v"; python3 "scaffold-$v.py" init --docs "docs-$v" --subject "Bad Key:Label" > /dev/null 2>&1; echo "$v scaffold.py init bad key: exit=$?, files written=$(find docs-$v -type f | wc -l | tr -d " ")"; done; cd "$repo"; rm -rf "$tmp"'
# evidence-for: US-010, FR-039, AC-039
# evidence-timeout: 300

old slop.py weak.md: exit=1
old slop.py human.md: exit=1
old slop.py marks.md: exit=1
old slop.py star.md: exit=0
old slop.py /no/such/dir: exit=0
old scaffold.py init bad key: exit=1, files written=7
new slop.py weak.md: exit=0
new slop.py human.md: exit=0
new slop.py marks.md: exit=0
new slop.py star.md: exit=1
new slop.py /no/such/dir: exit=2
new scaffold.py init bad key: exit=2, files written=0
