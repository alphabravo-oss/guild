# evidence-cmd: cd plugins/foundry/mcp-server && P=$(pwd) && T=$(mktemp -d) && trap 'find "$T" -delete' EXIT && cp -R src tests pyproject.toml "$T/" && G=src/foundry_mcp/tools/orchestration/guidance.py && N=tests/orchestration/test_guidance_imperatives.py && cd "$T" && for m in committed team-arm f3-live-arm acceptance-reader notice-gate streams-branch in-flight-unmeasured refusal-one-branch streams-context refusal-boundary casting-slot-last casting-slot-order condition-detector in-flight-redispatch one-scan refusal-own-team respawn-protocol context-structure refusal-vocabulary condition-structure; do cp "$P/$G" "$G"; cp "$P/$N" "$N"; F=$(python3 -c 'import sys; m, g, n = sys.argv[1:4]; R = {"team-arm": (g, "and not _team_work_in_flight(", "and not (lambda *a, **k: False)("), "f3-live-arm": (g, "if open_count > 0 or grind_live:", "if open_count > 0:"), "acceptance-reader": (g, "if done_at is not None:", "if False:"), "notice-gate": (g, "told_to_wait = (", "told_to_wait = True or ("), "streams-branch": (g, "_BRANCH_OPEN + \"live\" + _BRANCH_CLOSE + _STREAMS_RUNNING", "\"\""), "in-flight-unmeasured": (g, "or pending < 1:\n        return True", "or pending < 1:\n        return False"), "refusal-one-branch": (g, "else \"redispatch\"\n        )", "else \"refused\"\n        )"), "streams-context": (g, "not the live tree.\"\n                    + _BRANCHED_ACTION_CONTEXT", "not the live tree. Spawn agents using the agent_configs below.\""), "refusal-boundary": (g, "refused_at >= finished_at", "refused_at > finished_at"), "casting-slot-last": (g, "return ids[0]", "return ids[-1]"), "casting-slot-order": (g, "for key in (\"cast_refused\", \"cast_unaccepted\"):", "for key in (\"cast_unaccepted\", \"cast_refused\"):"), "condition-detector": (n, "(?:if|unless|when|whenever|only|once|in case|should|whether|depending)", "(?:NEVERMATCHES)"), "in-flight-redispatch": (g, "(\"refused\", \"redispatch\", \"unaccepted\")", "(\"refused\", \"unaccepted\")"), "one-scan": (g, "_waiting_on_agents(project_root, teams=teams)", "_waiting_on_agents(project_root)"), "refusal-own-team": (g, "if isinstance(own, str) and isinstance(registered, list)\n            and own in registered", "if row.get(\"teams_active\") is True"), "respawn-protocol": (g, "\"and then, BELOW it and LAST, step (1)", "\"with nothing appended, and not step (1)"), "context-structure": (n, "if lowered in _CLAUSE_OPENERS:", "if True:"), "refusal-vocabulary": (n, "r\"|refused|refuses|rejected|rejects|errors|errored|ok (?:False|True)\"\n", ""), "condition-structure": (n, "_EARLIER_CALL = r\"", "_EARLIER_CALL = r\"NEVERMATCHES")}; f, old, new = R.get(m, (g, "", "")); s = open(f, encoding="utf-8").read(); assert m == "committed" or s.count(old) == 1, m; open(f, "w", encoding="utf-8").write(s.replace(old, new) if old else s); print(f)' "$m" "$G" "$N"); echo "== revert: $m"; echo "  $(basename "$F") lines differing from the committed file: $(diff "$P/$F" "$F" | grep -c '^>')"; uv run --project "$P" --with pytest pytest -p no:cacheprovider --no-header --color=no --tb=no -q -rf "$N" 2>/dev/null | awk '$1=="FAILED"{f++; n=$2; sub(/.*::/, "", n); print "  FAILED " n; next} $1=="ERROR"{e++; n=$2; sub(/.*::/, "", n); print "  ERROR " n; next} {s=$0; gsub(/,/, " ", s); k=split(s, w, " "); for(i=2;i<=k;i++) if(w[i]=="passed") p=w[i-1]+0} END{printf "  tests run: %d, failed: %d, errors: %d\n", p+f+e, f+0, e+0}'; done
