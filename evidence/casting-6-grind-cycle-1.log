ired"])); print(); print("== D-005 / D-010: the Foundry-Fix boundary claim, driven =="); print("  additionalProperties occurrences in server.py:", raw("plugins/foundry/mcp-server/src/foundry_mcp/server.py").count("additionalProperties")); fx=[t for t in asyncio.run(srv.list_tools()) if t.name=="Foundry-Fix"][0]; print("  Foundry-Fix inputSchema closes its property set:", "additionalProperties" in fx.inputSchema); inst={"defect_id":"D-1","cycle":1,"authored_by":"teammate","regression_test":"tests/t.py::test_x","failing_then_passing_account":"failed at abc, passes at def"}; print("  undeclared argument at that boundary:", (lambda: [jsonschema.validate(instance=inst,schema=fx.inputSchema),"ACCEPTED -- so it is dropped by dispatch, never refused"][1])()); tm=flat("plugins/foundry/agents/teammate.md"); print("  teammate.md still claims a boundary rejection:", "rejected at the MCP boundary" in tm); print("  teammate.md states the argument is DROPPED:", "it is DROPPED" in tm); print(); print("== D-006 / GI-001 / FR-030: no stream document ranks defects on the abolished axis =="); USES=("same severity as","high severity","higher severity","low severity","lower severity","more severe","less severe"); [print("  %-24s approving-uses=%s" % (p.split("/")[-2]+"/"+p.split("/")[-1], [u for u in USES if u in flat(p)] or "none")) for p in AG+SK]; print(); print("== D-008 / D-009: the rewritten sentences the pins now hold =="); P=[("prove FAIL bullet, LATENT clause",SK[0],"and no `LATENT` exemption either, because `tier` records the evidence behind a defect and never whether it is worth fixing"),("trace Step 2, evidence axis",SK[1],"The evidence axis is separate again "+chr(8212)+" a PL-N flow you actually drove and watched fail is `LIVE`, one you derived from the wiring with no reachable path is `LATENT` and carries a `reproduction_attempted` statement "+chr(8212)+" and neither tier is a grade on how much the fix is worth."),("tracer Level 4, MISPLACED",AG[1],"**MISPLACED is a defect