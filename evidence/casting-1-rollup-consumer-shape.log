# evidence-cmd: sh -c 'D=$(mktemp -d); cp -R plugins/foundry/mcp-server/tests/fixtures/migrate_archive/pre_change "$D/run"; uv run --quiet --project plugins/foundry/mcp-server python plugins/foundry/scripts/migrate-archive.py "$D/run" > /dev/null; echo "=== stream-rollup.json as migration now writes it ==="; cat "$D/run/stream-rollup.json"; echo "=== read back through the REAL consumer, foundry_orchestrator._rollup_totals ==="; uv run --quiet --project plugins/foundry/mcp-server python -c "import sys; sys.path.insert(0, \"plugins/foundry/mcp-server/src\"); from pathlib import Path; from foundry_mcp.tools.foundry_orchestrator import _rollup_totals; run = Path(sys.argv[1]); [print(\"_rollup_totals(cycle=%d, %r) -> %s\" % (c, s, _rollup_totals(run, c, s))) for c, s in ((0, \"trace\"), (0, \"prove\"), (2, \"test01\"), (6, \"prove\"), (2, \"trace\"))]" "$D/run"; rm -rf "$D"'
# evidence-for: FR-021, AC-026, FR-014
# evidence-timeout: 120
#
# D-029 — the migrated stream-rollup.json must be the shape its CONSUMER
# reads. foundry_orchestrator._rollup_totals looks an entry up as
# cycles[str(cycle)][<lowercase wire id>] and requires a dict carrying
# items_checked / items_total / findings / records. v1 wrote
# cycles[c][<CANONICAL>] = <int>, so every lookup returned None and the
# artifact fed nothing. Below, the real consumer is imported and called.
#
# Note cycle 0 'trace': the ledger holds 1 defect but the .trace-complete
# marker reports 3 findings, and the entry carries the marker's higher
# number. Any entry written at the marker's cycle SHADOWS the
# '_rollup_totals(...) or _marker_counts(...)' fallback, so taking the max
# keeps the migrated entry at least as strict as the fallback it replaces.
# Cycle 2 'trace' — which the archive proves nothing about — still reads
# None, leaving that fallback intact.

