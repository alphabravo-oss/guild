r = run(SLOP, os.path.join(tmp, "empty-but-there"))
os.makedirs(os.path.join(tmp, "empty-but-there"), exist_ok=True)
r = run(SLOP, os.path.join(tmp, "empty-but-there"))
print(f"     a directory with no page in it: exit {r.returncode}  {r.stdout.strip()!r}")

