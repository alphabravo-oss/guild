# Cycle-17 sweep: every sentence in scripts/slop.py that no cycle since 9 had rewritten,
# measured. Run from the repository root. Five failed and are corrected here; the rest held.
import importlib.util, os, re, shutil, subprocess, sys, tempfile, unicodedata

SLOP = "plugins/webster/scripts/slop.py"
src = open(SLOP, encoding="utf-8").read()


def load():
    sys.argv = ["slop.py", "docs"]
    spec = importlib.util.spec_from_file_location("slopmod", SLOP)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def sentence(needle, lines=1):
    for i, line in enumerate(src.splitlines(), 1):
        if needle in line:
            return "\n".join(f"     {SLOP}:{i + k}  {l}"
                             for k, l in enumerate(src.splitlines()[i - 1:i - 1 + lines]))
    return "     NOT FOUND: " + needle


def run(script, *args, cwd=None):
    return subprocess.run(["python3", script, *[str(a) for a in args]],
                          capture_output=True, text=True, cwd=cwd)


def unlistable(under):
    """A directory a walk can name and cannot scan, for root as well: over PATH_MAX."""
    limit = os.pathconf(under, "PC_PATH_MAX")
    name = "d" * os.pathconf(under, "PC_NAME_MAX")
    path, fd = under, os.open(under, os.O_RDONLY)
    try:
        while len(os.path.join(path, name)) < limit:
            os.mkdir(name, dir_fd=fd)
            deeper = os.open(name, os.O_RDONLY, dir_fd=fd)
            os.close(fd)
            fd, path = deeper, os.path.join(path, name)
        os.mkdir(name, dir_fd=fd)
        inside = os.open(name, os.O_RDONLY, dir_fd=fd)
        try:
            page = os.open("p.md", os.O_WRONLY | os.O_CREAT, 0o644, dir_fd=inside)
            os.write(page, b"# Heading\n\nordinary prose\n")
            os.close(page)
        finally:
            os.close(inside)
    finally:
        os.close(fd)


m = load()
pats = {rid: pat for rid, sev, pat, why in m.RULES}

print("== corrected: CASE_SENSITIVE skips re.I, and for two of the six that decides nothing ==")
print(sentence("# id, severity, pattern, why.", 2))
print(f"   CASE_SENSITIVE holds {len(m.CASE_SENSITIVE)}: {sorted(m.CASE_SENSITIVE)}")
for rid in sorted(m.CASE_SENSITIVE):
    cased = sorted({c for c in pats[rid] if c.lower() != c.upper()})
    print(f"     {rid:24s} cased characters in the pattern: {len(cased):2d}")
print("   exhaustive, every code point Python can hold, as the last character of a heading")
print("   and of a bullet: how many are judged differently with re.I on?")
for rid, tmpl in (("emoji-heading", "## Done {}"), ("emoji-bullet", "- {}")):
    pat = pats[rid]
    diff = sum(bool(re.search(pat, tmpl.format(chr(cp)), 0))
               != bool(re.search(pat, tmpl.format(chr(cp)), re.I))
               for cp in range(0x110000) if not 0xD800 <= cp <= 0xDFFF)
    print(f"     {rid:24s} {diff} of 1112064")
print("   the other four, where the flag does decide:")
for rid, line in (("title-case-heading", "# the queue drains in order"),
                  ("agent-attribution", "generated by claude"),
                  ("conversation-artifact", "certainly, here is the file"),
                  ("placeholder-name", "acme corp ships it")):
    print(f"     {rid:24s} {line!r:32s} without re.I "
          f"{bool(re.search(pats[rid], line, 0))}, with re.I {bool(re.search(pats[rid], line, re.I))}")

print("\n== corrected: the Co-Authored-By branch wants a name within sixty characters, not a line ==")
print(sentence("# The trailer branch used to be", 3))
for gap in (0, 59, 60, 61, 120):
    line = "Co-Authored-By:" + " " * gap + "Claude <c@example.com>"
    print(f"     {gap:3d} characters between the colon and the name -> agent-attribution fires: "
          f"{bool(re.search(pats['agent-attribution'], line, 0))}")

print("\n== corrected: main() prints the file count on one line and no other ==")
print(sentence("    len() of this list as the number", 2))
for i, line in enumerate(src.splitlines(), 1):
    if "print(" in line and not line.strip().startswith("#"):
        print(f"     {SLOP}:{i}  {line.strip()}")
tmp = tempfile.mkdtemp()
docs = os.path.join(tmp, "docs")
os.makedirs(docs)
open(os.path.join(docs, "clean.md"), "w").write("# Release notes\n\nThe queue drains in order.\n")
r = run(SLOP, os.path.join(docs, "clean.md"))
print(f"     one clean page:            exit {r.returncode}  {r.stdout.strip()!r}")
open(os.path.join(docs, "dirty.md"), "w").write("# Shipped\n\nThis release will supercharge it.\n")
r = run(SLOP, docs)
print(f"     the same tree, one finding: exit {r.returncode}  "
      f"last line {r.stdout.strip().splitlines()[-1]!r}")
print(f"     does that run name a file count anywhere? "
      f"{'yes' if 'files' in r.stdout else 'no'}")

print("\n== corrected: the dangling symlink and the unlistable directory are opposite mistakes ==")
print(sentence("    # Being there and being readable", 6))
old = os.path.join(tmp, "slop-cfafe8e.py")
open(old, "w").write(subprocess.run(["git", "show", f"cfafe8e:{SLOP}"],
                                    capture_output=True, text=True).stdout)
link_tree = os.path.join(tmp, "linked")
os.makedirs(link_tree)
open(os.path.join(link_tree, "real.md"), "w").write("# Release notes\n\nIt drains in order.\n")
os.symlink("nowhere.md", os.path.join(link_tree, "broken.md"))
walk_tree = os.path.join(tmp, "unlistable")
os.makedirs(walk_tree)
unlistable(walk_tree)
for label, script in (("cfafe8e", old), ("this commit", SLOP)):
    for what, tree in (("a page that is a dangling symlink", link_tree),
                       ("a directory nothing can list  ", walk_tree)):
        r = run(script, tree)
        first = (r.stdout.strip().splitlines() or [""])[0]
        first = re.sub(r"d{40,}", "<over PATH_MAX>", first.replace(tmp, "<tmp>"))
        print(f"     {label:11s} {what}  exit {r.returncode}  "
              f"traceback: {'yes' if 'Traceback' in r.stderr else 'no '}  {first!r}")

print("\n== corrected: the tricolon rule counts three words, not three adjectives ==")
print(sentence("            # tricolon:", 1))
tri = re.search(r'if not in_fence and re\.search\(r"([^"]+)"', src).group(1)
print(f"     the pattern: {tri!r}")
for what, line in (("three adjectives", "It is fast, small and quiet."),
                   ("three nouns     ", "We ship apples, oranges and pears."),
                   ("three verbs     ", "It reads, parses and prints."),
                   ("three numbers   ", "Positions 1, 2 and 3."),
                   ("no full stop    ", "fast, small and quiet is the aim")):
    print(f"     {what}  {line!r:38s} matches: {bool(re.search(tri, line))}")

print("\n== held: the BMP class is 33 entries over 60 code points, and bare marks stay out ==")
cls, i, ents, cps = m.EMOJI_PRESENTATION_BMP, 0, [], 0
while i < len(cls):
    if i + 2 < len(cls) and cls[i + 1] == "-":
        ents.append((cls[i], cls[i + 2])); cps += ord(cls[i + 2]) - ord(cls[i]) + 1; i += 3
    else:
        ents.append((cls[i], cls[i])); cps += 1; i += 1
print(f"     class entries: {len(ents)}   code points they cover: {cps}")
print(f"     the class this replaced, read off cfafe8e:")
for line in subprocess.run(["git", "show", f"cfafe8e:{SLOP}"], capture_output=True,
                           text=True).stdout.splitlines():
    if line.strip().startswith(('("emoji-heading"', '("emoji-bullet"')):
        print(f"       {line.strip()}")
for ch in "✓✔➜⬆✅⭐\U0001f680\U0001f700":
    cp = ord(ch)
    print(f"     U+{cp:04X} {unicodedata.name(ch):38s} in U+2600-U+27BF: {0x2600 <= cp <= 0x27BF!s:5} "
          f"in the new BMP class: {any(ord(a) <= cp <= ord(b) for a, b in ents)!s:5} "
          f"in U+1F300-U+1FAFF: {0x1F300 <= cp <= 0x1FAFF}")

print("\n== held: of the six siblings, four take a docs path and answer a missing one with 2 ==")
print(sentence("    # A target that is not there walks to nothing", 8))
gone = os.path.join(tmp, "not-there")
calls = [("drift.py", ["check", gone], None), ("doctype.py", ["check", gone], None),
         ("llmstxt.py", [], {"WEBSTER_ROOT": gone}), ("scaffold.py", ["check", "--docs", gone], None),
         ("rendered.py", ["check", gone], None), ("survey.py", [gone], None), ("slop.py", [gone], None)]
for name, args, extra in calls:
