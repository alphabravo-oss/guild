# evidence-timeout: 120
#
# D-158. tests/test_readme.py said GI-004 barred the import and that "for five of the
# seven scripts there would be no other way in anyway". The first half is a rule and
# stands; the second was a claim about Python and is false. Block [0] counts the five
# binders out of the seven by AST rather than by memory. Block [1] measures what an
# import actually costs -- under pytest own argv drift.py binds its docs directory to
# the string "-v", and the cached module keeps it after this process has chdir(2)ed
# away. Block [2] measures the retraction: runpy.run_path re-executes the module body
# and re-binds every one of the five. Block [3] drives drift.py check to a real JSON
# line at exit 2 in this process, against the tree the re-execution bound -- status
# no_manifest, where the frozen import would have answered no_docs. conftest.py and
# README.md had already retracted the same overstatement; this was the last copy.

--- the program these blocks are the output of ---
"""D-158. What an import of a webster script binds, and what runpy does instead.

Run from the repository root. The comment above ``SCRIPTS`` in
plugins/webster/tests/test_readme.py is written off these four blocks.
"""
import ast
import contextlib
import importlib.util
import io
import json
import os
import runpy
import sys
import tempfile

SCRIPTS = os.path.abspath("plugins/webster/scripts")
SEVEN = ["doctype.py", "drift.py", "llmstxt.py", "rendered.py",
         "scaffold.py", "slop.py", "survey.py"]

print("[0] which of the seven bind out of argv or the environment at module level")
print("    (a top-level assignment whose value reads sys.argv, os.environ or os.getenv)")
binders = []
for name in SEVEN:
    path = os.path.join(SCRIPTS, name)
    src = open(path, encoding="utf-8").read()
    found = []
    for node in ast.parse(src).body:
        if not isinstance(node, (ast.Assign, ast.AnnAssign)):
            continue
        seg = ast.get_source_segment(src, node) or ""
        if not any(k in seg for k in ("sys.argv", "os.environ", "os.getenv")):
            continue
        targets = node.targets if isinstance(node, ast.Assign) else [node.target]
        for target in targets:
            if isinstance(target, ast.Name):
                found.append(target.id)
    if found:
        binders.append(name)
    print("    %-13s %s" % (name, ", ".join(found) or "none"))
print("    binders = %d of %d: %s" % (len(binders), len(SEVEN), ", ".join(binders)))

A = tempfile.mkdtemp(prefix="webster-A-")
B = tempfile.mkdtemp(prefix="webster-B-")
os.makedirs(os.path.join(B, "docs"))
with open(os.path.join(B, "docs", "index.md"), "w", encoding="utf-8") as fh:
    fh.write("---\ndoc_type: overview\naudience: user\n---\n\n# Index\n\nA page.\n")
REAL = {os.path.realpath(A): "A", os.path.realpath(B): "B"}


def where(value):
    """A tmpdir path as A or B, so the log carries no volatile path."""
    return REAL.get(os.path.realpath(str(value)), repr(value))


print()
print("[1] what an import binds, and what that costs")
os.chdir(A)
sys.argv = ["pytest", "tests/test_readme.py", "-v"]
print("    cwd = A; sys.argv = %r" % (sys.argv,))
spec = importlib.util.spec_from_file_location("drift_imported", os.path.join(SCRIPTS, "drift.py"))
drift = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = drift
spec.loader.exec_module(drift)
first_root, first_docs_arg = drift.ROOT, drift._DOCS_ARG
print("      drift.ROOT                                  -> %s" % where(first_root))
print("      drift._DOCS_ARG                             -> %r   (sys.argv[2])" % first_docs_arg)
print("      drift.DOCS basename                         -> %r" % os.path.basename(drift.DOCS))
os.chdir(B)
sys.argv = ["pytest", "tests/test_drift.py", "site"]
print("    cwd = B; sys.argv = %r; ask for the module again" % (sys.argv,))
print("      the cached module object comes back         -> %s" % (sys.modules["drift_imported"] is drift))
print("      ROOT still names the first cwd              -> %s" % (drift.ROOT == first_root))
print("      _DOCS_ARG still the first argv[2]           -> %s" % (drift._DOCS_ARG == first_docs_arg))

print()
print("[2] frozen is not sealed: runpy.run_path re-executes the body and re-binds")


def rebind(script, name, cwd, argv, env):
    for key in ("WEBSTER_ROOT", "WEBSTER_DOCS", "WEBSTER_BASE_URL",
                "WEBSTER_LENS_ALLOW", "WEBSTER_SURVEY"):
        os.environ.pop(key, None)
    os.environ.update(env)
    os.chdir(cwd)
    sys.argv = argv
    with contextlib.redirect_stdout(io.StringIO()):
        globs = runpy.run_path(os.path.join(SCRIPTS, script))
    return globs[name]


CASES = [
    ("drift.py", "ROOT", where, "cwd",
     (A, ["drift.py", "check"], {}), (B, ["drift.py", "check"], {})),
    ("llmstxt.py", "ROOT", where, "env",
     (A, ["llmstxt.py"], {"WEBSTER_ROOT": A}), (B, ["llmstxt.py"], {"WEBSTER_ROOT": B})),
    ("doctype.py", "LENS_ALLOW", lambda v: repr(sorted(v)), "env",
     (A, ["doctype.py"], {"WEBSTER_LENS_ALLOW": "alpha, beta"}),
     (A, ["doctype.py"], {"WEBSTER_LENS_ALLOW": "gamma"})),
    ("survey.py", "ROOT", where, "argv",
     (A, ["survey.py", A], {}), (A, ["survey.py", B], {})),
    ("slop.py", "TARGETS", repr, "argv",
     (A, ["slop.py"], {}), (A, ["slop.py", "README.md", "notes"], {})),
]
ROW = "    %-12s %-11s %-7s %-24s %-24s %s"
print(ROW % ("script", "global", "driven", "first run", "second run", "re-bound"))
for script, name, show, driven, one, two in CASES:
    first = show(rebind(script, name, *one))
    second = show(rebind(script, name, *two))
    print(ROW % (script, name, driven, first, second, first != second))

print()
print("[3] the same mechanism drives a real run, in this process")
os.chdir(B)
sys.argv = ["drift.py", "check"]
for key in ("WEBSTER_ROOT", "WEBSTER_DOCS"):
    os.environ.pop(key, None)
buf = io.StringIO()
code = None
try:
    with contextlib.redirect_stdout(buf):
        runpy.run_path(os.path.join(SCRIPTS, "drift.py"), run_name="__main__")
except SystemExit as exc:
    code = exc.code
out = buf.getvalue().strip()
parsed = json.loads(out)
print("    A holds no docs/ at all; B holds docs/ with one page and no manifest")
print("    runpy.run_path(drift.py, run_name=\"__main__\"), sys.argv = %r" % (sys.argv,))
print("      SystemExit code                           -> %r" % code)
print("      stdout parses as JSON                     -> %s" % out.startswith("{"))
print("      status                                    -> %r" % parsed["status"])
print("      docs_dir sits under                       -> %s" % where(os.path.dirname(parsed["docs_dir"])))
print("      (the frozen import would have answered 'no_docs', from A)")

