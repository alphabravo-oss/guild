# evidence-cmd: sh -c 'D=$(mktemp -d); cp -R plugins/foundry/mcp-server/tests/fixtures/migrate_archive/pre_change "$D/run"; echo "=== the PRE-FIX reader: d.get(\"stream\") against an UPPERCASE roster ==="; python3 -c "import json,sys,collections; recs=json.load(open(sys.argv[1]))[\"defects\"]; roster={\"TRACE\",\"FLOW_TRACE\",\"PROVE\",\"RESEARCH_AUDIT\",\"COVERAGE_DIFF\",\"TEST-01\",\"SIGHT\",\"TEST\",\"EVID-01\",\"EVID-02\",\"INTV-01\",\"TYPE-01\",\"TYPE-02\",\"PROBE-01\",\"INTENT-01\"}; vals=[d.get(\"stream\") for d in recs]; toks=[(\"PHASE9_DEFECTS_FILE_MALFORMED\" if not isinstance(v,str) else (\"PHASE9_UNKNOWN_STREAM:\"+v if v not in roster else \"\")) for v in vals]; print(\"per_stream_defects:\", dict(collections.Counter(v for v in vals if isinstance(v,str) and v in roster))); print(\"failure_tokens:\", len([t for t in toks if t]), \"x\", sorted({t for t in toks if t}))" "$D/run/defects.json"; echo; echo "=== what measure-run.py produces NOW (FR-018 / AC-024) ==="; python3 plugins/foundry/scripts/measure-run.py "$D/run" > "$D/a.json"; python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(\"per_stream_defects:\", json.dumps(d[\"per_stream_defects\"], sort_keys=True)); print(\"cycles:\", d[\"cycles\"]); print(\"failure_tokens:\", d[\"failure_tokens\"])" "$D/a.json"; echo; echo "=== after migrate-archive.py repairs the recorded cycle ==="; python3 plugins/foundry/scripts/migrate-archive.py "$D/run" > /dev/null; python3 plugins/foundry/scripts/measure-run.py "$D/run" > "$D/b.json"; python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(\"per_stream_defects:\", json.dumps(d[\"per_stream_defects\"], sort_keys=True)); print(\"cycles:\", d[\"cycles\"]); print(\"failure_tokens:\", d[\"failure_tokens\"])" "$D/b.json"; rm -rf "$D"'
# evidence-for: FR-018, AC-024
# evidence-timeout: 120
#
# FR-018 has two halves and this shows both. The first block replays the
# PRE-FIX reader (d.get("stream") against the UPPERCASE roster) on the same
# archive: an empty map plus one PHASE9_DEFECTS_FILE_MALFORMED per record —
# on grand-vulture that was 168 of them. The second block is the shipped
# reader: real per-stream counts, keyed by canonical id, from the lowercase
# `source` key every writer actually persists. The third shows the cycle
# count going 1 -> 7 once migrate-archive.py repairs it from the run's own
# data, which is the other half of AC-024's "real cycle counts".
#
# `cycles` is a COUNT, and the server's counter is a 0-BASED INDEX
# (Foundry-Init writes 0; only the F3 GRIND -> F2 INSPECT boundary
# increments), so the count is index + 1 (D-063). The unrepaired archive
# records index 0 — one cycle entered — and the repaired one records index 6,
# the seventh cycle. Publishing the raw index reported every run one cycle
# short: on grand-vulture it printed 17 against NFR-001's baseline sentence
# "18 cycles, 168 defects", whose defect half the same command already read
# as exactly 168.
#
# PHASE9_SCHEMA_INVALID no longer appears. The synthetic fixture is a run
# archive, not a cohort experiment, so it carries no cohort.json — and a
# real archive's missing cohort.json is no longer treated as a schema
# violation (D-034). PHASE9_WALL_CLOCK_UNAVAILABLE is expected: the fixture
# has no handoffs.jsonl. PHASE9_UNKNOWN_STREAM:legacy_stream is the
# fixture's deliberate out-of-vocabulary source, named rather than coerced
# onto a known stream (CT-002).

=== the PRE-FIX reader: d.get("stream") against an UPPERCASE roster ===
per_stream_defects: {}
failure_tokens: 6 x ['PHASE9_DEFECTS_FILE_MALFORMED']

