  registered-not-spawned waiting=False roster_agents=0    teams_active=True  owed=undispatched
  undispatched           waiting=False roster_agents=0    teams_active=False owed=undispatched
  unmeasured             waiting=False roster_agents=-    teams_active=-     owed=undispatched

