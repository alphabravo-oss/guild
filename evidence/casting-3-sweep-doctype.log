# Cycle-17 sweep: every corrected sentence in scripts/doctype.py, measured.
# Run from the repository root.
import os, re, subprocess, tempfile, pathlib

DOCTYPE = "plugins/webster/scripts/doctype.py"
src = open(DOCTYPE, encoding="utf-8").read()

def const(name):
    return eval(re.search(rf"^{name} = (re\.compile\(.+\))$", src, re.M).group(1), {"re": re})

def run(tree):
    env = {k: v for k, v in os.environ.items() if not k.startswith("WEBSTER_")}
    env["WEBSTER_SHOW_PER_RULE"] = "50"
    return subprocess.run(["python3", DOCTYPE, "check", tree],
                          capture_output=True, text=True, env=env)

def tree(pages):
    d = tempfile.mkdtemp()
    for name, text in pages.items():
        pathlib.Path(d, name).write_text(text, encoding="utf-8")
    return d

PAGE = "---\ntitle: {t}\ndoc_type: how-to\naudience: user\n---\n\n# {t}\n\n{b}\n"
STUB = ("---\ntitle: {t}\ndoc_type: how-to\n{a}---\n\n# {t}\n\n"
        "<!-- webster: not written yet -->\n\n## Overview\n\n{{Placeholder.}}\n")

print("== module docstring: ISO_26514 is nine entries, and marked is not checked ==")
import ast
mod = ast.parse(src)
iso = next(n for n in mod.body
           if isinstance(n, ast.Assign)
           and isinstance(n.targets[0], ast.Name) and n.targets[0].id == "ISO_26514")
entries = {k.value: v.value for k, v in zip(iso.value.keys, iso.value.values)}
print(f"   entries: {len(entries)}")
rules = re.findall(r'"rule": "([a-z-]+)"', src)
for k, v in entries.items():
    marked = "measurable elsewhere" if v.startswith("measurable elsewhere") else (
        "measurable" if v.startswith("measurable") else "a human judges")
    print(f"   {k:20} marked {marked:20} value: {v}")
print(f"   rule labels this file can emit: {sorted(set(rules))}")
print("   grep for a consistency rule in doctype.py:",
      [l for l in src.splitlines() if re.search(r'"rule": "consistency', l)] or "none")

print("\n== assigned_env_vars: two routes to counting a name, not one ==")
for n, line in enumerate(src.splitlines(), 1):
    if "re.finditer(r" in line and "A-Z][A-Z0-9]*_[A-Z0-9_]+" in line:
        print(f"   {DOCTYPE}:{n}: {line.strip()}")
d = tree({"shown.md": PAGE.format(t="Shown", b="Set the environment variable `DATABASE_URL` before you start."),
          "plain.md": PAGE.format(t="Plain", b="The receipt prints `DATABASE_URL` and nothing else names it.")})
r = run(d)
print("   one tree, two pages, no `=` anywhere in it:")
for line in r.stdout.splitlines():
    print(f"     {line}")
print(f"     exit {r.returncode}")
d = tree({"plain.md": PAGE.format(t="Plain", b="The receipt prints `DATABASE_URL` and nothing else names it.")})
r = run(d)
print("   the same page alone, with nothing calling the name a variable:")
for line in r.stdout.splitlines():
    print(f"     {line}")
print(f"     exit {r.returncode}")

print("\n== ROUTE_PATH: what the extension lookahead keeps and what it costs ==")
ROUTE_PATH = eval("re.compile(" + re.search(
    r"^ROUTE_PATH = re\.compile\((.*?)\)\n(?=[^ ])", src, re.M | re.S).group(1) + ")", {"re": re})
for t in ("/settings/profile", "/dashboard", "/api/v1.0", "/v3.0", "/etc/hosts",
          "/etc/hosts.conf", "/etc/app.properties", "/docs/readme.markdown",
          "/.gitignore", "/x.template", "//", "/data/backup.2024", "/x.123"):
    print(f"   {t:24} route={bool(ROUTE_PATH.search(f'`{t}`'))}")
# The population the comment quantifies over: every extension named in the
# ROUTE_PATH comment block, and every extension on a path-shaped token (one
# opening on "/") in tests/test_doctype.py.
comment = src[src.index("# Any backticked path, not just"):src.index("ROUTE_PATH = re.compile(")]
tests = open("plugins/webster/tests/test_doctype.py", encoding="utf-8").read()
exts = set(re.findall(r"`(\.[A-Za-z0-9]{1,20})`", comment))
for tok in re.findall(r"/[A-Za-z0-9._/-]+", comment + tests):
    seg = tok.rsplit("/", 1)[-1]
    if "." in seg:
        exts.add("." + seg.rsplit(".", 1)[-1])
exts = sorted(e for e in exts if len(e) > 1)
longest = max(exts, key=len)
print(f"   extensions named in the ROUTE_PATH comment and on the tests' paths: {exts}")
print(f"   longest: {longest} ({len(longest) - 1} characters after the dot)")

print("\n== ARCH_HARD: neither 'repository' nor 'interface' is in the rule ==")
ARCH_HARD = eval("re.compile(" + re.search(
    r"^ARCH_HARD = re\.compile\((.*?)\)\n(?=[^ ])", src, re.M | re.S).group(1) + ")", {"re": re})
for word in ("repository", "interface", "middleware", "service layer"):
    print(f"   {word:16} matched by ARCH_HARD: {bool(ARCH_HARD.search('the ' + word))}")

print("\n== UNIVERSAL_ACRONYMS: every entry is reachable by ACRONYM ==")
ACRONYM = const("ACRONYM")
start = src.index("UNIVERSAL_ACRONYMS = {")
body = src[start:src.index("\n}", start)]
acr = sorted({e for line in body.splitlines()
              for e in re.findall(r'"([^"]+)"', line.split("#", 1)[0])})
print(f"   entries: {len(acr)}")
print(f"   unreachable (ACRONYM cannot produce them): "
      f"{[a for a in acr if not ACRONYM.fullmatch(a)] or 'none'}")
print(f"   removals recorded at the end of the set:")
for line in body.splitlines():
    if line.strip().startswith("# Removed"):
        print(f"     {line.strip()}")

print("\n== the exit contract the module docstring publishes ==")
cases = [
    ("no docs directory", None),
    ("one clean written page", {"guide.md": PAGE.format(t="Guide", b="Open the app and choose a store.")}),
    ("stubs only, both well formed", {"a.md": STUB.format(t="A", a="audience: user\n"),
                                      "b.md": STUB.format(t="B", a="audience: user\n")}),
    ("stubs only, one without audience", {"a.md": STUB.format(t="A", a="audience: user\n"),
                                          "b.md": STUB.format(t="B", a="")}),
]
for name, pages in cases:
    where = tree(pages) if pages is not None else "docs-absent-fixture"
    r = run(where)
    print(f"   {name:34} exit {r.returncode}  |  {r.stdout.splitlines()[0]}")

