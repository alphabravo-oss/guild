# evidence-cmd: cd plugins/webster && for f in scripts/survey.py scripts/llmstxt.py; do echo "--- $f ---"; grep -B 8 '^import tomllib$' "$f"; done
# evidence-for: NFR-002
#
# NFR-002. A-001 put the floor at 3.11 and chose no fallback, and asked for the
# floor to be documented. Both scripts state it in the comment block attached to
# the import that requires it, which is where a reader meets the dependency.
#
# What the sentence used to say was "Every interpreter webster runs on is 3.11 or
# newer". Nothing in either script chooses which interpreter runs -- the commands
# invoke them as a bare `python3 scripts/X.py`, so it is whatever PATH resolves --
# and the claim is false on this machine, where /usr/bin/python3 is 3.9.6 and both
# scripts die at the import. The floor is a requirement on the caller, and the
# comment now states it as one.
--- scripts/survey.py ---
"""
import json, os, re, subprocess, sys
# tomllib is standard library from Python 3.11, which is this plugin's floor: webster requires
# 3.11 or newer. A-001 chose no fallback, so an older interpreter fails on the next line with
# ModuleNotFoundError rather than half-running. Nothing here chooses which interpreter runs:
# the commands invoke this file as a bare `python3 scripts/survey.py`, so which one runs is
# whatever PATH resolves, and /usr/bin/python3 on the machine this was written on is 3.9.6.
# The floor is stated because it is a requirement on the caller; the import is what enforces it.
import tomllib
--- scripts/llmstxt.py ---
import json, os, re, subprocess, sys
# tomllib is standard library from Python 3.11, which is this plugin's floor: webster requires
# 3.11 or newer. A-001 chose no fallback, so an older interpreter fails on the next line with
# ModuleNotFoundError rather than half-running -- exit 1, which the docstring above says this
# script signals nothing with. Nothing here chooses which interpreter runs: the commands
# invoke this file as a bare `python3 scripts/llmstxt.py`, so which one runs is whatever PATH
# resolves, and /usr/bin/python3 on the machine this was written on is 3.9.6. The floor is
# stated because it is a requirement on the caller; the import is what enforces it.
import tomllib
