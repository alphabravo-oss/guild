# evidence-cmd: sh -c 'set -e; root="$(git rev-parse --show-toplevel)"; cd "$root/plugins/webster"; echo "--- every rule rendered.py reports, against what its README row names ---"; python3 -c "import re; src = open(\"scripts/rendered.py\").read(); ids = re.findall(r\"^ \((\\\"[a-z-]+\\\"),\", src, re.M); print(\"    rule ids in scripts/rendered.py:\", [i.strip(chr(34)) for i in ids]); row = [l for l in open(\"README.md\") if l.startswith(\"| \" + chr(96) + \"scripts/rendered.py\" + chr(96))][0]; print(\"    the README row reads:\"); print(\"     \", row.strip())"; echo; echo "--- what rendered.py returns, against what its usage line publishes ---"; grep -n "return [0-9]$\|exit [0-9]" scripts/rendered.py | sed "s/^/    /"; echo; echo "--- widening that row alone, measured: the check compares the row to the usage text, not to the source ---"; scratch="$(mktemp -d)"; cp -R "$root/plugins/webster" "$scratch/webster"; python3 -c "import pathlib, sys; p = pathlib.Path(sys.argv[1]) / \"README.md\"; t = p.read_text(); old = \"The only check that sees what a browser sees. Exit 1 on any leak |\"; new = \"The only check that sees what a browser sees. Exit 1 on any leak, exit 0 when nothing internal reached the reader, exit 2 with no built site to read |\"; assert t.count(old) == 1; p.write_text(t.replace(old, new)); print(\"    row widened in a scratch copy to name exits 0, 1 and 2\")" "$scratch/webster"; ( cd "$scratch/webster" && uvx pytest tests/test_readme.py -q -p no:cacheprovider 2>&1 | grep -E "^E .*rendered|passed|failed" ) | sed "s/^/    /"; rm -rf "$scratch"; echo; echo "--- the optional companions: where each name appears anywhere in the plugin ---"; for name in courseware:learner plumb hollis:checker gsd:map-codebase repo-visuals; do hits="$(grep -rn "$name" agents commands skills scripts tests 2>/dev/null | wc -l | tr -d " ")"; printf "    %-18s %s hit(s) outside README.md\n" "$name" "$hits"; grep -rn "$name" agents commands skills scripts tests 2>/dev/null | sed "s/^/        /"; done; echo; echo "--- the verdict when the one gate-bearing companion is absent ---"; grep -rn "partial" commands/audit.md skills/pedagogy/SKILL.md skills/house-rules/SKILL.md | sed "s/^/    /"; echo; echo "--- who settles the Sourced gate ---"; grep -rn "Sourced" commands/audit.md skills/house-rules/SKILL.md | sed "s/^/    /"'
