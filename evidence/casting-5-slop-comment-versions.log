# evidence-cmd: bash -c 'echo "== the missing-target comment at every slop.py revision since cfafe8e =="; for rev in af10189 ba33497 ecc7dd5 ad38ed9 f33f7c2 f3e30a5 368b269; do echo "----- $rev -----"; git show "$rev:plugins/webster/scripts/slop.py" | sed -n "/^def main():/,/^    missing = /p" | grep "^    #"; done; echo "----- working tree -----"; sed -n "/^def main():/,/^    missing = /p" plugins/webster/scripts/slop.py | grep "^    #"; echo; echo "== scripts each version credits, whether it says every other script, whether it names llmstxt.py =="; for rev in af10189 ba33497 ecc7dd5 ad38ed9 f33f7c2 f3e30a5 368b269; do txt=$(git show "$rev:plugins/webster/scripts/slop.py" | sed -n "/^def main():/,/^    missing = /p" | grep "^    #" | sed "s/^ *# \{0,1\}//" | tr "\n" " " | tr -s " "); named=""; for s in drift doctype llmstxt scaffold rendered survey; do printf "%s" "$txt" | grep -q "$s\.py" && named="$named $s"; done; printf "%-9s named:%-46s every-other-script:%s  llmstxt.py:%s\n" "$rev" "$named" "$(printf "%s" "$txt" | grep -ic "every other script")" "$(printf "%s" "$txt" | grep -c "llmstxt\.py")"; done'
# evidence-for: US-008, FR-027
#
# D-140, the count in slop.py main(). The clause spoke for its own earlier
# versions. Of the seven revisions since cfafe8e, four describe the sibling
# population wrongly, in two shapes: af10189 names no script and calls the rest
# "every other script in this plugin"; ba33497, ecc7dd5 and ad38ed9 each name
# drift.py, doctype.py and scaffold.py and refuse that phrase in a parenthesis.
# f33f7c2 onward name the right four. The llmstxt.py column is 0 across exactly
# those four and 1 across the correct ones, which is the "named in none of those
# four" clause. The clause that said "Two earlier versions ... and not in the
# same way" then enumerated one plus three is what this replaces.

== the missing-target comment at every slop.py revision since cfafe8e ==
----- af10189 -----
    # A target that is not there walks to nothing, and "no slop found across 0 files" reads
    # exactly like a pass. Every other script in this plugin returns 2 for a target it cannot
    # read; this one returned 0, so a typo in the docs path silently cleared the gate.
----- ba33497 -----
    # A target that is not there walks to nothing, and "no slop found across 0 files" reads
    # exactly like a pass. drift.py:269, doctype.py:931 and scaffold.py:263 each return 2 for
    # a docs directory that is not there; this one returned 0, so a typo in the docs path
    # silently cleared the gate. (survey.py still returns 0 for a root that does not exist,
    # which is why this comment names three scripts and not "every other script".)
----- ecc7dd5 -----
    # A target that is not there walks to nothing, and "no slop found across 0 files" reads
    # exactly like a pass. Three sibling scripts already answer a docs path that is not there
    # with exit 2: drift.py's no_docs envelope in main(), doctype.py's "no docs directory at"
    # line in main(), and scaffold.py's no_docs envelope in do_check. This one returned 0, so
    # a typo in the docs path silently cleared the gate. (survey.py still returns 0 for a root
    # that does not exist, which is why this names three scripts and not "every other
    # script".) Named by symbol on purpose: the line numbers this comment used to carry had
    # already slid onto unrelated code in two of the three files by the time anyone reread it.
