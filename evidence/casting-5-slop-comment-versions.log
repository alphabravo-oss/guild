# evidence-cmd: bash -c 'echo "== the missing-target comment at every slop.py revision since cfafe8e =="; for rev in af10189 ba33497 ecc7dd5 ad38ed9 f33f7c2 f3e30a5 368b269 2830b9c; do echo "----- $rev -----"; git show "$rev:plugins/webster/scripts/slop.py" | sed -n "/^def main():/,/^    missing = /p" | grep "^    #"; done; echo "----- working tree -----"; sed -n "/^def main():/,/^    missing = /p" plugins/webster/scripts/slop.py | grep "^    #"; echo; echo "== per revision, read off that comment joined into one line =="; echo "   sha16 = 16-hex sha256 of the comment block; refuses = says not \"every other script\"; paren = gives survey.py in parentheses"; t=$(mktemp); for rev in af10189 ba33497 ecc7dd5 ad38ed9 f33f7c2 f3e30a5 368b269 2830b9c; do blk=$(git show "$rev:plugins/webster/scripts/slop.py" | sed -n "/^def main():/,/^    missing = /p" | grep "^    #"); txt=$(printf "%s\n" "$blk" | sed "s/^ *# \{0,1\}//" | tr "\n" " " | tr -s " "); h=$(printf "%s\n" "$blk" | python3 -c "import sys,hashlib;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest()[:16])"); named=""; for s in drift doctype llmstxt rendered scaffold survey; do printf "%s\n" "$blk" | grep -q "$s\.py" && named="$named+$s"; done; named=${named#+}; named=${named:-none}; e=$(printf "%s" "$txt" | grep -ic "every other script"); r=$(printf "%s" "$txt" | grep -c "not \"every other script\""); p=$(printf "%s" "$txt" | grep -c "(survey\.py"); n=$(printf "%s" "$txt" | grep -c "llmstxt\.py"); printf "%-9s %s  names:%-42s every-other-script:%s refuses:%s paren:%s llmstxt.py:%s\n" "$rev" "$h" "$named" "$e" "$r" "$p" "$n"; printf "%s %s %s %s %s\n" "$rev" "$h" "$named" "$r" "$n" >> "$t"; done; echo; echo "== the two counts, over the revisions whose comment never names llmstxt.py =="; texts=""; shapes=""; nrev=0; while read -r rev h named ref n; do test "$n" = "0" || continue; printf "  %-9s %s  shape:(names=%s,refuses=%s)\n" "$rev" "$h" "$named" "$ref"; texts="$texts $h"; shapes="$shapes $named/$ref"; nrev=$((nrev+1)); done < "$t"; echo "  revision count : $nrev"; echo "  distinct texts : $(printf "%s\n" $texts | sort -u | grep -c .)"; echo "  distinct shapes: $(printf "%s\n" $shapes | sort -u | grep -c .)"; echo "  each text, and the revisions carrying it:"; for hh in $(printf "%s\n" $texts | sort -u); do revs=""; while read -r rev h named ref n; do test "$h" = "$hh" && revs="$revs $rev"; done < "$t"; printf "    %s  carried at %s revision(s):%s\n" "$hh" "$(printf "%s\n" $revs | grep -c .)" "$revs"; done; rm -f "$t"; echo; echo "== the two revisions carrying the third text: the later one changed slop.py only in files() docstring =="; git show ad38ed9 --numstat --format= -- plugins/webster/scripts/slop.py; git show ad38ed9 --format= --unified=0 -- plugins/webster/scripts/slop.py | grep "^@@"; printf "%s\n" "import ast,subprocess" "def strip(rev):" "    t=ast.parse(subprocess.run([\"git\",\"show\",rev+\":plugins/webster/scripts/slop.py\"],capture_output=True,text=True).stdout)" "    for n in ast.walk(t):" "        if isinstance(n,(ast.Module,ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)):" "            b=n.body" "            if b and isinstance(b[0],ast.Expr) and isinstance(b[0].value,ast.Constant) and isinstance(b[0].value.value,str): n.body=b[1:] or [ast.Pass()]" "    return ast.dump(ast.fix_missing_locations(t))" "print(\"  ecc7dd5 -> ad38ed9  code identical after stripping docstrings: \"+str(strip(\"ecc7dd5\")==strip(\"ad38ed9\")))" | python3 -'
# evidence-for: US-008, FR-027
#
# D-150 (CT-006's comment, cycle 14 F-02). The clause in slop.py main() spoke
# for its own earlier versions and gave one number without its basis: it said
# "Four earlier versions", and four is the revision count, not the version
# count. The third block computes both from the same pass -- 4 revisions, 3
# distinct texts, 2 distinct shapes -- over the revisions selected by the
# mechanical criterion the clause is about, a comment that never names
# llmstxt.py. The rewritten clause states which basis each number is read off.
#
# The three and the four differ because ecc7dd5 and ad38ed9 carry the same
# comment byte for byte: ad38ed9's only change to slop.py is the one hunk in
# files()'s docstring, printed in the last block, and the ast comparison there
# shows no code moved between the two either. The shape columns are what the
# surviving prose asserts: af10189 names no sibling and does not refuse the
# phrase; the two texts after it name drift.py, doctype.py and scaffold.py,
# refuse "every other script", and give survey.py in a parenthesis. llmstxt.py
# is 0 across all three, which is the "named in none of the three" clause.

