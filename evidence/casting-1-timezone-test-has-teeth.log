# evidence-cmd: d=$(mktemp -d) && cp -R plugins/webster "$d/w" && cd "$d/w" && cp tests/conftest.py c.orig && printf "== unmutated ==\n" && uvx pytest tests/test_harness.py -q -p no:cacheprovider -k host_timezone 2>&1 | tail -1 && printf "== mutant 1: FIXTURE_COMMITS dates lose their +00:00 offset ==\n" && sed "s/+00:00//g" c.orig > tests/conftest.py && uvx pytest tests/test_harness.py -q -p no:cacheprovider -k host_timezone 2>&1 | grep -E "^(E +AssertionError|[0-9]+ (passed|failed))" ; printf "== mutant 2: build_fixture_repo stops passing env to git ==\n" && sed "s/extra_env=env/extra_env=None/g" c.orig > tests/conftest.py && uvx pytest tests/test_harness.py -q -p no:cacheprovider -k host_timezone 2>&1 | grep -E "^(E +AssertionError|[0-9]+ (passed|failed))"
# evidence-for: FR-030, AC-040
# evidence-volatile: \d+\.\d+s
#
# The new test can fail, shown against a throwaway copy of the plugin so the
# working tree is never mutated. Mutant 1 removes the property under test and
# the main assertion catches it. Mutant 2 cuts the env plumbing so TZ never
# reaches git; both builds then run in one zone and agree, which is the shape
# of a check that passes without checking. The control catches that one, and
# names which of the two causes it was from the recorded dates. An earlier
# draft of this test ran its control against git directly and survived mutant
# 2 green. D-068.

