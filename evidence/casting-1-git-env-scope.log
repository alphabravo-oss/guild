y the AST found.' 'CONCRETE = {' '    ("git", ("'"'"'ls-tree'"'"'", "'"'"'-r'"'"'", "'"'"'-z'"'"'", "'"'"'--name-only'"'"'", "'"'"'HEAD'"'"'")):' '        ['"'"'ls-tree'"'"', '"'"'-r'"'"', '"'"'-z'"'"', '"'"'--name-only'"'"', '"'"'HEAD'"'"'],' '    ("git", ("'"'"'rev-parse'"'"'", "'"'"'--verify'"'"'", "'"'"'--quiet'"'"'", "<JoinedStr>")):' '        ['"'"'rev-parse'"'"', '"'"'--verify'"'"', '"'"'--quiet'"'"', '"'"'cfafe8e^{commit}'"'"'],' '    ("git", ("'"'"'merge-base'"'"'", "'"'"'HEAD'"'"'", "<Name>")):' '        ['"'"'merge-base'"'"', '"'"'HEAD'"'"', '"'"'origin/main'"'"'],' '    ("git", ("'"'"'ls-files'"'"'", "'"'"'-z'"'"'", "'"'"'--'"'"'", "<Name>")):' '        ['"'"'ls-files'"'"', '"'"'-z'"'"', '"'"'--'"'"', '"'"'plugins/webster'"'"'],' '    ("git", ("'"'"'diff'"'"'", "'"'"'--name-only'"'"'", "'"'"'-z'"'"'", "<JoinedStr>")):' '        ['"'"'diff'"'"', '"'"'--name-only'"'"', '"'"'-z'"'"', '"'"'cfafe8e..HEAD'"'"'],' '    ("git_in", ("'"'"'rev-parse'"'"'", "'"'"'HEAD'"'"'")): ['"'"'rev-parse'"'"', '"'"'HEAD'"'"'],' '    ("git_in", ("'"'"'log'"'"'", "'"'"'-1'"'"'", "'"'"'--format=%ai'"'"'")): ['"'"'log'"'"', '"'"'-1'"'"', '"'"'--format=%ai'"'"'],' '    ("git_in", ("'"'"'log'"'"'", "'"'"'--format=%s'"'"'", "'"'"'--reverse'"'"'")): ['"'"'log'"'"', '"'"'--format=%s'"'"', '"'"'--reverse'"'"'],' '    ("git_in", ("'"'"'log'"'"'", "'"'"'--format=%H %aI %s'"'"'", "'"'"'--reverse'"'"'")):' '        ['"'"'log'"'"', '"'"'--format=%H %aI %s'"'"', '"'"'--reverse'"'"'],' '}' 'missing = [s for s in shapes if s not in CONCRETE]' 'assert not missing, '"'"'argv shape found by AST but never measured: %r'"'"' % (missing,)' 'print('"'"'    every shape above has a concrete argv measured below:               %s'"'"'' '      % (len(missing) == 0))' 'print('"'"'    the loop at the merge-base site runs the same shape for both refs, so'"'"')' 'print('"'"'    "main" is measured alongside "origin/main".'"'"')' '' '# the fixture repo git_in() is aimed at, built by the real conftest builder' 'st = types.ModuleType('"'"'pytest'"'"')' 'st.fixture = lambda *a, **k: (a[0] if a and callable(a[0]) else (lambda f: f))' 'sys.modules['"'"'pytest'"'"'] = st' 'm = types.ModuleType('"'"'c'"'"'); m.__file__ = CONF' 'exec(compile(open(CONF, encoding='"'"'utf-8'"'"').read(), CONF, '"'"'exec'"'"'), m.__dict__)' 'FIX = str(m.build_fixture_repo(os.path.join(tempfile.mkdtemp(), '"'"'r'"'"')))' 'REPO = subprocess.run(['"'"'git'"'"', '"'"'rev-parse'"'"', '"'"'--show-toplevel'"'"'],' '                      capture_output=True, text=True).stdout.strip()' '' 'W = tempfile.mkdtemp()' 'def cfg(name, body):' '    p = os.path.join(W, name); open(p, '"'"'w'"'"').write(body); return p' 'ALIASED = ['"'"'ls-tree'"'"', '"'"'rev-parse'"'"', '"'"'merge-base'"'"', '"'"'log'"'"', '"'"'ls-files'"'"', '"'"'diff'"'"']' 'CONFIGS = [' '    ('"'"'the guard as shipped'"'"', os.devnull),' '    ('"'"'status.relativePaths = true'"'"', cfg('"'"'rel_t'"'"', '"'"'[status]\n\trelativePaths = true\n'"'"')),' '    ('"'"'status.relativePaths = false'"'"', cfg('"'"'rel_f'"'"', '"'"'[status]\n\trelativePaths = false\n'"'"')),' '    ('"'"'[alias] shadowing all six'"'"', cfg('"'"'alias'"'"', '"'"'[alias]\n'"'"' + '"'"''"'"'.join(' '        '"'"'\t%s = !echo SHADOWED\n'"'"' % s for s in ALIASED) + '"'"'\twibble = !echo SHADOWED\n'"'"')),' ']' 'def run(argv, cwd, gc):' '    env = {k: os.environ[k] for k in ('"'"'PATH'"'"', '"'"'HOME'"'"') if k in os.environ}' '    env['"'"'GIT_CONFIG_GLOBAL'"'"'] = gc; env['"'"'GIT_CONFIG_NOSYSTEM'"'"'] = '"'"'1'"'"'' '    r = subprocess.run(['"'"'git'"'"'] + argv, cwd=cwd, capture_output=True, text=True,' '                       timeout=30, env=env)' '    return (r.returncode, r.stdout, r.stderr)' '' 'print()' 'print('"'"'[2] every one of those queries under a global config the guard would have blocked'"'"')' 'print('"'"'    (compared byte for byte on exit code, stdout and stderr against the guard)'"'"')' 'print('"'"'    %-42s %-13s %-13s %s'"'"' % ('"'"'argv'"'"', '"'"'relPaths=true'"'"', '"'"'relPaths=false'"'"', '"'"'alias'"'"'))' 'allsame = True' 'for (helper, shape) in shapes:' '    argv = CONCRETE[(helper, shape)]' '    extra = [['"'"'merge-base'"'"', '"'"'HEAD'"'"', '"'"'main'"'"']] if argv[0] == '"'"'merge-base'"'"' else []' '    for a in [argv] + extra:' '        cwd = REPO if helper == '"'"'git'"'"' else FIX' '        base = run(a, cwd, CONFIGS[0][1])' '        verdicts = []' '        for _, gc in CONFIGS[1:]:' '            same = run(a, cwd, gc) == base' '            allsame &= same' '            verdicts.append('"'"'identical'"'"' if same else '"'"'DIFFERS'"'"')' '        print('"'"'    %-42s %-13s %-13s %s'"'"' % ('"'"'git '"'"' + '"'"' '"'"'.join(a), *verdicts))' 'print('"'"'    all %d subcommands unmoved by all three configs: %s'"'"' % (len(subs), allsame))' '' 'print()' 'print('"'"'[3] the controls -- the same config files, on things they DO reach'"'"')' 'sub = os.path.join(FIX, '"'"'docs'"'"')' 'open(os.path.join(FIX, '"'"'docs'"'"', '"'"'faq.md'"'"'), '"'"'a'"'"').write('"'"'\ndirty\n'"'"')' 'for label, gc in CONFIGS[:3]:' '    print('"'"'    git status --short from docs/ with %-30s -> %r'"'"'' '          % (label, run(['"'"'status'"'"', '"'"'--short'"'"'], sub, gc)[1]))' 'print('"'"'    -> relativePaths=false moves git status, so the file is read, not ignored;'"'"')' 'print('"'"'       relativePaths=true matches the guard because true is git own default.'"'"')' 'al = CONFIGS[3][1]' 'print('"'"'    git wibble        (no built-in of that name) -> %r'"'"' % (run(['"'"'wibble'"'"'], FIX, al)[1],))' 'print('"'"'    git ls-tree ...   (a built-in) under the same alias file -> %r'"'"'' '      % (run(['"'"'ls-tree'"'"', '"'"'-r'"'"', '"'"'-z'"'"', '"'"'--name-only'"'"', '"'"'HEAD'"'"'], FIX, al)[1][:40],))' 'print('"'"'    -> the alias file is live; git ignores the six that hide a built-in.'"'"')' 'print()' 'print('"'"'[4] the guard the measurement is about, and git version'"'"')' 'print('"'"'    '"'"' + [l for l in open(SRC, encoding='"'"'utf-8'"'"') if l.startswith('"'"'GIT_ENV = '"'"')][0].strip())' 'print('"'"'    '"'"' + subprocess.run(['"'"'git'"'"', '"'"'--version'"'"'], capture_output=True, text=True).stdout.strip())' > "$T/e.py"; python3 "$T/e.py"; rm -rf "$T"
# evidence-for: US-010, FR-043, FR-039, OT-043, GI-007
#
# GRIND cycle 16, D-160 (PROVE cycle 15 F-03). The comment above test_harness.py's GIT_ENV said
# it had measured "every query this module runs" and then named three: ls-files, ls-tree and
# diff --name-only. GIT_ENV is carried by two helpers, git() and git_in(), and between them they
# issue six subcommands. The quantifier was the only false part -- all six really are unmoved --
# so the fix names all six and this log is the enumeration behind the count.
#
# Block [1] derives the population by AST rather than by reading: the helpers are found by
# looking for env.update(GIT_ENV), the call sites by looking for calls to those helpers, and the
# subcommand by taking each call's first argument. Nine distinct argv shapes, six distinct
# subcommands. Every shape must have a concrete argv in the measurement table or the script
# raises, so a query added later cannot slip past this log unmeasured.
#
# Block [2] runs each of them under three global configs the guard exists to block, comparing
# exit code, stdout and stderr byte for byte against the guarded run. Nothing moves.
#
# Block [3] is why [2] is not vacuous. The same config files do move things they reach:
# status.relativePaths = false changes git status --short run from a subdirectory, and an alias
# on a name git has no built-in for fires. Two facts fall out of it. status.relativePaths = true
# -- the exact value the original comment named -- is git's own default, so it could not have
# changed anything anywhere; and git ignores the six aliases that hide a built-in, which is why
# the alias column is identical rather than SHADOWED.
#
# git() runs against this repository and git_in() against a fixture repo built by the real
# conftest.build_fixture_repo, which is the tree git_in() is aimed at in the suite.

[1] which helpers carry GIT_ENV, and every git query they issue -- by AST, not by eye
    helpers that do env.update(GIT_ENV): git, git_in   (2, and no others in the module)
    call sites, each with the argv shape it passes:
