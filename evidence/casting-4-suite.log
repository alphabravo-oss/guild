# evidence-cmd: sh -c 'set -e; cd "$(git rev-parse --show-toplevel)"; t="$(mktemp -d)"; printf "%s\n" '"'"'import os, subprocess'"'"' '"'"'ROOT = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()'"'"' '"'"'BASE = {k: os.environ[k] for k in ("PATH", "HOME") if k in os.environ}'"'"' '"'"'W = os.path.join(ROOT, "plugins/webster")'"'"' '"'"'SCOPE = "tests/test_harness.py::test_only_the_writable_file_set_is_tracked_and_changed"'"'"' '"'"'PIN = "tests/test_readme.py::test_status_passing_count_matches_the_collected_suite"'"'"' '"'"''"'"' '"'"'print("== the suite this casting'"'"'"'"'"'"'"'"'s four files sit in ==")'"'"' '"'"'c = subprocess.run(["uvx", "pytest", "--collect-only", "-q", "-p", "no:cacheprovider"],'"'"' '"'"'                   cwd=W, capture_output=True, text=True, env=BASE, timeout=300)'"'"' '"'"'print("   cd plugins/webster && uvx pytest --collect-only -q -> exit %d" % c.returncode)'"'"' '"'"'print("       %s" % [l for l in c.stdout.splitlines() if l.strip()][-1])'"'"' '"'"'r = subprocess.run(["uvx", "pytest", "-q", "--no-header", "--tb=no", "-rf",'"'"' '"'"'                    "-p", "no:cacheprovider"],'"'"' '"'"'                   cwd=W, capture_output=True, text=True, env=BASE, timeout=600)'"'"' '"'"'print("   cd plugins/webster && uvx pytest -q -> exit %d" % r.returncode)'"'"' '"'"'for l in sorted(l.split(" ")[1] for l in r.stdout.splitlines() if l.startswith("FAILED ")):'"'"' '"'"'    print("       FAILED %s" % l)'"'"' '"'"'print("   Both reds are the run'"'"'"'"'"'"'"'"'s own bookkeeping and both are expected here:")'"'"' '"'"'print("   the scope test diffs this change against GI-007'"'"'"'"'"'"'"'"'s five writable locations, so")'"'"' '"'"'print("   it is red exactly while this run'"'"'"'"'"'"'"'"'s evidence/ logs are committed and green")'"'"' '"'"'print("   again on the lead'"'"'"'"'"'"'"'"'s strip commit; the README count pin is red because D-168'"'"'"'"'"'"'"'"'s")'"'"' '"'"'print("   test raised the collected count and casting 6 re-pins the README last.")'"'"' '"'"'r2 = subprocess.run(["uvx", "pytest", "-q", "--no-header", "--tb=no", "-rf",'"'"' '"'"'                     "-p", "no:cacheprovider", "--deselect", SCOPE, "--deselect", PIN],'"'"' '"'"'                    cwd=W, capture_output=True, text=True, env=BASE, timeout=600)'"'"' '"'"'print("   the same run with those two deselected -> exit %d, failures: %s"'"'"' '"'"'      % (r2.returncode,'"'"' '"'"'         sorted(l.split(" ")[1] for l in r2.stdout.splitlines() if l.startswith("FAILED ")) or "none"))'"'"' '"'"'print()'"'"' '"'"'print("== this casting'"'"'"'"'"'"'"'"'s own two modules ==")'"'"' '"'"'r3 = subprocess.run(["uvx", "pytest", "tests/test_survey.py", "tests/test_llmstxt.py",'"'"' '"'"'                     "-q", "--no-header", "--tb=no", "-rf", "-p", "no:cacheprovider"],'"'"' '"'"'                    cwd=W, capture_output=True, text=True, env=BASE, timeout=600)'"'"' '"'"'print("   exit %d, failures: %s"'"'"' '"'"'      % (r3.returncode,'"'"' '"'"'         sorted(l.split(" ")[1] for l in r3.stdout.splitlines() if l.startswith("FAILED ")) or "none"))'"'"' '"'"'for name in ("test_survey.py", "test_llmstxt.py"):'"'"' '"'"'    n = len([l for l in open(os.path.join(W, "tests", name), encoding="utf-8").read().splitlines()'"'"' '"'"'             if l.startswith("def test_")])'"'"' '"'"'    print("   %-16s %d test functions" % (name, n))'"'"' '"'"'print()'"'"' '"'"'print("== what this commit changed, and what it did not ==")'"'"' '"'"'FIX = "42fe57b"   # the commit carrying D-168, pinned rather than HEAD~1 so this'"'"' '"'"'                  # block keeps naming the fix once the evidence commit lands on top'"'"' '"'"'d = subprocess.run(["git", "-C", ROOT, "diff", "--stat", FIX + "~1", FIX],'"'"' '"'"'                   capture_output=True, text=True).stdout.splitlines()'"'"' '"'"'for l in d:'"'"' '"'"'    print("   %s" % l.strip())'"'"' '"'"'print("   llmstxt.py and test_llmstxt.py are untouched by D-168 and are not in that list.")'"'"' > "$t/g.py"; python3 "$t/g.py"; rm -rf "$t"'
