# evidence-cmd: sh -c 'D=$(mktemp -d); cp -R plugins/foundry/mcp-server/tests/fixtures/migrate_archive/pre_change "$D/run"; printf "%s\n%s\n" "{\"timestamp\": \"2026-08-28T19:06:32+00:00\"}" "{\"timestamp\": \"2026-08-28T21:06:32+00:00\"}" > "$D/run/handoffs.jsonl"; echo "=== the archive a real run leaves behind ==="; for f in cohort.json context-at-f2.txt defects.json state.json handoffs.jsonl; do if test -e "$D/run/$f"; then echo "  present: $f"; else echo "  absent:  $f"; fi; done; echo; echo "=== 1. un-migrated: no roll-up to read yet ==="; python3 plugins/foundry/scripts/measure-run.py "$D/run" > "$D/a.json"; echo "exit: $?"; python3 -c "import json,sys; d=json.load(open(sys.argv[1])); [print(k + \":\", json.dumps(d[k], sort_keys=True)) for k in sys.argv[2:]]" "$D/a.json" cycles per_stream_defects per_cycle_coverage failure_tokens gate_verdicts; echo; echo "=== 2. migrated: the roll-up is read, the recorded cycle is repaired ==="; python3 plugins/foundry/scripts/migrate-archive.py "$D/run" > /dev/null; python3 plugins/foundry/scripts/measure-run.py "$D/run" > "$D/b.json"; echo "exit: $?"; python3 -c "import json,sys; d=json.load(open(sys.argv[1])); [print(k + \":\", json.dumps(d[k], sort_keys=True)) for k in sys.argv[2:]]" "$D/b.json" cycles per_cycle_coverage failure_tokens; echo; echo "=== 3. a STALE server cycle counter is named, not passed as fact (FI-1) ==="; python3 -c "import json,sys,pathlib; p=pathlib.Path(sys.argv[1]); s=json.loads(p.read_text()); s[\"cycle\"]=0; p.write_text(json.dumps(s, indent=2))" "$D/run/state.json"; python3 plugins/foundry/scripts/measure-run.py "$D/run" > "$D/c.json"; echo "exit: $?"; python3 -c "import json,sys; d=json.load(open(sys.argv[1])); [print(k + \":\", json.dumps(d[k], sort_keys=True)) for k in sys.argv[2:]]" "$D/c.json" cycles failure_tokens; echo; echo "=== 4. all four gates real once the two measurements are supplied ==="; python3 plugins/foundry/scripts/measure-run.py "$D/run" --context-pct 41.5 --baseline-seconds 9000 > "$D/d.json"; python3 -c "import json,sys; d=json.load(open(sys.argv[1])); [print(k + \":\", json.dumps(d[k], sort_keys=True)) for k in sys.argv[2:]]" "$D/d.json" f2_context_pct gate_verdicts; rm -rf "$D"'
# evidence-for: FR-018, AC-024
# evidence-timeout: 120
#
# D-034 — the run-quality gates operating on a REAL archive. A real foundry
# run writes no cohort.json and no context-at-f2.txt (both are hand-placed
# cohort-study inputs), so treating the first as a schema violation made
# EVERY real archive emit PHASE9_SCHEMA_INVALID and exit 1, and the second
# left two of four gates permanently MISSING. The per-cycle roll-up — the
# only artifact recording what each stream CHECKED — was never opened.
#
# PHASE9_SCHEMA_INVALID appears at no stage below. The remaining
# PHASE9_UNKNOWN_STREAM:legacy_stream is the fixture working as intended:
# a deliberately out-of-vocabulary source that migration preserves verbatim
# (AC-026) and measure-run NAMES rather than coerces.
#
# `cycles` is a COUNT while the roll-up is keyed by the server's 0-BASED
# INDEX, so stage 2's "cycles: 7" against roll-up keys 0..6 is the seventh
# cycle, not a disagreement (D-063). Stage 3 winds state.json back to 0 and
# the detector fires on exactly that gap — it stays strict; what D-060 fixed
# is the migration no longer CREATING the gap by reading less evidence in
# step 5 than it keys the roll-up on in step 3.

=== the archive a real run leaves behind ===
  absent:  cohort.json
  absent:  context-at-f2.txt
  present: defects.json
  present: state.json
  present: handoffs.jsonl

=== 1. un-migrated: no roll-up to read yet ===
exit: 1
cycles: 1
per_stream_defects: {"PROVE": 3, "TEST-01": 1, "TRACE": 1}
per_cycle_coverage: {}
failure_tokens: ["PHASE9_UNKNOWN_STREAM:legacy_stream"]
gate_verdicts: {"cycles": "PASS", "defect_yield_per_stream": "FAIL", "f2_context_pct": "MISSING", "wall_clock_regression_pct": "MISSING"}

=== 2. migrated: the roll-up is read, the recorded cycle is repaired ===
exit: 1
cycles: 7
per_cycle_coverage: {"0": {"PROVE": {"findings": 1, "items_checked": 0, "items_total": 0}, "TRACE": {"findings": 3, "items_checked": 12, "items_total": 15}}, "2": {"PROVE": {"findings": 1, "items_checked": 0, "items_total": 0}, "TEST-01": {"findings": 1, "items_checked": 0, "items_total": 0}}, "5": {"PROVE": {"findings": 1, "items_checked": 0, "items_total": 0}}, "6": {"PROVE": {"findings": 0, "items_checked": 40, "items_total": 40}}}
failure_tokens: ["PHASE9_UNKNOWN_STREAM:legacy_stream"]

=== 3. a STALE server cycle counter is named, not passed as fact (FI-1) ===
exit: 1
cycles: 7
failure_tokens: ["PHASE9_CYCLE_COUNT_INVALID", "PHASE9_UNKNOWN_STREAM:legacy_stream"]

=== 4. all four gates real once the two measurements are supplied ===
f2_context_pct: 41.5
gate_verdicts: {"cycles": "PASS", "defect_yield_per_stream": "FAIL", "f2_context_pct": "PASS", "wall_clock_regression_pct": "PASS"}
