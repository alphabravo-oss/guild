== the script this log runs ==
# Cycle-17 sweep: the red-first baseline tests/test_doctype.py's docstring states,
# re-measured. Run from the repository root.
import ast, os, re, shutil, subprocess, sys, tempfile

TESTS = "plugins/webster/tests/test_doctype.py"
BASE = "cfafe8e"
src = open(TESTS, encoding="utf-8").read()
doc = ast.get_docstring(ast.parse(src))
first, bucket = [], 0
for line in doc.splitlines():
    if line.startswith("Six more tests"):
        break
    m = re.match(r"\s+(test_\w+)", line)
    if m:
        first.append(m.group(1))
controls = re.findall(r"(test_\w+)\s+\(control\)", doc)

d = tempfile.mkdtemp()
wt = os.path.join(d, "wt")
os.makedirs(wt)
tar = subprocess.run(["git", "archive", BASE], capture_output=True)
subprocess.run(["tar", "-x", "-C", wt], input=tar.stdout, check=True)
shutil.rmtree(os.path.join(wt, "plugins/webster/tests"), ignore_errors=True)
shutil.copytree("plugins/webster/tests", os.path.join(wt, "plugins/webster/tests"))
shutil.copy("plugins/webster/pyproject.toml", os.path.join(wt, "plugins/webster/pyproject.toml"))

env = dict(os.environ, COLUMNS="200")
env.pop("WEBSTER_SURVEY", None)
r = subprocess.run(["uvx", "pytest", "tests/test_doctype.py", "-q", "--tb=no",
                    "-p", "no:cacheprovider"],
                   cwd=os.path.join(wt, "plugins/webster"),
                   capture_output=True, text=True, env=env)
failed = sorted({m.group(1) for m in re.finditer(r"^FAILED [^\s:]+::(\w+)", r.stdout, re.M)})
summary = [l for l in r.stdout.splitlines() if re.match(r"^\d+ (failed|passed)", l)]

print(f"== tests/test_doctype.py run against the scripts/ of {BASE} ==")
print(f"   {summary[-1] if summary else r.stdout.strip().splitlines()[-1]}")
print(f"   first index: {len(first)} tests; of those red at {BASE}: "
      f"{sum(1 for t in first if t in failed)}")
print(f"   first-index tests green at {BASE}: {[t for t in first if t not in failed]}")
print(f"   controls marked (control): {len(controls)}; red at {BASE}: "
      f"{[c for c in controls if c in failed] or 'none'}")
print(f"   every test red at {BASE} ({len(failed)}):")
for name in failed:
    print(f"     {name}")
shutil.rmtree(d, ignore_errors=True)

