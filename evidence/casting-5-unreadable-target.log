# evidence-cmd: sh -c 'set -u; repo=$(pwd); tmp=$(mktemp -d); cd "$tmp"; slop="$repo/plugins/webster/scripts/slop.py"; mkdir docs; printf "%s\n" "# Release notes" "" "The queue drains in order." > docs/real.md; ln -s nowhere.md docs/broken.md; echo "=== slop.py docs   (docs/broken.md is a *.md that is a dangling symlink) ==="; python3 "$slop" docs; echo "exit=$?"; echo "=== slop.py /no/such/dir   (the target that was never there) ==="; python3 "$slop" /no/such/dir; echo "exit=$?"; rm docs/broken.md; echo "=== slop.py docs   (same tree, the symlink removed) ==="; python3 "$slop" docs; echo "exit=$?"; echo "=== slop.py docs/real.md   (one readable file named directly) ==="; python3 "$slop" docs/real.md; echo "exit=$?"; cd "$repo"; rm -rf "$tmp"'
# evidence-for: US-008, FR-027, AC-035
#
# D-027. The missing-target guard tested "is it there" and nothing else, so a target that
# was present and unreadable walked straight past it. Against f31b144 the four runs below
# printed, in order:
#
#   slop.py docs           FileNotFoundError traceback out of open(), exit 1
#   slop.py /no/such/dir   no such target: /no/such/dir, exit 2   (already correct)
#   slop.py docs           no slop found across 1 files, exit 0   (already correct)
#   slop.py docs/real.md   no slop found across 1 files, exit 0   (already correct)
#
# Exit 1 is the code this script reserves for high severity slop, so the traceback reported
# a finding against a file nothing had opened. The first run now returns 2 and names the
# path, mirroring the `no such target: X` line beside it.
#
# A dangling symlink, not chmod 000, because this log is re-executed by whoever runs the
# gate: root reads a 000 file anyway, so a permission-based demonstration would print a
# different body for a root runner and fail its own byte comparison. The same fix also
# turns an unlistable directory (chmod 000 on the tree, previously "no slop found across
# 0 files" at exit 0) into exit 2; that half is left out of this body for the same reason.
#

=== slop.py docs   (docs/broken.md is a *.md that is a dangling symlink) ===
cannot read target: docs/broken.md (No such file or directory)
exit=2
=== slop.py /no/such/dir   (the target that was never there) ===
no such target: /no/such/dir
exit=2
=== slop.py docs   (same tree, the symlink removed) ===
no slop found across 1 files
exit=0
=== slop.py docs/real.md   (one readable file named directly) ===
no slop found across 1 files
exit=0
