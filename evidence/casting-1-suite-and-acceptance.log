# evidence-cmd: cd "$(git rev-parse --show-toplevel)"; T=$(mktemp -d); printf "%s\n" 'import ast, json, os, re, subprocess' '' 'T = "plugins/webster/tests"' 'BASE = {k: os.environ[k] for k in ("PATH", "HOME") if k in os.environ}' 'def sh(a, cwd=None):' '    return subprocess.run(a, cwd=cwd, capture_output=True, text=True, timeout=300, env=BASE)' 'MODULES = sorted(p for p in os.listdir(T) if p.startswith("test_") and p.endswith(".py"))' 'SCOPE = "tests/test_harness.py::test_only_the_writable_file_set_is_tracked_and_changed"' '' 'print("[1] AC-038 / OT-036 -- the blessed command, and the count README pins")' 'c = sh(["uvx", "pytest", "--collect-only", "-q"], cwd="plugins/webster")' 'collected = [l for l in c.stdout.splitlines() if l.strip()][-1]' 'print("    cd plugins/webster && uvx pytest --collect-only -q -> exit %d" % c.returncode)' 'print("        %s" % collected)' 'r = sh(["uvx", "pytest", "-q", "--deselect", SCOPE], cwd="plugins/webster")' 'print("    cd plugins/webster && uvx pytest -q --deselect <scope test> -> exit %d" % r.returncode)' 'print("        %s" % [l for l in r.stdout.splitlines() if l.strip()][-1])' 'print("    The scope test is deselected here and only here: it diffs this change")' 'print("    against GI-007'"'"'s five locations, so it is red exactly while this run'"'"'s")' 'print("    own evidence/ logs are committed and green on the lead'"'"'s strip commit.")' 'print("    Its own docstring says so rather than skipping, which NFR-001 forbids.")' 'print("    The predicate'"'"'s verdict on such a path, unchanged by the deselection:")' 'ns = {"__file__": os.path.abspath(os.path.join(T, "test_harness.py")), "__name__": "th"}' 'exec(compile(open(os.path.join(T, "test_harness.py"), encoding="utf-8").read(),' '             os.path.join(T, "test_harness.py"), "exec"), ns)' 'print("        changed_path_allowed('"'"'evidence/casting-1-sweep-conftest.log'"'"') -> %s"' '      % ns["changed_path_allowed"]("evidence/casting-1-sweep-conftest.log"))' 'print()' '' 'print("[2] AC-041 -- no test module imports a webster script; every script")' 'print("    invocation goes through run_script")' 'stems = {p[:-3] for p in os.listdir("plugins/webster/scripts") if p.endswith(".py")}' 'bad, calls = [], []' 'for name in MODULES + ["conftest.py"]:' '    f = os.path.join(T, name)' '    tree = ast.parse(open(f, encoding="utf-8").read(), f)' '    for n in ast.walk(tree):' '        if isinstance(n, ast.Import):' '            bad += [(name, n.lineno, a.name) for a in n.names if a.name.split(".")[0] in stems]' '        elif isinstance(n, ast.ImportFrom) and (n.module or "").split(".")[0] in stems:' '            bad.append((name, n.lineno, n.module))' '        elif (isinstance(n, ast.Call) and isinstance(n.func, ast.Name)' '              and n.func.id == "run_script" and n.args' '              and isinstance(n.args[0], ast.Constant)):' '            calls.append((name, n.args[0].value))' 'print("    modules scanned: %s" % ", ".join(MODULES + ["conftest.py"]))' 'print("    imports of any of %s: %s" % (", ".join(sorted(stems)), bad or "(none)"))' 'by_script = {}' 'for name, script in calls:' '    by_script.setdefault(script, set()).add(name)' 'print("    run_script() call sites: %d, naming %d scripts" % (len(calls), len(by_script)))' 'for script in sorted(by_script):' '    print("        %-14s from %s" % (script, ", ".join(sorted(by_script[script]))))' 'never = sorted(s + ".py" for s in stems if s + ".py" not in by_script)' 'print("    scripts no test drives at all: %s" % (", ".join(never) or "(none)"))' 'print("    OT-039'"'"'s literal grep -> exit %d, output %r"' '      % (lambda g: (g.returncode, g.stdout))(sh(["grep", "-rn", "-e", "import survey",' '                                                 "-e", "import drift", "-e", "import slop", "--", T])))' 'print()' '' 'print("[3] AC-042 -- the release metadata this casting'"'"'s spec block names")' 'pj = json.load(open("plugins/webster/.claude-plugin/plugin.json", encoding="utf-8"))' 'print("    plugins/webster/.claude-plugin/plugin.json version -> %r" % pj.get("version"))' 'readme = open("plugins/webster/README.md", encoding="utf-8").read()' 'for label, needle in (("the run command", "cd plugins/webster && uvx pytest"),' '                      ("the passing count", "148"),' '                      ("WEBSTER_SURVEY", "WEBSTER_SURVEY")):' '    hits = [l.strip() for l in readme.splitlines() if needle in l]' '    print("    README names %-18s -> %s" % (label, bool(hits)))' '    for h in hits[:2]:' '        print("        %s" % h[:104])' 'print("    (README.md and plugin.json are casting 6'"'"'s to write; this block reads")' 'print("     them and changes nothing.)")' 'print()' '' 'print("[4] NFR-004 -- every subprocess in the suite carries an explicit timeout")' 'rows = []' 'for name in MODULES + ["conftest.py"]:' '    f = os.path.join(T, name)' '    tree = ast.parse(open(f, encoding="utf-8").read(), f)' '    for n in ast.walk(tree):' '        if (isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute)' '                and n.func.attr == "run" and getattr(n.func.value, "id", "") == "subprocess"):' '            kw = {k.arg: ast.unparse(k.value) for k in n.keywords}' '            rows.append((name, n.lineno, kw.get("timeout", "<NONE>")))' 'for name, ln, t in sorted(rows):' '    print("    %-16s line %-4d timeout=%s" % (name, ln, t))' 'print("    %d sites, %d with an explicit timeout, %d without"' '      % (len(rows), sum(1 for r in rows if r[2] != "<NONE>"),' '         sum(1 for r in rows if r[2] == "<NONE>")))' 'print("    the constants those names resolve to: SCRIPT_TIMEOUT=%s, GIT_TIMEOUT=%s"' '      % (re.search(r"^SCRIPT_TIMEOUT = (\d+)", open(os.path.join(T, "conftest.py"),' '                   encoding="utf-8").read(), re.M).group(1),' '         re.search(r"^GIT_TIMEOUT = (\d+)", open(os.path.join(T, "test_harness.py"),' '                   encoding="utf-8").read(), re.M).group(1)))' 'print("    and the suite'"'"'s own wall time is the [1] figure above.")' > "$T/e.py"; python3 "$T/e.py"; rm -rf "$T"
