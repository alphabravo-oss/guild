# evidence-cmd: cd plugins/webster && BASE=/tmp/webster-c5-docsdir; o=/tmp/webster-c5-out; rm -rf "$BASE"; mkdir -p "$BASE"; n=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd; run() { python3 "$@" > "$o" 2>&1; c=$?; sed "s/d\{50,\}/<D-x200>/g" "$o"; echo "exit=$c"; }; ( cd "$BASE" && for i in 1 2 3 4 5 6; do mkdir "$n" && cd "$n" || exit 1; done && printf "%s\n" "---" "title: Overview" "---" > index.md ) || echo BUILD-FAILED; p=$BASE; for i in 1 2 3 4 5 6; do p=$p/$n; done; git show 0ac652d:plugins/webster/scripts/scaffold.py > "$BASE/before.py"; printf "x\n" > "$BASE/regular-file"; echo "--- before 0ac652d: a directory that is there and holds a page, reported absent ---"; run "$BASE/before.py" check --docs "$p"; echo "--- after: the same path in the same state ---"; run scripts/scaffold.py check --docs "$p"; echo "--- init on that path: the answer check now agrees with, unchanged by this fix ---"; run scripts/scaffold.py init --docs "$p"; echo "--- the no_docs controls that must not move: nothing there, and a parent that is a file ---"; run scripts/scaffold.py check --docs "$BASE/nowhere"; run scripts/scaffold.py check --docs "$BASE/regular-file/docs"; rm -rf "$BASE" "$o"
# evidence-for: US-009, FR-028
#
# US-009 / FR-028 (CT-005). do_check used to open with os.path.isdir, which
# calls os.stat and returns False for every error that call raises, so three
# different answers left through one no_docs envelope: nothing is at --docs, what
# is there is not a directory, and the filesystem refused to say.
#
# The path here is a real directory holding a real page, built one short
# component at a time so that the whole of it is longer than PATH_MAX. Nothing
# can open it by name afterwards -- root included, which is why this is the
# fixture and chmod 000 is not. Before, check called it absent. After, it is the
# cannot_read this file already publishes for a read it was refused, carrying the
# path and what the filesystem said.
#
# init is the control, on the same path in the same state. It reaches os.makedirs,
# which does not swallow, and has reported the refusal all along -- which is what
# made the check answer wrong rather than merely coarse: one script, one question,
# two answers, and the wrong one reads as a tree nobody has scaffolded yet.
#
# The last two runs are the no_docs half, which had to keep working: a path with
# nothing at it (ENOENT) and a path whose parent is a regular file (ENOTDIR).
#
# The 200-character path components are collapsed to <D-x200> by the sed in the
# command, so the envelopes stay readable; the exit code is captured before the
# pipe, not from it.
--- before 0ac652d: a directory that is there and holds a page, reported absent ---
{"status": "no_docs", "docs": "/tmp/webster-c5-docsdir/<D-x200>/<D-x200>/<D-x200>/<D-x200>/<D-x200>/<D-x200>"}
exit=2
--- after: the same path in the same state ---
{"status": "cannot_read", "path": "/tmp/webster-c5-docsdir/<D-x200>/<D-x200>/<D-x200>/<D-x200>/<D-x200>/<D-x200>", "error": "File name too long"}
exit=2
--- init on that path: the answer check now agrees with, unchanged by this fix ---
{"status": "cannot_write", "path": "/tmp/webster-c5-docsdir/<D-x200>/<D-x200>/<D-x200>/<D-x200>/<D-x200>", "error": "File name too long", "created": []}
exit=2
--- the no_docs controls that must not move: nothing there, and a parent that is a file ---
{"status": "no_docs", "docs": "/tmp/webster-c5-docsdir/nowhere"}
exit=2
{"status": "no_docs", "docs": "/tmp/webster-c5-docsdir/regular-file/docs"}
exit=2
