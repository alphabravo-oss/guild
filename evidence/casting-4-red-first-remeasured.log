).stdout'"'"' '"'"'        lines = text.splitlines()'"'"' '"'"'        at = lines.index("import tomllib")'"'"' '"'"'        j = at - 1'"'"' '"'"'        while j >= 0 and lines[j].lstrip().startswith("#"):'"'"' '"'"'            j -= 1'"'"' '"'"'        block = "\n".join(lines[j + 1:at])'"'"' '"'"'        m[name] = (block, replacement)'"'"' '"'"'    return m'"'"' '"'"'d = build(mutate=floor_mutation(DECOY))'"'"' '"'"'print("   the floor comment replaced by a decoy naming 3.11 -> %s"'"'"' '"'"'      % failures(d, ["test_survey.py", "test_llmstxt.py"]))'"'"' '"'"'shutil.rmtree(os.path.dirname(d))'"'"' '"'"'d = build(mutate=floor_mutation("# nothing about a floor here"))'"'"' '"'"'print("   the floor comment removed outright (control)     -> %s"'"'"' '"'"'      % failures(d, ["test_survey.py", "test_llmstxt.py"]))'"'"' '"'"'shutil.rmtree(os.path.dirname(d))'"'"' '"'"''"'"' '"'"'print()'"'"' '"'"'print("== the exceptions the three 39e6247 rows go red on, which is why they are three rows ==")'"'"' '"'"'for rev in ("39e6247", "cfafe8e"):'"'"' '"'"'    d = build("survey.py", rev)'"'"' '"'"'    r = subprocess.run(["uvx", "pytest", "tests/test_survey.py", "-q", "--no-header",'"'"' '"'"'                        "-p", "no:cacheprovider", "-k",'"'"' '"'"'                        "not_an_object or not_a_table or not_a_string"],'"'"' '"'"'                       cwd=d, capture_output=True, text=True, env=BASE, timeout=600)'"'"' '"'"'    out = r.stdout'"'"' '"'"'    print("   %s: AttributeError off a list %s | TypeError unpacking one %s | date not serializable %s"'"'"' '"'"'          % (rev,'"'"' '"'"'             "'"'"'"'"'"'"'"'"'list'"'"'"'"'"'"'"'"' object has no attribute '"'"'"'"'"'"'"'"'get'"'"'"'"'"'"'"'"'" in out,'"'"' '"'"'             "'"'"'"'"'"'"'"'"'list'"'"'"'"'"'"'"'"' object is not a mapping" in out,'"'"' '"'"'             "Object of type date is not JSON serializable" in out))'"'"' '"'"'    print("        the `bar` control beside the dated entry goes red instead: %s"'