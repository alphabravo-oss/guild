oding="utf-8").read().split('"'"'"'"'"'"'"'"'"""'"'"'"'"'"'"'"'"')[1]'"'"' '"'"'    rows = {}'"'"' '"'"'    for line in doc.splitlines():'"'"' '"'"'        m = re.match(r"^(test_\S+)\s+\S+\s+(.+?)\s*$", line)'"'"' '"'"'        if m:'"'"' '"'"'            rows[m.group(1)] = m.group(2)'"'"' '"'"'    return doc, rows'"'"' '"'"''"'"' '"'"'for module, script in (("test_survey.py", "survey.py"), ("test_llmstxt.py", "llmstxt.py")):'"'"' '"'"'    doc, rows = table(module)'"'"' '"'"'    revs = []'"'"' '"'"'    for label in rows.values():'"'"' '"'"'        m = re.match(r"^([0-9a-f]{7})", label)'"'"' '"'"'        if m and m.group(1) not in revs:'"'"' '"'"'            revs.append(m.group(1))'"'"' '"'"'    revs.sort()'"'"' '"'"'    print("== %s: %d rows, %d revisions named ==" % (module, len(rows), len(revs)))'"'"' '"'"'    red = {}'"'"' '"'"'    for rev in revs:'"'"' '"'"'        d = build(script, rev)'"'"' '"'"'        red[rev] = [n.split("::")[1] for n in failures(d, [module])]'"'"' '"'"'        shutil.rmtree(os.path.dirname(d))'"'"' '"'"'    for name in sorted(rows):'"'"' '"'"'        label = rows[name]'"'"' '"'"'        m = re.match(r"^([0-9a-f]{7})", label)'"'"' '"'"'        if not m:'"'"' '"'"'            verdict = "no revision named (%s)" % label'"'"' '"'"'        else:'"'"' '"'"'            rev = m.group(1)'"'"' '"'"'            verdict = "RED at %s" % rev if name in red[rev] else "GREEN at %s -- ROW WRONG" % rev'"'"' '"'"'        print("   %-60s %s" % (name, verdict))'"'"' '"'"'    guards = sorted(n for n, l in rows.items() if l == "guard")'"'"' '"'"'    print("   guard rows, green at every revision measured %s:" % revs)'"'"' '"'"'    for name in guards:'"'"' '"'"'        bad = [r for r in revs if name in red[r]]'"'"' '"'"'        print("       %-56s %s" % (name, "green at all" if not bad else "RED at %s -- ROW WRONG" % bad))'"'"' '"'"'    print("   rows naming a commit later than cfafe8e, and their state at cfafe8e:")'"'"' '"'"'    if "cfafe8e" in red:'"'"' '"'"'     