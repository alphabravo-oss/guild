(sc) if '"'"'"--site-dir"'"'"' in l)' 'print("    scaffold.py, the two flags that write it and name it:")' 'for j in (i - 1, i, i + 1):' '    print("      %4d  %s" % (j + 1, sc[j]))' 'repo = m.build_fixture_repo(os.path.join(W, "site"))' 'before = sorted(p.name for p in repo.iterdir())' 'r = run(["python3", SCAFFOLD, "init", "--site", "--docs", "docs",' '         "--title", "fixapp", "--subject", "items"], repo)' 'after = sorted(p.name for p in repo.iterdir())' 'print("    ran inside a temp copy of the fixture -- never in plugins/webster:")' 'print("      python3 scaffold.py init --site --docs docs --title fixapp --subject items")' 'print("      exit %d" % r.returncode)' 'print("      stdout: %s" % " ".join(r.stdout.split()))' 'print("      stderr: %r" % r.stderr)' 'print("    top level before: %s" % ", ".join(before))' 'print("    top level after:  %s" % ", ".join(after))' 'print("    new at top level: %s" % ", ".join(sorted(set(after) - set(before))))' 'st = git(["status", "--porcelain", "-z", "--untracked-files=all"], repo).stdout' 'un = sorted(f[3:] for f in st.split("\0") if f.startswith("?? "))' 'site_un = [u for u in un if u.startswith("website/")]' 'print("    website/ on disk:                %s" % (repo / "website").is_dir())' 'print("    git ls-files -- website:         %r  (git tracks none of it)"' '      % git(["ls-files", "--", "website"], repo).stdout)' 'print("    untracked files under website/:  %d" % len(site_un))' 'for u in site_un:' '    print("        %s" % u)' 'print()' '' 'print("[4] the two the sentence already counted, measured the same way")' 'r2 = m.build_fixture_repo(os.path.join(W, "two"))' 'print("    .git -- left by a build that ran in place:")' 'print("        .git is a directory:          %s" % (r2 / ".git").is_dir())' 'print("        git ls-files -- .git:         %r" % git(["ls-files", "--", ".git"], r2).stdout)' 'rec = run(["python3", DRIFT, "record", "docs"], r2)' 'print("    docs/.webster.json -- written by drift.py record against the tree:")' 'print("        python3 drift.py record docs -> exit %d" % rec.returncode)' 'print("        docs/.webster.json is a file: %s" % (r2 / "docs" / ".webster.json").is_file())' 'print("        git ls-files -- that path:    %r"' '      % git(["ls-files", "--", "docs/.webster.json"], r2).stdout)' 'print()' '' 'print("[5] the count the sentence now states")' 'print("    exclusions that can appear in the tree with git tracking none of them:")' 'print("      .git                yes -- a build that ran in place; git never tracks its own dir")' 'print("      docs/.webster.json  yes -- drift.py record, run against the tree instead of a copy")' 'print("      website/            yes -- scaffold.py init --site, --site-dir defaulting to it")' 'print("    three of three, not two. A check read out of git would miss all three")' 'print("    alike, which is why this test walks the filesystem.")' > "$T/e.py"; python3 "$T/e.py"; rm -rf "$T"
# evidence-for: US-010, FR-042, AC-040, GI-005, OT-038
#
# GRIND cycle 17, D-167 (PROVE cycle 16 F-07). test_committed_fixture_excludes_git_website_manifest
# explained its filesystem walk by saying "two of the three can appear without being tracked" and
# then named .git and docs/.webster.json. All three can, and the one left out is the one a webster
# script writes for you.
#
# Block [3] measures it. scaffold.py's --site-dir defaults to the literal "website", so
# scaffold.py init --site writes GI-005's third exclusion into the tree under exactly the name
# GI-005 forbids. Run inside a temp copy built by conftest's own builder -- never inside
# plugins/webster -- it created five files there and git tracks none of them.
#
# Block [4] measures the other two the same way, so the count in [5] rests on one method rather
# than on two named cases and an assumption about the third.
#
# The consequence for the test is unchanged: a check read out of git would miss all three alike,
# which is why the walk is on the filesystem. What changes is that the sentence now says three
# where the tree has three.

