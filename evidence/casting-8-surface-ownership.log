rface_globs" commands/start.md)" && printf "%s\tmanifest.get(\"surface_globs\") in the dimension that reads it\n" "$(grep -c -F -- 'manifest.get("surface_globs")' mcp-server/src/foundry_mcp/tools/foundry_validate.py)" && printf "%s\n" "--- the pins that refuse each clause ---" && cd mcp-server && uv run --quiet --with pytest pytest -q -p no:cacheprovider tests/test_lead_prose.py -k "shipped or unowned or ownership or adjacency or beneath or surface or computable or brownfield" 2>&1 | grep -o "^[0-9]* passed"
