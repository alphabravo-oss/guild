# evidence-cmd: printf '%s\n' 'import ast' 'import pathlib' 'PKG = pathlib.Path("plugins/foundry/mcp-server/src/foundry_mcp")' 'def modname(p):' '    parts = list(p.relative_to(PKG.parent).with_suffix("").parts)' '    if parts[-1] == "__init__":' '        parts.pop()' '    return ".".join(parts)' 'def writes_stdout(n):' '    if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == "print":' '        t = next((ast.unparse(k.value) for k in n.keywords if k.arg == "file"), None)' '        return t not in ("sys.stderr", "sys.__stderr__")' '    if isinstance(n, ast.Attribute) and n.attr in ("stdout", "__stdout__"):' '        return isinstance(n.value, ast.Name) and n.value.id == "sys"' '    return False' 'mods = {modname(p): p for p in sorted(PKG.rglob("*.py"))}' 'trees = {n: ast.parse(p.read_text(encoding="utf-8")) for n, p in mods.items()}' 'def imports_of(n):' '    out = set()' '    for x in ast.walk(trees[n]):' '        if isinstance(x, ast.Import):' '            out |= {a.name for a in x.names}' '        elif isinstance(x, ast.ImportFrom) and x.module:' '            out.add(x.module)' '            out |= {"%s.%s" % (x.module, a.name) for a in x.names}' '    return {m for m in out if m in mods}' 'reach, stack = set(), ["foundry_mcp.server"]' 'while stack:' '    m = stack.pop()' '    if m in reach or m not in mods:' '        continue' '    reach.add(m)' '    stack.extend(imports_of(m))' 'def loud(name):' '    tree, calls, out = trees[name], {}, set()' '    for fn in ast.walk(tree):' '        if isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef)):' '            body = list(ast.walk(fn))' '            calls[fn.name] = {(c.func.id if isinstance(c.func, ast.Name) else c.func.attr)' '                              for c in body if isinstance(c, ast.Call)' '                              and isinstance(c.func, (ast.Name, ast.Attribute))}' '            if any(writes_stdout(n) for n in body):' '                out.add(fn.name)' '    ch = True' '    while