andoff" in mods, "foundry_mcp.tools.foundry_handoff" in reach))' 'print("   anchor foundry_mcp.server                : scanned=%s reachable=%s"' '      % ("foundry_mcp.server" in mods, "foundry_mcp.server" in reach))' 'print("   recogniser is non-blind (found a print)  : %s"' '      % any(allloud[n] for n in mods))' 'print("")' 'print("   handlers reachable over the protocol that write to stdout:")' 'print("       %s" % (offenders if offenders else []))' 'print("")' 'print("   the CLI validator'\''s prints are cleared by DERIVATION, not by path:")' 'cli = "foundry_mcp.scripts.validate_intent_coverage"' 'print("       %s reachable=%s loud=%s" % (cli, cli in reach, sorted(allloud.get(cli, []))))' 'print("       entered only through main(), imported inside a redirect_stdout block")' | uv run --quiet --project plugins/foundry/mcp-server python - && cd plugins/foundry/mcp-server && uv run --quiet --with pytest pytest -q --no-header -p no:cacheprovider "tests/test_evidence.py::test_no_handler_reachable_over_the_protocol_writes_to_stdout" "tests/test_evidence.py::test_a_new_handler_that_prints_is_reported_by_name" "tests/test_evidence.py::test_a_redirected_cli_entry_point_is_not_an_offender" "tests/test_evidence.py::test_the_dispatched_evidence_path_emits_nothing_on_stdout" "tests/test_evidence.py::test_the_adjacent_dispatch_paths_also_emit_nothing_on_stdout"
