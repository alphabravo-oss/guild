# Cycle-17: the suite at this commit, and which test pins which requirement.
# Run from the repository root. The GI-007 scope guard is deselected by name: it
# reads baseline..HEAD and reports the evidence logs this commit carries, which
# is what it is for.
import ast, os, re, subprocess

SCOPE = ("tests/test_harness.py::"
         "test_only_the_writable_file_set_is_tracked_and_changed")
env = dict(os.environ, COLUMNS="200")
env.pop("WEBSTER_SURVEY", None)
cwd = "plugins/webster"

collected = subprocess.run(["uvx", "pytest", "-q", "--collect-only",
                            "-p", "no:cacheprovider"],
                           cwd=cwd, capture_output=True, text=True, env=env)
run = subprocess.run(["uvx", "pytest", "-q", "--tb=short", "-p", "no:cacheprovider",
                      "--deselect", SCOPE],
                     cwd=cwd, capture_output=True, text=True, env=env)
print("== the whole suite at this commit ==")
print(f"   collected: {collected.stdout.strip().splitlines()[-1]}")
print(f"   run:       {run.stdout.strip().splitlines()[-1]}")
print(f"   deselected: {SCOPE}")

tests_src = open("plugins/webster/tests/test_doctype.py", encoding="utf-8").read()
ids = sorted(set(re.findall(r"\b(?:US|FR|NFR|AC)-\d+\b", tests_src)))
print(f"\n   requirement IDs tests/test_doctype.py names: {ids}")
print("\n== the section banners: the AC each group of tests pins ==")
for line in tests_src.splitlines():
    if re.match(r"^# (FR|AC|US)-", line):
        print(f"   {line}")
doc = ast.get_docstring(ast.parse(tests_src))
print("\n== tests/test_doctype.py's own index: the requirement, then what pins it ==")
for line in doc.splitlines():
    if re.match(r"^- (FR|AC|US|NFR)-", line) or re.match(r"^\s+test_\w+", line) \
            or re.match(r"^  \(", line):
        print(f"   {line}")

