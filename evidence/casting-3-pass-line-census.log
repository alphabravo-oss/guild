== the measuring plugin ==
# conftest.run_script reaches subprocess.run by attribute, so replacing the attribute sees
# every doctype.py invocation the module makes, with the tree it was pointed at still on disk.
import collections, pathlib, subprocess
STUB, PASS, ROWS, orig = "webster: not written yet", "matches its declared type", [], subprocess.run
def measured(cmd, *a, **k):
    docs = None
    if isinstance(cmd, (list, tuple)):
        parts = [str(x) for x in cmd]
        if any(x.endswith("doctype.py") for x in parts):
            docs = next((pathlib.Path(x) for x in parts[2:] if pathlib.Path(x).is_dir()), None)
    if docs is None:
        return orig(cmd, *a, **k)
    md = sorted(docs.rglob("*.md"))
    stubs = sum(1 for m in md if STUB in m.read_text(encoding="utf-8", errors="replace"))
    r = orig(cmd, *a, **k)
    ROWS.append((stubs, len(md) - stubs, PASS in (r.stdout or "")))
    return r
subprocess.run = measured
def pytest_sessionfinish(session, exitstatus):
    tally = collections.Counter((s > 0, p) for s, _w, p in ROWS)
    print("\n== doctype.py runs on a docs tree, by stubs in that tree ==")
    print("total runs: %d" % len(ROWS))
    for h in (False, True):
        for p in (True, False):
            print("  stubs %-3s pass line %-8s %d" % (">0" if h else "==0",
                  "printed" if p else "absent", tally[(h, p)]))
    print("\n== the runs that printed it, as (stubs, written pages) ==")
    print("  " + ", ".join("(%d, %d)" % (s, w) for s, w, p in ROWS if p))

