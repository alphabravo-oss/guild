# evidence-cmd: sh -c 'D=$(mktemp -d); cp -R plugins/foundry/mcp-server/tests/fixtures/migrate_archive/pre_change "$D/run"; echo "=== RUN 1 (migrating a pre-change archive) ==="; python3 plugins/foundry/scripts/migrate-archive.py "$D/run" | sed "s#$D#<TMP>#g"; echo "=== RUN 2 (idempotency: NFR-003 / OT-012) ==="; python3 plugins/foundry/scripts/migrate-archive.py "$D/run" | sed "s#$D#<TMP>#g"; echo "=== derived stream-rollup.json ==="; cat "$D/run/stream-rollup.json"; echo "=== state.json cycle + marker ==="; python3 -c "import json,sys; s=json.load(open(sys.argv[1])); print(\"cycle:\", s[\"cycle\"]); print(\"archive_schema_version:\", s[\"archive_schema_version\"])" "$D/run/state.json"; rm -rf "$D"'
# evidence-for: FR-021, NFR-003, AC-026
# evidence-timeout: 120
#
# All six migration steps against the committed synthetic pre-change
# archive, then the same command again. Run 2 reports every step "no-op"
# and "migrated": false — NFR-003 idempotency / OT-012's second half.
# The temp dir is redacted to <TMP> so the log is byte-reproducible.

