# evidence-cmd: sh -c 'cd "$(git rev-parse --show-toplevel)"; d=$(mktemp -d); printf %s "" | base64 -d > "$d/census.py"; echo "--- the program these blocks are the output of ---"; cat "$d/census.py"; echo; echo "--- measured ---"; python3 "$d/census.py"; rm -rf "$d"'
# evidence-for: FR-029, GI-004, AC-039, FR-039, FR-038, AC-042, US-010
# evidence-timeout: 120
#
# D-159. tests/test_readme.py quoted conftest.py as saying "Every script binds its
# root, its docs directory and its allowlists at module level". Block [1] greps that
# string at every conftest.py revision that has ever existed: nought hits, at any of
# the eight, case folded. The nearest any of them held ends "at module import, from
# argv or os.environ", and the sentence conftest.py carries now opens "Five of the
# plugin seven scripts". The quotation is removed rather than repaired: the comment
# that replaces it quotes no sibling file at all, so there is nothing left in it for
# another casting to move under.
#
# Blocks [2] to [5] are the census the defect asks for -- every remaining quotation in
# test_readme.py and in README.md that puts words in another file mouth, or in an
# earlier revision of its own, grepped against that file at that revision. A row is
# "yes" only on a byte-for-byte match once line wrapping and a leading comment marker
# are removed. Three rows land only case folded, and all three are the same thing:
# a sentence-initial capital lowered because the quotation sits mid-sentence. Each
# names the source spelling on the line below it. No row is missing.

--- the program these blocks are the output of ---
"""D-159. Every quotation in test_readme.py and README.md that puts words in
another file's mouth, grepped against that file.

Run from the repository root. A row passes only when the quoted string is
present, byte for byte, in the normalised text of the file it is attributed
to -- normalised meaning line wrapping and a leading comment marker removed,
nothing else. A row that needs a case-insensitive match to land is reported
as such and the reason is given.
"""
import re
import subprocess
import sys

W = "plugins/webster"


def norm(text):
    """Flatten wrapping and comment markers; leave every other byte alone."""
    lines = [re.sub(r"^\s*#\s?", "", line).strip() for line in text.splitlines()]
    return re.sub(r"\s+", " ", " ".join(lines))


def body(path, ref):
    if ref == "WORKTREE":
        return open(path, encoding="utf-8").read()
    return subprocess.run(["git", "show", "%s:%s" % (ref, path)],
                          capture_output=True, text=True, check=True).stdout


CACHE = {}


def hits(quotation, path, ref, fold=False):
    key = (path, ref)
    if key not in CACHE:
        CACHE[key] = norm(body(path, ref))
    text = CACHE[key]
    if fold:
        return text.lower().count(quotation.lower())
    return text.count(quotation)


def report(rows, title):
    print(title)
    print("    %-4s %-46s %-10s %-8s %s" % ("hits", "attributed to", "at", "exact?", "quotation"))
    bad = 0
    for quotation, path, ref, note in rows:
        exact = hits(quotation, path, ref)
        folded = hits(quotation, path, ref, fold=True)
        if exact:
            verdict, count = "yes", exact
        elif folded:
            verdict, count = "case", folded
        else:
            verdict, count = "NO", 0
            bad += 1
        print("    %-4d %-46s %-10s %-8s %s" % (count, path, ref, verdict, quotation))
        if note:
            print("         %s" % note)
    print("    -> %d row(s) with no match at all" % bad)
    return bad


print("[1] D-159: the words test_readme.py put in conftest.py's mouth, at every")
print("    conftest.py revision that has ever existed")
QUOTE = "Every script binds its root, its docs directory and its allowlists at module level"
print("    quotation: %s" % QUOTE)
CONFTEST_REVS = ["2482f6f", "0c3d896", "168845f", "7b6ae3e",
                 "4714d45", "6e19064", "b623e9f", "2abe081"]
total = 0
for rev in CONFTEST_REVS:
    n = hits(QUOTE, "%s/tests/conftest.py" % W, rev, fold=True)
    total += n
    print("      %-9s %d" % (rev, n))
print("    total, case-insensitive, across %d revisions: %d" % (len(CONFTEST_REVS), total))
print("    what conftest.py says at the commit under test:")
here = CACHE.setdefault(("%s/tests/conftest.py" % W, "WORKTREE"),
                        norm(body("%s/tests/conftest.py" % W, "WORKTREE")))
found = re.search(r"Five of the plugin's seven scripts[^;]*;", here)
print("      %s" % (found.group(0) if found else "<the sentence has moved>"))
print("    the nearest thing any revision held, at 4714d45:")
old = CACHE.setdefault(("%s/tests/conftest.py" % W, "4714d45"),
                       norm(body("%s/tests/conftest.py" % W, "4714d45")))
found = re.search(r"Every script binds[^:]*:", old)
print("      %s" % (found.group(0) if found else "<none>"))
print("    -> not repaired but removed: the replacement comment quotes no sibling file.")

print()
bad = report([
    ("Tests for the harness itself", "%s/tests/test_harness.py" % W, "WORKTREE",
     "the docstring opening test_readme.py names"),
    ("clean and unrelated_changes exit 0, drift exits 1", "%s/scripts/drift.py" % W, "WORKTREE", ""),
    ("has not earned exit 0", "%s/scripts/drift.py" % W, "WORKTREE", ""),
    ("exit 1 on a defect, 0 when only advisories remain, 2 when there was nothing to check",
     "%s/scripts/doctype.py" % W, "WORKTREE", ""),
    ("on a defect", "%s/scripts/doctype.py" % W, "WORKTREE", "sub-quote of the row above"),
    ("when only advisories remain", "%s/scripts/doctype.py" % W, "WORKTREE", "sub-quote of the row above"),
    ("init never exits 1", "%s/scripts/scaffold.py" % W, "WORKTREE", ""),
    ("status ok at", "%s/scripts/scaffold.py" % W, "WORKTREE", ""),
    ("exit 1 on a leak", "%s/scripts/rendered.py" % W, "WORKTREE", ""),
], "[2] test_readme.py quoting a sibling file at the commit under test")

print()
bad += report([
    ("Every other module in this directory tests a script", "%s/tests/test_readme.py" % W, "770ba74", ""),
    ("green before and after by design", "%s/tests/test_readme.py" % W, "e82eccc",
     "case: the source wrote it sentence-initial, 'Green before and after by design'"),
    ("by the time this row was first written", "%s/tests/test_readme.py" % W, "c6bf1b5", ""),
    ("would collect one item", "%s/tests/test_readme.py" % W, "770ba74", ""),
    ("there would be no other way in anyway", "%s/tests/test_readme.py" % W, "4bb19cc",
     "the clause D-158 retracts, quoted from the revision this change replaces"),
    ("every script binds", "%s/tests/test_readme.py" % W, "44b50a2", ""),
    ("69 passing", "%s/README.md" % W, "61fb1df", ""),
    ("Version 0.2.0.", "%s/README.md" % W, "cfafe8e", ""),
], "[3] test_readme.py quoting an earlier revision, at the revision it names")

print()
bad += report([
    ("What this is", "%s/skills/house-rules/SKILL.md" % W, "WORKTREE", ""),
    ("what this deliberately does not do", "%s/skills/house-rules/SKILL.md" % W, "WORKTREE",
     "case: the source writes the section title, 'What this deliberately does not do'"),
    ("no other way in", "%s/README.md" % W, "c6bf1b5", ""),
    ("each script binds", "%s/README.md" % W, "693570d", ""),
    ("a different interpreter from pytest's", "%s/README.md" % W, "693570d", ""),
    ("exit 1 on drift", "%s/README.md" % W, "cfafe8e",
     "case: the row wrote it sentence-initial, 'Exit 1 on drift, 2 on nothing to measure'"),
], "[4] README.md quoting another file, or an earlier revision of itself")

print()
print("[5] the unquoted attributions the same two files make, checked the same way")
bad += report([
    ("Five of the plugin's seven scripts bind their root, their docs directory or their allowlists at module import",
     "%s/tests/conftest.py" % W, "WORKTREE", "what test_readme.py now says conftest.py names"),
    ("Five of the seven scripts make an import the wrong way in", "%s/README.md" % W, "WORKTREE",
     "what test_readme.py now says the README names"),
    ("resolves through PATH to 3.14.6", "%s/tests/conftest.py" % W, "WORKTREE",
     "README.md:322 attributes this to conftest.py"),
    ("not the one running pytest", "%s/tests/conftest.py" % W, "WORKTREE",
     "README.md:322 attributes this to conftest.py"),
], "")

print()
print("[6] the one backticked claim test_readme.py makes about every script's source")
print("    'every other script here ends in sys.exit(main())', and survey.py does not")
for name in ["doctype.py", "drift.py", "llmstxt.py", "rendered.py", "scaffold.py", "slop.py", "survey.py"]:
    src = body("%s/scripts/%s" % (W, name), "WORKTREE")
    print("      %-13s sys.exit(main()) x%d" % (name, src.count("sys.exit(main())")))

print()
print("verdict: %d quotation(s) in either file with no match in the file named." % bad)
sys.exit(0)

