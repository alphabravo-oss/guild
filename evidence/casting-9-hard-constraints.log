requires-python     >=3.12
dependencies        ['mcp>=1.0.0,<2.0.0', 'jsonschema>=4.20.0']
build-backend       hatchling.build
script entry        foundry_mcp.server:main
lock requires-dist  [('jsonschema', '>=4.20.0'), ('mcp', '>=1.0.0,<2.0.0')]
locked mcp          1.29.0
locked packages     32
mcpServers command  uv ['run', '--project', '${CLAUDE_PLUGIN_ROOT}/mcp-server', 'foundry-mcp', '--project-root', '${CLAUDE_PROJECT_DIR}']
FOUNDRY_MODEL env   ${user_config.model}
userConfig model    string
