# evidence-cmd: python3 -c 'import json,os,subprocess,tempfile; D=tempfile.mkdtemp(); os.makedirs(D+"/docs"); os.makedirs(D+"/src"); SRC="import os\nA = 1\nB = 2\n"; PAGE="# Page\n\nThe value it starts from. <!-- src/app.py:2 -->\n"; open(D+"/src/app.py","w").write(SRC); open(D+"/docs/page.md","w").write(PAGE); W={k:os.environ[k] for k in ("PATH","HOME") if k in os.environ}; E=dict(W,GIT_AUTHOR_NAME="t",GIT_AUTHOR_EMAIL="t@t",GIT_COMMITTER_NAME="t",GIT_COMMITTER_EMAIL="t@t",GIT_AUTHOR_DATE="2026-01-01T00:00:00+0000",GIT_COMMITTER_DATE="2026-01-01T00:00:00+0000",GIT_CONFIG_GLOBAL=os.devnull,GIT_CONFIG_NOSYSTEM="1"); g=lambda *a: subprocess.run(["git",*a],cwd=D,check=True,capture_output=True,text=True,env=E); S=os.path.abspath("plugins/webster/scripts/drift.py"); r=lambda *a,**kw: subprocess.run(["python3",S,*a],cwd=D,capture_output=True,text=True,env=dict(W,**kw)); j=lambda p: json.loads(p.stdout) if p.stdout.startswith("{") else {}; q=json.dumps; g("-c","init.defaultBranch=main","init","-q","."); p=r("record","docs"); print("1-record-before-any-commit exit="+str(p.returncode)+" gitHead="+q(j(p).get("gitHead"))+" note-present="+q(bool(j(p).get("note")))); g("add","-A"); g("commit","-qm","init"); p=r("check","docs"); print("2-check-manifest-with-null-head exit="+str(p.returncode)+" status="+q(j(p).get("status"))+" recorded="+q(j(p).get("gitHead",{}).get("recorded"))+" current-resolved="+q(bool(j(p).get("gitHead",{}).get("current")))+" note-present="+q(bool(j(p).get("note")))); p=r("record","docs"); print("3-record-with-a-commit exit="+str(p.returncode)+" gitHead-null="+q(j(p).get("gitHead") is None)+" note="+q(j(p).get("note"))); p=r("check","docs"); print("4-check-after-a-real-record exit="+str(p.returncode)+" status="+q(j(p).get("status"))); open(D+"/src/caf\u00e9.py","w").write("x = 1\n"); p=r("check","docs",LC_ALL="C",LANG="C",PYTHONUTF8="0",PYTHONCOERCECLOCALE="0"); print("5-check-non-ascii-path-under-C-locale exit="+str(p.returncode)+" status="+q(j(p).get("status"))+" code_files_changed="+q(j(p).get("code_files_changed"))+" traceback-on-stderr="+q("Traceback" in p.stderr))'
