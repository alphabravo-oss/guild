# evidence-timeout: 120

1-record-before-any-commit exit=0 gitHead=null note-present=true
2-check-manifest-with-null-head exit=2 status="no_git" recorded=null current-resolved=true note-present=true
3-record-with-a-commit exit=0 gitHead-null=false note=""
4-check-after-a-real-record exit=0 status="clean"
5-check-non-ascii-path-under-C-locale exit=0 status="unrelated_changes" code_files_changed=1 traceback-on-stderr=false
