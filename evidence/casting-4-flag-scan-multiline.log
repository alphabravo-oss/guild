# evidence-cmd: python3 -c 'import json,os,shutil,subprocess,tempfile; d=tempfile.mkdtemp(); os.makedirs(d+"/src"); open(d+"/pyproject.toml","w").write("[project]\nname = \"demo\"\n"); open(d+"/src/api.py","w").write("import argparse\n\n\ndef build():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\n        \"--verbose\",\n        action=\"store_true\",\n        help=\"pass -x for the old behaviour\",\n    )\n    return parser\n"); open(d+"/src/cli.js","w").write("program\n  .option(\n    \"--keep-going\",\n    \"-x is the short form of --purge\",\n  );\n"); r=subprocess.run(["python3","plugins/webster/scripts/survey.py",d],capture_output=True,text=True); n=[c["name"] for c in json.loads(r.stdout)["user_surface"]["commands"]]; print("survey.py exit:", r.returncode); print("user_surface.commands:", json.dumps(json.loads(r.stdout)["user_surface"]["commands"], indent=2)); print("--verbose declared:", "--verbose" in n); print("--keep-going declared:", "--keep-going" in n); print("-x published:", "-x" in n); print("--purge published:", "--purge" in n); shutil.rmtree(d)'
# evidence-for: FR-012, AC-013
#
# D-062. Black puts every argument on its own line once the call passes 88
# columns, which is the ordinary shape of an add_argument carrying an action
# and a help sentence. A line-based scan saw `parser.add_argument(` and no
# literal at all, so the flag was declared nowhere and could not be suppressed
# through WEBSTER_SURVEY (AC-013): the transport was inert for exactly the
# projects that run a formatter.
#
# The join is the six-line, paren-balance one the FR-019 decorator pass already
# uses. The two anchors below are the assertion: src/api.py:6 is the
# `parser.add_argument(` line and src/cli.js:2 is the `.option(` line, not the
# lines the spellings landed on. Joining does not relax what is read from the
# call -- the -x and --purge in the two descriptions stay prose.

survey.py exit: 0
user_surface.commands: [
  {
    "name": "--verbose",
    "anchor": "src/api.py:6"
  },
  {
    "name": "--keep-going",
    "anchor": "src/cli.js:2"
  }
]
--verbose declared: True
--keep-going declared: True
-x published: False
--purge published: False
