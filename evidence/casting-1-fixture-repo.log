# evidence-for: US-010, FR-030, NFR-005, AC-040, OT-038
# evidence-volatile: \d+\.\d+s
#
# FR-030 and OT-038, and the sweep's check on the comment above FIXTURE_COMMITS. That comment
# makes three claims.
#
# 1. "Times are the source repo's own clock times restated at +00:00." Measured this cycle
#    against the source fixture named in the casting's fixture_source field, with
#    `git log --reverse --format='%s %aI'`: its three commits read
#        init 2026-08-27T16:49:56-06:00 / docs ...16:50:40-06:00 / touch main ...16:51:11-06:00
#    and the constant below restates those same wall-clock readings at +00:00. That command is
#    not re-executed here because it reads a path outside the repository, which a checkout of
#    this commit cannot be assumed to have.
# 2. "the bare form of the first date below commits at +1400 under TZ=Pacific/Kiritimati and at
#    -0700 under TZ=America/Los_Angeles, two distinct HEADs; with the offset written in, both
#    zones give one." Re-measured below under git 2.50.1: two hashes bare, one hash with the
#    offset.
# 3. The comment names test_fixture_head_survives_a_change_of_host_timezone as what proves the
#    cross-machine half, and test_two_fixture_repo_builds_produce_the_same_head as proving only
#    the same-host half. Both run below.
#
# NFR-005: fixture_repo is per-test rather than session-scoped, so a test that edits main.py,
# renames a file or rebases HEAD away cannot become another test's premise.

--- the three commits the fixture replays, and the offsets that make them portable ---
FIXTURE_AUTHOR_NAME = "t"
FIXTURE_AUTHOR_EMAIL = "t@t"
TOUCH_MAIN_SUBJECT = "touch main"
FIXTURE_COMMITS = (
    (
        "init",
        "2026-08-27T16:49:56+00:00",
        ("README.md", "pyproject.toml", "src/app/main.py", "src/cli/main.py"),
    ),
    ("docs", "2026-08-27T16:50:40+00:00", ("docs",)),
    (TOUCH_MAIN_SUBJECT, "2026-08-27T16:51:11+00:00", ("src/app/main.py",)),
)

