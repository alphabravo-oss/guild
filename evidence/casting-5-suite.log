# Cycle-17: the suite at this commit, and which of casting 5's tests pins which requirement.
# Run from the repository root. The GI-007 scope guard is deselected by name: it reads
# baseline..HEAD and reports the evidence logs this commit carries, which is what it is for.
import ast, os, re, subprocess

SCOPE = ("tests/test_harness.py::"
         "test_only_the_writable_file_set_is_tracked_and_changed")
env = dict(os.environ, COLUMNS="200")
env.pop("WEBSTER_SURVEY", None)
cwd = "plugins/webster"

collected = subprocess.run(["uvx", "pytest", "-q", "--collect-only", "-p", "no:cacheprovider"],
                           cwd=cwd, capture_output=True, text=True, env=env)
run = subprocess.run(["uvx", "pytest", "-q", "--tb=short", "-p", "no:cacheprovider",
                      "--deselect", SCOPE],
                     cwd=cwd, capture_output=True, text=True, env=env)
print("== the whole suite at this commit ==")
print(f"   collected: {collected.stdout.strip().splitlines()[-1]}")
print(f"   run:       {run.stdout.strip().splitlines()[-1]}")
print(f"   deselected: {SCOPE}")

print("\n== casting 5's two modules: every test, and the requirements its bullet names ==")
for name in ("test_slop.py", "test_scaffold.py"):
    path = f"plugins/webster/tests/{name}"
    src = open(path, encoding="utf-8").read()
    t = ast.parse(src)
    tests = [n.name for n in t.body if isinstance(n, ast.FunctionDef) and n.name.startswith("test_")]
    doc = ast.get_docstring(t, clean=False)
    ids = sorted(set(re.findall(r"\b(?:US|FR|NFR|AC)-\d+\b", src)))
    print(f"\n   {path}: {len(tests)} tests, requirement IDs named: {ids}")
    bullet = None
    for line in doc.splitlines():
        if line.startswith("- ``test_"):
            bullet = re.match(r"- ``(\w+)``(.*)", line)
            print(f"     {bullet.group(1):58s} {bullet.group(2).strip(' —-')}")
    print("     section banners in the body:")
    for line in src.splitlines():
        if re.match(r"^# (FR|AC|US|OT|CT)-", line):
            print(f"       {line}")

print("\n== the exit-code contract both modules assert, run once each here ==")
r = subprocess.run(["uvx", "pytest", "tests/test_slop.py", "tests/test_scaffold.py", "-q",
                    "--no-header", "-p", "no:cacheprovider"],
                   cwd=cwd, capture_output=True, text=True, env=env)
print(f"   {r.stdout.strip().splitlines()[-1]}")

