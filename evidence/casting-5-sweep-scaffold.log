# Cycle-17 sweep: every sentence in scripts/scaffold.py that no cycle since 9 had rewritten,
# measured. Run from the repository root. Two failed and are corrected here; the rest held.
import ast, importlib.util, json, os, re, shutil, subprocess, sys, tempfile

SC = "plugins/webster/scripts/scaffold.py"
src = open(SC, encoding="utf-8").read()
tree = ast.parse(src)


def load():
    sys.argv = ["scaffold.py", "check"]
    spec = importlib.util.spec_from_file_location("scmod", SC)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def sentence(needle, lines=1):
    body = src.splitlines()
    for i, line in enumerate(body, 1):
        if needle in line:
            return "\n".join(f"     {SC}:{i + k}  {l}" for k, l in enumerate(body[i - 1:i - 1 + lines]))
    return "     NOT FOUND: " + needle


def scaffold(*args, **kw):
    return subprocess.run(["python3", SC, *[str(a) for a in args]],
                          capture_output=True, text=True, **kw)


m = load()
fixed = [n for n, _, _ in m.FRONT] + [n for n, _, _ in m.BACK] + [n for n, _, _ in m.OPTIONAL]

print("== corrected: SECTION_TYPE holds five of the six fixed sections ==")
print(sentence("# the content type five of the six", 1))
print(f"     FRONT + BACK + OPTIONAL, the fixed sections: {fixed}  ({len(fixed)})")
print(f"     SECTION_TYPE keys:     {sorted(m.SECTION_TYPE)}  ({len(m.SECTION_TYPE)})")
print(f"     SECTION_AUDIENCE keys: {sorted(m.SECTION_AUDIENCE)}  ({len(m.SECTION_AUDIENCE)})")
print(f"     fixed sections absent from SECTION_TYPE:     {[n for n in fixed if n not in m.SECTION_TYPE]}")
print(f"     fixed sections absent from SECTION_AUDIENCE: {[n for n in fixed if n not in m.SECTION_AUDIENCE] or 'none'}")
print(f"     getting-started's own pages carry their types: {m.GETTING_STARTED}")
print("     and do_init never asks SECTION_TYPE for that section:")
for i, line in enumerate(src.splitlines(), 1):
