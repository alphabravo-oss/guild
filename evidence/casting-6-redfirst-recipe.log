ster" && uvx pytest tests/test_readme.py -q 2>&1 | grep -E "Status section claims|^FAILED|passed|failed" ) | sed -E "s|(/private)?$scratch|<SCRATCH>|g"; rm -rf "$scratch"; done; rm -rf "$t"'
