# evidence-cmd: cd "$(git rev-parse --show-toplevel)"; T=$(mktemp -d); printf '%s\n' 'import json, os, re, shutil, subprocess, sys, tempfile' 'from collections import Counter' '' 'ROOT = os.path.abspath(".")' 'DRIFT = "plugins/webster/scripts/drift.py"' 'TESTS = "plugins/webster/tests/test_drift.py"' 'BASE = {k: os.environ[k] for k in ("PATH", "HOME") if k in os.environ}' 'W = tempfile.mkdtemp()' 'def sh(a, cwd=None):' '    return subprocess.run(a, cwd=cwd, capture_output=True, text=True, timeout=600, env=BASE)' '' '# The plugin tree is COPIED per revision and pytest runs in the copy. Nothing here' '# writes into the work tree: an evidence run that swapped drift.py in place would' '# discard the edit it documents, and would race the castings editing beside it.' 'def replay(rev, k=None):' '    d = os.path.join(W, "rev-" + rev)' '    if not os.path.isdir(d):' '        shutil.copytree(os.path.join(ROOT, "plugins", "webster"), d,' '                        ignore=shutil.ignore_patterns(".venv", ".pytest_cache", ".hypothesis"))' '        open(os.path.join(d, "scripts", "drift.py"), "w", encoding="utf-8").write(' '            sh(["git", "show", "%s:%s" % (rev, DRIFT)]).stdout)' '    a = ["uvx", "pytest", "tests/test_drift.py", "-q", "--no-header", "-p", "no:randomly"]' '    if k:' '        a += ["-k", k]' '    return sh(a + ["--tb=long"], cwd=d)' '' 'def observed(out, field=None):' '    """What the revision actually did: the envelope it dumped, or the key it lacked.' '' '    `field` names the one envelope key the row'"'"'s column is about, so a row whose' '    column reads `suspect_pages {}` is answered with suspect_pages rather than with' '    the status that happens to sit beside it.' '    """' '    bits = []' '    st = re.search(r'"'"'"status": "(\w+)"'"'"', out)' '    ex = re.search(r"^E?\s+exit: (\d+)$", out, re.M)' '    if st and ex:' '        bits.append("status %s, exit %s" % (st.group(1), ex.group(1)))' '    if field:' '        m = re.search(r'"'"'"%s": (\{[^\n]*?