# evidence-cmd: T=$(mktemp -d); printf "%s\n" "import os, subprocess, sys" "" "def test_which_interpreters():" "    env = {k: os.environ[k] for k in (\"PATH\", \"HOME\") if k in os.environ}" "    probe = \"import os,sys;print(os.path.realpath(sys.executable));print(sys.version_info[:3])\"" "    child = subprocess.run([\"python3\", \"-c\", probe], capture_output=True, text=True, env=env, timeout=30)" "    cpath, cver = child.stdout.strip().splitlines()" "    print(\"collector realpath:\", os.path.realpath(sys.executable))" "    print(\"collector version :\", tuple(sys.version_info[:3]))" "    print(\"child realpath    :\", cpath)" "    print(\"child version     :\", cver)" "    print(\"one interpreter   :\", os.path.realpath(sys.executable) == cpath)" > "$T/test_interp.py"; echo "--- launch 1: cd plugins/webster && uvx pytest ---"; ( cd plugins/webster && uvx pytest "$T/test_interp.py" -s -q -p no:cacheprovider 2>&1 | grep -E "collector|child|one interpreter" ); echo; echo "--- launch 2: python3 -m pytest ---"; echo -n "PATH python3 with no venv in front: "; python3 -m pytest --version 2>&1 | tail -1; uv venv --offline -q --python "$(command -v python3)" "$T/venv"; uv pip install --offline -q --python "$T/venv/bin/python" pytest; ( cd plugins/webster && PATH="$T/venv/bin:$PATH" python3 -m pytest "$T/test_interp.py" -s -q -p no:cacheprovider 2>&1 | grep -E "collector|child|one interpreter" ); rm -rf "$T"; echo; echo "--- the two things that decide the child, read out of conftest.py ---"; grep -n "_BASE_ENV_KEYS = \|\"python3\", str(script)" plugins/webster/tests/conftest.py; echo; echo "--- the floor guard, through run_script for real (CT-007, FR-029) ---"; ( cd plugins/webster && uvx pytest tests/test_harness.py -q -p no:cacheprovider -k child_python3 2>&1 | tail -2 )
# evidence-for: US-010, CT-007, FR-029, FR-039, GI-004, AC-041, NFR-004, OT-039
# evidence-volatile: \d+\.\d+s
#
# GRIND cycle 15, D-154 (PROVE cycle 14 F-06). conftest.py's docstring said that under a plain
# `python3 -m pytest` the child run_script launches is "a different interpreter from the one
# collecting the tests". It is not. run_script passes PATH straight through from the environment
# pytest inherited and shells out to the literal string "python3", so the child is whatever PATH
# resolves; under `python3 -m pytest` the collector is the interpreter the shell just resolved
# through that same PATH. The two agree.
#
# Both launches are measured below, the collector's sys.executable realpath and version against
# the child's, by a throwaway test file in a temp directory (this casting may not add a module to
# the suite - the collected count is pinned at 148 this cycle):
#
#   uvx pytest        both 3.11.14, one realpath under uv's managed CPython
#   python3 -m pytest both 3.14.6, one realpath under Homebrew's python@3.14
#
# What differs between the launches is which interpreter both of them are, not whether they
# agree. The second launch is measured through a virtualenv built on PATH's own python3: this
# machine is PEP 668-managed, so that interpreter has no pytest for -m to find, which the first
# line of the second block prints rather than leaving implied.
#
# The last two blocks are the mechanism and the guarantee. run_script's interpreter is decided by
# exactly the literal "python3" and the PATH that _BASE_ENV_KEYS lets through; what the harness
# asserts is not a version number but the plugin's 3.11 floor (A-001), which
# test_run_script_child_python3_clears_the_plugin_floor measures through run_script for real.

